        GateInfo[i][gSpawn][0] = cache_get_field_content_float(i, "gX");
        GateInfo[i][gSpawn][1] = cache_get_field_content_float(i, "gY");
        GateInfo[i][gSpawn][2] = cache_get_field_content_float(i, "gZ");
        GateInfo[i][gSpawn][3] = cache_get_field_content_float(i, "gRX");
        GateInfo[i][gSpawn][4] = cache_get_field_content_float(i, "gRY");
