	}
	else
	{
	    SetVehicleParams(vehicleid, VEHICLE_BOOT, false);
	    SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s closes the boot of the %s.", GetRPName(playerid), GetVehicleName(vehicleid));
