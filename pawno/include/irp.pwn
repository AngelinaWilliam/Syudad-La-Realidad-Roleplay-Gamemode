forward BeginWorkout(playerid, type);
public BeginWorkout(playerid, type)
{
	PlayerTextDrawSetString(playerid, PlayerInfo[playerid][pText][60], "0");
	PlayerTextDrawSetString(playerid, PlayerInfo[playerid][pText][62], "0");

	switch (type)
	{
		case WORKOUT_DUMBELLS:
		{
			PlayerTextDrawSetString(playerid, PlayerInfo[playerid][pText][59], "Reps");
			ShowPlayerTextDraws(playerid, 58, 60);

			gWeights[playerid][0] = SetAttachedObject(playerid, 3072, 5, 0.0, 0.0, 0.0);
			gWeights[playerid][1] = SetAttachedObject(playerid, 3071, 6, 0.0, 0.0, 0.0);

			ShowPlayerProgressBar(playerid, PlayerInfo[playerid][pBars][0]);
			SetPlayerProgressBarValue(playerid, PlayerInfo[playerid][pBars][0], 0.0);
		}
		case WORKOUT_TREADMILL:
		{
			PlayerTextDrawSetString(playerid, PlayerInfo[playerid][pText][59], "Level");
			PlayerTextDrawFormatString(playerid, PlayerInfo[playerid][pText][60], "%i", PlayerInfo[playerid][pSpeedLevel]);

			ShowPlayerProgressBar(playerid, PlayerInfo[playerid][pBars][0]);
			SetPlayerProgressBarValue(playerid, PlayerInfo[playerid][pBars][0], 50.0);

			PlayerPlaySound(playerid, 17801, 0.0, 0.0, 0.0);
			ShowPlayerTextDraws(playerid, 58, 62);
		}
	}
	PlayerInfo[playerid][pWorkout] = type;
	PlayerInfo[playerid][pDistanceRan] = 0;
	PlayerInfo[playerid][pReps] = 0;

	return TogglePlayerControllable(playerid, 0);
}

forward DecreasePower(playerid);
public DecreasePower(playerid)
{
	new
		Float:value = GetPlayerProgressBarValue(playerid, PlayerInfo[playerid][pBars][0]);

	switch (PlayerInfo[playerid][pWorkout])
	{
		case WORKOUT_DUMBELLS:
		{
			if (value > 0.0)
			{
				SetPlayerProgressBarValue(playerid, PlayerInfo[playerid][pBars][0], value - 3.0);
			}
		}
		case WORKOUT_TREADMILL:
		{
			if (value > 0.0)
			{
				SetPlayerProgressBarValue(playerid, PlayerInfo[playerid][pBars][0], value - (PlayerInfo[playerid][pSpeedLevel] + 8));
			}
			else
			{
				StopWorkout(playerid);
				ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_falloff", 4.1, 0, 0, 0, 0, 0, 1);
			}
		}
	}
}

