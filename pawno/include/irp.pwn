	strcat(string, "\nWeapons\tGives you a full weapon set.\t{33CCFF}40 cookies{FFFFFF}");
	strcat(string, "\nNumber\tChoose a phone number of your choice.\t{33CCFF}50 cookies{FFFFFF}");
	strcat(string, "\nJob\tChoose a job to 1x level up.\t{33CCFF}60 cookies{FFFFFF}");
	strcat(string, "\nDouble XP\tAwards you with 8 hours of double XP.\t{33CCFF}70 cookies{FFFFFF}");
	strcat(string, "\nVehicle\tFree vehicle ticket under $200k value.\t{33CCFF}120 cookies{FFFFFF}");
	strcat(string, "\nHouse\tFree house ticket under $250k value.\t{33CCFF}160 cookies{FFFFFF}");
	strcat(string, "\nVIP\t1 month Limited VIP subscription\t{33CCFF}200 cookies{FFFFFF}");
	strcat(string, "\nBusiness\tFree business ticket of any type.\t{33CCFF}400 cookies{FFFFFF}");
	format(title, sizeof(title), "Cookie rewards (You have %i cookies.)", PlayerInfo[playerid][pCookies]);
	Dialog_Show(playerid, DIALOG_USECOOKIES, DIALOG_STYLE_TABLIST_HEADERS, title, string, "Redeem", "Cancel");
