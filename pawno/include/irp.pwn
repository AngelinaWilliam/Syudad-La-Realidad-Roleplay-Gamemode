	if(!PlayerInfo[playerid][pAdminDuty] && PlayerInfo[playerid][pAdmin] < GENERAL_MANAGER)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "This command requires you to be on admin duty. /aduty to go on duty.");
	}
	if(sscanf(params, "f", radius))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /freezerange [radius]");
