	new string[1536] = "Perk\tDescription\tCost", title[64];
    strcat(string, "\n50 Cookies\tRendeem your diamond for 50 cookies.\t{33CCFF}1 Diamond{FFFFFF}");
	strcat(string, "\nJail Time\tReduce your IC jailtime by 50 percent.\t{33CCFF}15 cookies{FFFFFF}");
	strcat(string, "\nRespect\tGives you 4 respect points.\t{33CCFF}20 cookies{FFFFFF}");
