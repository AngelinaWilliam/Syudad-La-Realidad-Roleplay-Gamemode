stock CreatePlayerTextDraws( playerid )
{
	CharTextdraw[playerid][0] = CreatePlayerTextDraw(playerid, 89.900001, 160.599975, "_");
	PlayerTextDrawLetterSize(playerid, CharTextdraw[playerid][0], 0.500000, 6.000000);
	PlayerTextDrawTextSize(playerid, CharTextdraw[playerid][0], 140.000000, 156.000000);
	PlayerTextDrawAlignment(playerid, CharTextdraw[playerid][0], 2);
	PlayerTextDrawColor(playerid, CharTextdraw[playerid][0], -1);
	PlayerTextDrawUseBox(playerid, CharTextdraw[playerid][0], 1);
	PlayerTextDrawBoxColor(playerid, CharTextdraw[playerid][0], -106);
	PlayerTextDrawSetShadow(playerid, CharTextdraw[playerid][0], 1);
	PlayerTextDrawBackgroundColor(playerid, CharTextdraw[playerid][0], 255);
	PlayerTextDrawFont(playerid, CharTextdraw[playerid][0], 0);
	PlayerTextDrawSetProportional(playerid, CharTextdraw[playerid][0], 1);

	CharTextdraw[playerid][1] = CreatePlayerTextDraw(playerid, 40.000000, 163.000000, "mdl-1000:site_logo");
	PlayerTextDrawLetterSize(playerid, CharTextdraw[playerid][1], 0.500000, 1.000000);
	PlayerTextDrawTextSize(playerid, CharTextdraw[playerid][1], 110.000000, 50.000000);
	PlayerTextDrawAlignment(playerid, CharTextdraw[playerid][1], 0);
	PlayerTextDrawColor(playerid, CharTextdraw[playerid][1], -1);
	PlayerTextDrawUseBox(playerid, CharTextdraw[playerid][1], 1);
	PlayerTextDrawBoxColor(playerid, CharTextdraw[playerid][1], 255);
	PlayerTextDrawSetShadow(playerid, CharTextdraw[playerid][1], 1);
	PlayerTextDrawBackgroundColor(playerid, CharTextdraw[playerid][1], 255);
	PlayerTextDrawFont(playerid, CharTextdraw[playerid][1], 4);
	PlayerTextDrawSetProportional(playerid, CharTextdraw[playerid][1], 1);

	CharTextdraw[playerid][2] = CreatePlayerTextDraw(playerid, 90.000000, 144.000000, "Account Setup");
