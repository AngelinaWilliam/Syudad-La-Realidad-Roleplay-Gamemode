        GateInfo[i][gMove][3] = cache_get_field_content_float(i, "gMoveRX");
        GateInfo[i][gMove][4] = cache_get_field_content_float(i, "gMoveRY");
        GateInfo[i][gMove][5] = cache_get_field_content_float(i, "gMoveRZ");
        GateInfo[i][gInterior] = cache_get_field_content_int(i, "gInterior");
