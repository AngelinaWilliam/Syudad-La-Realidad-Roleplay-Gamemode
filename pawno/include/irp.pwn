			        	SendClientMessage(p, COLOR_GREY1, string);
			    	}
			    }
			}
	    }
	    if(IsPlayerInRangeOfPoint(playerid, 20.0, EntranceInfo[i][eIntX], EntranceInfo[i][eIntY], EntranceInfo[i][eIntZ]))
	    {
	    	if(GetPlayerVirtualWorld(playerid) == EntranceInfo[i][eWorld])
	    	{
