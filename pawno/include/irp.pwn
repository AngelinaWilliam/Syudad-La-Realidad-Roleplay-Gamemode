}

stock ProcessTurfPerk(gangid)
{
	foreach(new i: Turf)
	{
	    if(TurfInfo[i][tExists] && TurfInfo[i][tCapturedGang] == gangid)
	    {
			switch(TurfInfo[i][tType])
			{
			    case 1:
			    {
			        new amount = 5000 + (500*GangInfo[gangid][gMatLevel]);
			        GangInfo[gangid][gMaterials] = GangInfo[gangid][gMaterials] + amount > GetGangStashCapacity(gangid, STASH_CAPACITY_MATERIALS) ? GetGangStashCapacity(gangid, STASH_CAPACITY_MATERIALS) : GangInfo[gangid][gMaterials] + 15000;
					SendGangMessage(gangid, COLOR_YELLOW, "Your gang earned %i materials in the stash for owning %s turf!", amount, TurfInfo[i][tName]);
			        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE gangs SET materials = %i WHERE id = %i", GangInfo[gangid][gMaterials], gangid);
			        mysql_tquery(connectionID, queryBuffer);
				}
			    case 2:
			    {
			        new amount = 3 + GangInfo[gangid][gGunLevel];
			        GangInfo[gangid][gWeapons][GANGWEAPON_9MM] += amount;
				    GangInfo[gangid][gWeapons][GANGWEAPON_SDPISTOL] += amount;
				    GangInfo[gangid][gWeapons][GANGWEAPON_SHOTGUN] += amount;
				    GangInfo[gangid][gWeapons][GANGWEAPON_TEC9] += amount;
				    GangInfo[gangid][gWeapons][GANGWEAPON_UZI] += amount;
			        SendGangMessage(gangid, COLOR_YELLOW, "Your gang earned +%i of 9mm/SDPistol/Shotgun/Tec9/Uzi each in its stash for owning %s turf!", amount, TurfInfo[i][tName]);

			        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE gangs SET weapon_9mm = %i, weapon_sdpistol = %i, weapon_shotgun = %i, weapon_tec9 = %i, weapon_uzi = %i WHERE id = %i", GangInfo[gangid][gWeapons][GANGWEAPON_9MM], GangInfo[gangid][gWeapons][GANGWEAPON_SDPISTOL], GangInfo[gangid][gWeapons][GANGWEAPON_SHOTGUN], GangInfo[gangid][gWeapons][GANGWEAPON_TEC9], GangInfo[gangid][gWeapons][GANGWEAPON_UZI], gangid);
			        mysql_tquery(connectionID, queryBuffer);
				}
				case 3:
				{
			        new amount = 3 + GangInfo[gangid][gGunLevel];
				    GangInfo[gangid][gWeapons][GANGWEAPON_MP5] += amount;
				    GangInfo[gangid][gWeapons][GANGWEAPON_AK47] += amount;
				    GangInfo[gangid][gWeapons][GANGWEAPON_RIFLE] += amount;
			        SendGangMessage(gangid, COLOR_YELLOW, "Your gang earned +%i of MP5/AK47/Rifle each in its stash for owning %s turf!", amount, TurfInfo[i][tName]);

			        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE gangs SET weapon_mp5 = %i, weapon_ak47 = %i, weapon_rifle = %i WHERE id = %i", GangInfo[gangid][gWeapons][GANGWEAPON_MP5], GangInfo[gangid][gWeapons][GANGWEAPON_AK47], GangInfo[gangid][gWeapons][GANGWEAPON_RIFLE], gangid);
			        mysql_tquery(connectionID, queryBuffer);
				}
				case 5:
			    {
			        GangInfo[gangid][gWeed] = GangInfo[gangid][gWeed] + 10 > GetGangStashCapacity(gangid, STASH_CAPACITY_WEED) ? GetGangStashCapacity(gangid, STASH_CAPACITY_WEED) : GangInfo[gangid][gWeed] + 10;
			        GangInfo[gangid][gMeth] = GangInfo[gangid][gMeth] + 10 > GetGangStashCapacity(gangid, STASH_CAPACITY_METH) ? GetGangStashCapacity(gangid, STASH_CAPACITY_METH) : GangInfo[gangid][gMeth] + 10;
			        SendGangMessage(gangid, COLOR_YELLOW, "Your gang earned 10 grams of weed & 10 grams of meth in the stash for owning %s turf!", TurfInfo[i][tName]);

			        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE gangs SET weed = %i, meth = %i WHERE id = %i", GangInfo[gangid][gWeed], GangInfo[gangid][gMeth], gangid);
			        mysql_tquery(connectionID, queryBuffer);
				}
				case 6:
			    {
			        GangInfo[gangid][gCocaine] = GangInfo[gangid][gCocaine] + 15 > GetGangStashCapacity(gangid, STASH_CAPACITY_COCAINE) ? GetGangStashCapacity(gangid, STASH_CAPACITY_COCAINE) : GangInfo[gangid][gCocaine] + 15;
					GangInfo[gangid][gEcstasy] = GangInfo[gangid][gEcstasy] + 10 > GetGangStashCapacity(gangid, STASH_CAPACITY_ECSTASY) ? GetGangStashCapacity(gangid, STASH_CAPACITY_ECSTASY) : GangInfo[gangid][gEcstasy] + 10;
			        SendGangMessage(gangid, COLOR_YELLOW, "Your gang earned 15 grams of cocaine in the stash for owning %s turf!", TurfInfo[i][tName]);
			        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE gangs SET cocaine = %i, ecstasy = %i WHERE id = %i", GangInfo[gangid][gCocaine], GangInfo[gangid][gEcstasy], gangid);
			        mysql_tquery(connectionID, queryBuffer);
				}
				case 7:
				{
				    SendGangMessage(gangid, COLOR_YELLOW, "Your gang will now receive 10 percents of all sales in this turf.");
			    }
			}
		}
	}
	return 1;
}

stock WearBandana(playerid, bool:on)
{
	new gangid = PlayerInfo[playerid][pGang], color = -1;

    if(gangid != -1)
	{
	    if(on)
		{
			if(GangInfo[gangid][gColor] == -1 || GangInfo[gangid][gColor] == -256)
			{
				color = COLOR_GREY;
			}
			else
			{
				color = GangInfo[gangid][gColor];
			}
			new strinssg[120];
			format(strinssg, sizeof(strinssg), "{%06x}%s", color >>> 8, GangInfo[gangid][gName]);
			Bandana[playerid] = CreateDynamic3DTextLabel(strinssg, COLOR_WHITE, 0.0, 0.0, 0.3, 39.0, playerid, INVALID_VEHICLE_ID, .testlos = 1);
		}
		else
		{
			DestroyDynamic3DTextLabel(Bandana[playerid]);
		}
		PlayerInfo[playerid][pBandana] = on;
	}
	return 1;
}

