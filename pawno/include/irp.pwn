			BusinessInfo[businessid][bItemPrice][6],
			BusinessInfo[businessid][bItemPrice][7],
			BusinessInfo[businessid][bItemPrice][8]
			);
			Dialog_Show(playerid, DIALOG_BIZPRICE, DIALOG_STYLE_LIST, "Item Price Menu", bizstring, "Change", "Cancel");
		}
		case BUSINESS_BARCLUB:
		{
			for(new i = 0; i < 5; i++) {
			    if(BusinessInfo[businessid][bItemPrice][i] == 0) {
                    SetDefaultBusinessPrice(businessid);
			    }
			}
		    format(bizstring, sizeof(bizstring), "Water ($%d)\n\
