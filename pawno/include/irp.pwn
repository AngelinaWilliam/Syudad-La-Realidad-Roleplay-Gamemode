	    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE `users` SET boombox = 1 WHERE uid = %i", PlayerInfo[playerid][pID]);
	    mysql_tquery(connectionID, queryBuffer);
	}
	return 1;
}


