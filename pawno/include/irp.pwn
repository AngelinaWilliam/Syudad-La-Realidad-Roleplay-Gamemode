			    {
			        return SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /stash [withdraw] [weed] [amount]");
				}
				if(value < 1 || value > HouseInfo[houseid][hWeed])
				{
