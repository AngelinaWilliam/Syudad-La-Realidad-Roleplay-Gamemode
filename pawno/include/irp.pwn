				    SetMusicStream(MUSIC_VEHICLE, GetPlayerVehicleID(playerid), inputtext);
					SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s changes the song on the radio.", GetRPName(playerid));
