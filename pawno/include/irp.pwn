				mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE `users` SET ecstasy = %i WHERE uid = %i", PlayerInfo[playerid][pEcstasy], PlayerInfo[playerid][pID]);
				mysql_tquery(connectionID, queryBuffer);
				SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s deposits some ecstsay in the gang stash.", GetRPName(playerid));
