  		switch(PlayerInfo[playerid][pMusicType])
		{
            case MUSIC_MP3PLAYER:
            {
                SetMusicStream(MUSIC_MP3PLAYER, playerid, inputtext);
		  		SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s changes the song on their MP3 player.", GetRPName(playerid));
			}
			case MUSIC_BOOMBOX:
			{
			    SetMusicStream(MUSIC_BOOMBOX, playerid, inputtext);
				SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s changes the song on their boombox.", GetRPName(playerid));
			}
			case MUSIC_VEHICLE:
			{
			    if(IsPlayerInAnyVehicle(playerid))
