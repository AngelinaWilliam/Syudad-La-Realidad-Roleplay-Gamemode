stock ShowItemPriceMenu(playerid, businessid)
{
	if(businessid == -1)
	{
	    return SCM(playerid, COLOR_GREY, "You're not inside any business that you own.");
	}
	if(!IsBusinessOwner(playerid, businessid))
	{
	    return SCM(playerid, COLOR_GREY, "You're not inside any business that you own.");
	}
	new bizstring[1224];
	switch(BusinessInfo[businessid][bType])
	{
	    case BUSINESS_STORE:
	    {
			for(new i = 0; i < 15; i++) {
			    if(BusinessInfo[businessid][bItemPrice][i] == 0) {
                    SetDefaultBusinessPrice(businessid);
			    }
			}
			format(bizstring, sizeof(bizstring), "Mobile phone ($%d)\n \
			Walkie talkie ($%d)\n \
			Cigars ($%d)\n \
			Spraycans ($%d)\n \
			Camera ($%d)\n \
			MP3 player ($%d)\n \
			Fishing rod ($%d)\n \
			Fish bait ($%d)\n \
			Muriatic acid ($%d)\n \
			Baking soda ($%d)\n \
			Pocket watch ($%d)\n \
			GPS system ($%d)\n \
			Gasoline can ($%d)\n \
			Rope ($%d)\n \
			Boombox ($%d)\n \
			Blindfold rag($%d)",
			BusinessInfo[businessid][bItemPrice][0],
			BusinessInfo[businessid][bItemPrice][1],
			BusinessInfo[businessid][bItemPrice][2],
			BusinessInfo[businessid][bItemPrice][3],
			BusinessInfo[businessid][bItemPrice][4],
			BusinessInfo[businessid][bItemPrice][5],
			BusinessInfo[businessid][bItemPrice][6],
			BusinessInfo[businessid][bItemPrice][7],
			BusinessInfo[businessid][bItemPrice][8],
			BusinessInfo[businessid][bItemPrice][9],
			BusinessInfo[businessid][bItemPrice][10],
			BusinessInfo[businessid][bItemPrice][11],
			BusinessInfo[businessid][bItemPrice][12],
			BusinessInfo[businessid][bItemPrice][13],
			BusinessInfo[businessid][bItemPrice][14],
			BusinessInfo[businessid][bItemPrice][15]);
			Dialog_Show(playerid, DIALOG_BIZPRICE, DIALOG_STYLE_LIST, "Item Price Menu", bizstring, "Change", "Cancel");
		}
		case BUSINESS_GUNSHOP:
		{
			for(new i = 0; i < 5; i++) {
			    if(BusinessInfo[businessid][bItemPrice][i] == 0) {
                    SetDefaultBusinessPrice(businessid);
			    }
			}
		    format(bizstring, sizeof(bizstring), "9mm pistol ($%d)\n \
			Shotgun ($%d)\n\
