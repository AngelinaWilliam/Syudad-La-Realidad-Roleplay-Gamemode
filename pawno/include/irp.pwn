CMD:delete(playerid, params[])
{
	new
		furniture;

	if (PlayerInfo[playerid][pHouseEdit] == -1 || !HouseInfo[PlayerInfo[playerid][pHouseEdit]][hEdit])
	{
	    return SendErrorMessage(playerid, "You are not editing furniture.");
	}
	else if (sscanf(params, "i", furniture))
	{
	    return SendSyntaxMessage(playerid, "/delete (furniture ID)");
	}
	else if (!IsValidFurnitureID(furniture))
	{
	    return SendErrorMessage(playerid, "You have specified an invalid furniture ID.");
	}
	else if (Furniture[furniture][fHouseID] != HouseInfo[PlayerInfo[playerid][pHouseEdit]][hID])
	{
	    return SendErrorMessage(playerid, "The specified ID belongs to another house.");
	}
	else
	{
		if (PlayerInfo[playerid][pEdit] == EDIT_TYPE_FURNITURE)
		{
			CancelObjectEdit(playerid);
		}
		DeleteFurniture(furniture);
		SendInfoMessage(playerid, "You are deleted furniture ID: %i.", furniture);
	}
	return 1;
}

CMD:cancel(playerid, params[])
{
	if (PlayerInfo[playerid][pHouseEdit] == -1 || !HouseInfo[PlayerInfo[playerid][pHouseEdit]][hEdit])
	{
	    return SendErrorMessage(playerid, "You are not editing furniture.");
	}
	else
	{
	    SetFurnitureEditMode(PlayerInfo[playerid][pHouseEdit], false);

	    PlayerInfo[playerid][pHouseEdit] = -1;
	    SendInfoMessage(playerid, "You are no longer editing furniture.");
	}
	return 1;
}

CMD:doublexp(playerid, params[])
{
	if(PlayerInfo[playerid][pAdmin] >= MANAGEMENT)
	{
	    SetRewardPlay(true);
	    SetDoubleXP(true);
		SendClientMessageToAllEx(COLOR_AQUA, "* %s enabled happy hours. You will now get random gifts and double xp for playing in the server.", GetRPName(playerid));
	}
	return 1;
}

CMD:enddoublexp(playerid, params[])
{
	if(PlayerInfo[playerid][pAdmin] >= MANAGEMENT)
	{
	    SetRewardPlay(false);
	    SetDoubleXP(false);
	}
	return 1;
}

CMD:number(playerid, params[])
{
	new targetid;

	if(sscanf(params, "u", targetid))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /number [playerid]");
	}
	if(!PlayerInfo[playerid][pPhonebook])
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You can't use this command as you don't have a phonebook.");
	}
	if(!IsPlayerConnected(targetid))
	{
	    return SendClientMessage(playerid, COLOR_GREY, "The player specified is disconnected.");
	}

    SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s takes out a cellphone and looks up a number.", GetRPName(playerid));
	SendClientMessageEx(playerid, COLOR_GREY2, "Name: %s, Ph: %i", GetRPName(targetid), PlayerInfo[targetid][pPhone]);
	return 1;
}
CMD:select(playerid, params[])
{
    new landid = GetNearbyLand(playerid);
    if(!PlayerUseAnims(playerid))
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You're currently unable to use object selection at this moment.");
	}
	if(landid != -1 && HasLandPerms(playerid, landid))
    {
		SelectObject(playerid);
		return SendClientMessage(playerid, -1, "You are now selecting land objects.");
	}

	return 1;
}
CMD:listmasked(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] < JUNIOR_ADMIN)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You are not authorized to use this command.");
	}
	if(!PlayerInfo[playerid][pAdminDuty] && PlayerInfo[playerid][pAdmin] < GENERAL_MANAGER)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "This command requires you to be on admin duty. /aduty to go on duty.");
	}
	SendClientMessageEx(playerid, COLOR_GREEN, "Lisiting masked players...");
	foreach(new i : Player)
	{
	    if(PlayerInfo[i][pWearMask] == 1)
	    {
			SendClientMessageEx(playerid, -1, "%s as mask id Stranger_%d", GetPlayerNameEx(i), PlayerInfo[i][pMaskID]);
		}
	}
	return 1;
}
CMD:mask(playerid, params[])
{
	if(PlayerHasMask(playerid))
	{
		if(PlayerInfo[playerid][pWearMask] == 0)
		{
		    SetPlayerSpecialTag(playerid, TAG_MASK);
	 	    SendClientMessage(playerid, COLOR_AQUA, "You have enabled your mask. Your name will be hidden now.");
		    SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s takes out a mask and wraps it around their face.", GetRPName(playerid));
			PlayerInfo[playerid][pWearMask] = 1;
		}
		else
		{
            SetPlayerSpecialTag(playerid, TAG_NONE);
		    SendClientMessage(playerid, COLOR_AQUA, "You have disabled your mask. Your name will not be hidden anymore.");
		    SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s takes off their mask from their face.", GetRPName(playerid));
		    PlayerInfo[playerid][pWearMask] = 0;
		}
	}
	else {
		SendClientMessage(playerid, -1, "You don't have a mask, purchase one from clothing store!");
	}
	return 1;
}
