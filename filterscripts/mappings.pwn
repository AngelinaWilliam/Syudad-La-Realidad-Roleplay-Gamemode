#include <open.mp>
#include streamer
new tmpobjid;
new bool:HospitalExt, hpdoor;
new bool:HospitalExt2, hpdoor2;

stock AntiDeAMX()
{
    new a[][] = {
        "Unarmed (Fist)",
        "Brass K"
    };
    #pragma unused a
}

DefineGatesAndDoors()
{
    // hospital
    hpdoor = CreateDynamicObject(19325, 1263.647827, -1250.600830, 14.516165, 0.000000, 0.000000, 90.000000, -1, -1, -1, 300.00, 300.00);
    HospitalExt = false;

    hpdoor2 = CreateDynamicObject(19325, 1257.007690, -1250.600830, 14.516165, 0.000000, 0.000000, 90.000000, -1, -1, -1, 300.00, 300.00);
    HospitalExt2 = false;
}
forward HospitalClose(); 
public HospitalClose()
{
    MoveDynamicObject( hpdoor,  1263.647827, -1250.600830, 14.516165, 2.00 ); 
    HospitalExt = false;
}

forward HospitalClose1(); 
public HospitalClose1()
{
    MoveDynamicObject( hpdoor2,  1257.007690, -1250.600830, 14.516165, 2.00 ); 
    HospitalExt2 = false;
}

public OnGameModeInit()
{
	AntiDeAMX();
	return 1;
}

