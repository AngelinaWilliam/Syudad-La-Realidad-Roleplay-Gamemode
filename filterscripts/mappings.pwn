public OnPlayerUpdate(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid, 2.0, 1260.182861, -1250.495849, 13.681080))
    {
        if(HospitalExt == false)
        {
            MoveDynamicObject( hpdoor, 1265.288818, -1250.600830, 14.516165, 3.00 );
            SetTimer( "HospitalClose", 2000, 0 );
            HospitalExt = true;
        }
    }
    else if(IsPlayerInRangeOfPoint(playerid, 2.4, 1260.182861, -1250.495849, 13.681080))
    {
        if(HospitalExt2 == false)
        {
            MoveDynamicObject( hpdoor2, 1255.317871, -1250.600830, 14.516165, 3.00 );
            SetTimer( "HospitalClose1", 2000, 0 );
            HospitalExt2 = true;
        }
    }
    return 1;
}
