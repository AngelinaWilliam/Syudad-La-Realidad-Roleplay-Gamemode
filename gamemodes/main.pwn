        case DIALOG_REFERRAL:
        {
            if(response)
            {
                if(isnull(inputtext) || strlen(inputtext) > 24)
                {
                    return ShowDialogToPlayer(playerid, DIALOG_REFERRAL);
                }
                if(!strcmp(inputtext, GetPlayerNameEx(playerid)))
                {
                    SCM(playerid, COLOR_SYNTAX, "You can't put down your own name as a referral.");
                    return ShowDialogToPlayer(playerid, DIALOG_REFERRAL);
                }

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT username, ip, uid FROM users WHERE username = '%e'", inputtext);
                mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_CHECK_REFERRAL, playerid);
            }
            else
            {
                PlayerInfo[playerid][pTutorial] = 1;

                PlayerInfo[playerid][pTutorial] = 0;
                PlayerInfo[playerid][pSetup] = 0;

                SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
                PlayerInfo[playerid][pHunger] = 100; // Hunger
                PlayerInfo[playerid][pHungerTimer] = 0;
                PlayerInfo[playerid][pThirst] = 100; // Thirst
                PlayerInfo[playerid][pThirstTimer] = 0;

                SetPlayerPos(playerid, 1585.4670,-2332.8362,13.5890);
                SetPlayerFacingAngle(playerid, 87.7721);
                SetPlayerVirtualWorld(playerid, 0);
                SetPlayerInterior(playerid, 0);
                SetCameraBehindPlayer(playerid);
                StopAudioStreamForPlayer(playerid);
                TogglePlayerControllable(playerid, 1);
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE `users` SET setup = 0, gender = %i, age = %i, skin = %i WHERE uid = %i", PlayerInfo[playerid][pGender], PlayerInfo[playerid][pAge], PlayerInfo[playerid][pSkin], PlayerInfo[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);
                SendClientMessage(playerid, COLOR_WHITE, "Welcome to "SVRCLR""SERVER_NAME"{FFFFFF}. Make sure to visit "SERVER_URL" for news and updates.");
                SendClientMessage(playerid, COLOR_WHITE, "Use the {FFFF90}/locate{FFFFFF} command to point to locations of jobs, businesses, and common places.");
                SMA(SERVER_COLOR,"Messages:"WHITE" Hey guys! "SVRCLR"%s (%d)"WHITE" joined for the first time! Wish them a great stay!", GetPlayerNameEx(playerid), playerid);


                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET weaponrestricted = %i WHERE uid = %i", PlayerInfo[playerid][pWeaponRestricted], PlayerInfo[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                GivePlayerCash(playerid, 20000);
                Inventory_Clear(playerid);

                // Refud
                PlayerInfo[playerid][pDonator] = 3;
                PlayerInfo[playerid][pVIPTime] = gettime() + (345600);
                PlayerInfo[playerid][pVIPCooldown] = 0;

                new plate[32];
                SCM(playerid, COLOR_AQUA, "You have claimed your refund, /vstorage to spawn your SUNRISE");
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO vehicles (ownerid, owner, modelid, pos_x, pos_y, pos_z, pos_a, plate, color1, color2, carImpounded) VALUES(%i, '%s', %i, '%f', '%f', '%f', '%f', '%s', %i, %i, '0')", PlayerInfo[playerid][pID], GetPlayerNameEx(playerid), 550, 1560.7916, -2325.3455, 13.0894, 86.5800, mysql_escaped(plate), 0, 0);
                mysql_tquery(connectionID, queryBuffer);

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET vippackage = 3, viptime = %i, vipcooldown = 0 WHERE uid = %i", PlayerInfo[playerid][pVIPTime], PlayerInfo[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                ShowPlayerDialog(playerid, DIALOGID_GUIDE_MAIN, DIALOG_STYLE_LIST, "Guide", "How to make money\nGetting guns\nJoining a gang or faction\nHow to roleplay\nHow to level up", "Ok", "Cancel");
                viewingGuide[playerid] = 1;

                for (new i = 0; i < 6; i ++)
                {
                    PlayerTextDrawShow(playerid, HungerTD[playerid][i]);
                }
                for(new l =0; l < 5; l++) TextDrawShowForPlayer(playerid, new_logo[l]);
                StopAudioStreamForPlayer(playerid);
                TogglePlayerControllable(playerid, 1);

            }
        }
        case DIALOG_INTERIORS:
        {
            if(response)
            {
                TeleportToCoords(playerid, interiorArray[listitem][intX], interiorArray[listitem][intY], interiorArray[listitem][intZ], interiorArray[listitem][intA], interiorArray[listitem][intID], GetPlayerVirtualWorld(playerid));
                GameTextForPlayer(playerid, "~w~Teleported", 5000, 1);
            }
        }
        case GatePass:
        {
            if (response)
            {
                new id = Gate_Nearest(playerid);

                if (id == -1)
                    return 0;

                if (isnull(inputtext))
                    return ShowPlayerDialog(playerid, GatePass, DIALOG_STYLE_INPUT, "Enter Password", "Please enter the password for this gate below:", "Submit", "Cancel");

                if (strcmp(inputtext, GateData[id][gatePass]) != 0)
                    return ShowPlayerDialog(playerid, GatePass, DIALOG_STYLE_INPUT, "Enter Password", "Error: Incorrect password specified.\n\nPlease enter the password for this gate below:", "Submit", "Cancel");

                Gate_Operate(id);
            }
        }
        case DIALOG_EDITBUY:
        {
            if(response)
            {
                PlayerInfo[playerid][pProductChoose] = listitem;
                //SM(playerid, COLOR_SYNTAX,"You are editing product number: %i", PlayerInfo[playerid][pProductChoose]);
                ShowPlayerDialog(playerid, DIALOG_EDITBUY2, DIALOG_STYLE_INPUT, SERVER_DIALOG, "Please enter the new product price:", "Modify", "");
            }
        }
        case DIALOG_EDITBUY2: {
            if(response)
