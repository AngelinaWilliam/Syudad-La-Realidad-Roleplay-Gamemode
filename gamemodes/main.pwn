        GiveWeapon(playerid, 31, true);
        GiveWeapon(playerid, 34, true);
        PlayerInfo[playerid][pPaintball] = 2;
        PlayerInfo[playerid][pPaintballTeam] = pbNext;
        if(!pbNext)
        {
            pbNext = 1;
        }
        else
