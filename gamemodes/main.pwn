            switch(listitem){
                case 0: format(bpsize,sizeof(bpsize), "Small Backpack");
                case 1: format(bpsize,sizeof(bpsize), "Medium Backpack");
                case 2: format(bpsize,sizeof(bpsize), "Large Backpack");
            }
