stock ShowGPSTextdraw(playerid) {
    PlayerTextDrawShow(playerid, PlayerInfo[playerid][pText][0]);

}

stock HideGPSTextdraw(playerid) {
    PlayerTextDrawHide(playerid, PlayerInfo[playerid][pText][0]);
