                            cache_get_field_content(i, "username", name);
                            Money = cache_get_field_content_int(i, "candy");

                            format(fString, sizeof fString, "%s\t%i Candiues\n", name, Money);
                            strcat(cString, fString);
                        }
                    }
                    cache_delete(Result);
                    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST, "Top 10 Candies Collector", cString, "Okay","");
                }


            }
        }
        case DIALOG_DLOCKER: {
            if(response) {
                ShowPlayerDialog(playerid, DIALOG_DGUN, DIALOG_STYLE_TABLIST_HEADERS, "Donator Gun Locker", "Weapon\tAmount\nDeagle\t$1,000\nSpas-12\t$2,750\nM4\t$1,750\nKevlar Vest\t$350\nFirst aid kit\t$250\nSniper\t$3,250\nFull Set\t$8,750", "Buy", "Cancel");
