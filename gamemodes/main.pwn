CMD:eat(playerid, params[])
{
    if (!PlayerHasItem(playerid, "Burger"))
        return SendErrorMessage(playerid, "You don't have a Burger on you.");

    if (PlayerInfo[playerid][pHunger] >= 90)
    return SM(playerid, COLOR_GREY, "You aren't hungry!");

    PlayerInfo[playerid][pHunger] += 10;
    PlayerInfo[playerid][pHungerTimer] = 0;


    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET hunger = %i, hungertimer = %i WHERE uid = %i", PlayerInfo[playerid][pHunger], PlayerInfo[playerid][pHungerTimer], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    Inventory_Remove(playerid, "Burger");

    ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0);

    return 1;
}

CMD:eatpizza(playerid, params[])
{
    if (!PlayerHasItem(playerid, "Pizza"))
        return SendErrorMessage(playerid, "You don't have a Pizza on you.");

    if (PlayerInfo[playerid][pHunger] >= 90)
    return SM(playerid, COLOR_GREY, "You aren't hungry!");

    PlayerInfo[playerid][pHunger] += 10;
    PlayerInfo[playerid][pHungerTimer] = 0;


    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET hunger = %i, hungertimer = %i WHERE uid = %i", PlayerInfo[playerid][pHunger], PlayerInfo[playerid][pHungerTimer], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    Inventory_Remove(playerid, "Pizza");

    ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0);

    return 1;
}

CMD:drink(playerid, params[])
{
    if (!PlayerHasItem(playerid, "Soda"))
        return SendErrorMessage(playerid, "You don't have a Soda on you.");

    if (PlayerInfo[playerid][pThirst] >= 90)
    return SM(playerid, COLOR_GREY, "You aren't thirsty!");

    PlayerInfo[playerid][pThirst] += 10;
    PlayerInfo[playerid][pThirstTimer] = 0;


    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET thirst = %i, thirsttimer = %i WHERE uid = %i", PlayerInfo[playerid][pThirst], PlayerInfo[playerid][pThirstTimer], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    Inventory_Remove(playerid, "Soda");

    ApplyAnimationEx(playerid, "VENDING", "vend_drink_p", 4.0, 1, 0, 0, 0, 0);

    return 1;
}


