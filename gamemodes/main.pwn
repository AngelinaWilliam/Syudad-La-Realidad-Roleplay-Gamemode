	}

    new tableid = GetPVarInt(playerid, "pkrTableID")-1;
    if(playertextid == PlayerPokerUI[playerid][38])
    {
        switch(GetPVarInt(playerid, "pkrActionOptions"))
        {
            case 1: // Raise
            {
                PokerRaiseHand(playerid);
                PokerTable[tableid][pkrRotations] = 0;
            }
            case 2: // Call
            {
                PokerCallHand(playerid);
            }
            case 3: // Check
            {
                PokerCheckHand(playerid);
                PokerRotateActivePlayer(tableid);
            }
        }
    }
    else if(playertextid == PlayerPokerUI[playerid][39])
    {
        switch(GetPVarInt(playerid, "pkrActionOptions"))
        {
            case 1: // Check
            {
                PokerCheckHand(playerid);
                PokerRotateActivePlayer(tableid);
            }
            case 2: // Raise
            {
                PokerRaiseHand(playerid);
                PokerTable[tableid][pkrRotations] = 0;
            }
            case 3: // Fold
            {
                PokerFoldHand(playerid);
                PokerRotateActivePlayer(tableid);
            }
        }
    }
    else if(playertextid == PlayerPokerUI[playerid][40])
    {
        switch(GetPVarInt(playerid, "pkrActionOptions"))
        {
            case 1: // Fold
            {
                PokerFoldHand(playerid);
                PokerRotateActivePlayer(tableid);
            }
            case 2: // Fold
            {
                PokerFoldHand(playerid);
                PokerRotateActivePlayer(tableid);
            }
        }
    }
    else if(playertextid == PlayerPokerUI[playerid][41]) // LEAVE
    {
        if(GetPVarType(playerid, "pkrTableID")) {
            LeavePokerTable(playerid);
        }
    }
    else if (playertextid == PhoneTD[playerid][17])
    {
        if (PlayerInfo[playerid][pTogglePhone])
            return SendErrorMessage(playerid, "Your phone must be powered on.");

        ListContacts(playerid);
    }
    else if (playertextid == PhoneTD[playerid][18])
    {
        if (PlayerInfo[playerid][pTogglePhone])
            return SendErrorMessage(playerid, "Your phone must be powered on.");

        ShowPlayerDialog(playerid, PhoneCall, DIALOG_STYLE_INPUT, "{6688FF}Call Number", "Please specify the number you would like to call:", "Call", "Cancel");
    }
    else if (playertextid == PhoneTD[playerid][20])
    {
        if (PlayerInfo[playerid][pTogglePhone])
            return SendErrorMessage(playerid, "Your phone must be powered on.");

        Dialog_Show(playerid, PhoneSMS, DIALOG_STYLE_INPUT, "{6688FF}SMS Number", "Please specify the number you would like to SMS:", "Call", "Cancel");
    }
    else if (playertextid == PhoneTD[playerid][21])
    {
        if (PlayerInfo[playerid][pTogglePhone])
            return SendErrorMessage(playerid, "Your phone must be powered on.");

        for (new i = 0; i < 9; i ++)
        {
            PlayerTextDrawShow(playerid, GCASHTD[playerid][i]);
        }
        for (new i = 0; i < 29; i ++)
        {
            PlayerTextDrawHide(playerid, PhoneTD[playerid][i]);
        }
        SelectTextDraw(playerid, -1);
        //Dialog_Show(playerid, DialNumber, DIALOG_STYLE_INPUT, "Dial Number", "Please enter the number that you wish to dial below:", "Dial", "Back");
    }
    else if (playertextid == PhoneTD[playerid][27])
    {
        if (PlayerInfo[playerid][pTogglePhone])
            return SendErrorMessage(playerid, "Your phone must be powered on.");

        ShowDialogToPlayer(playerid, DIALOG_LOCATE);
    }
    else if (playertextid == PhoneTD[playerid][9])
    {
        for (new i = 0; i < 29; i ++)
        {
            PlayerTextDrawHide(playerid, PhoneTD[playerid][i]);
        }
        CancelSelectTextDraw(playerid);
    }
    else if (playertextid == PhoneTD[playerid][19])
    {
        static
            str[32];

        format(str, sizeof(str), "Phone (#%d)", PlayerInfo[playerid][pPhone]);

        Dialog_Show(playerid, PhoneSettings, DIALOG_STYLE_LIST, "{6688FF}Phone Settings", "Power %s\nSound Off", "Select", "Cancel", (PlayerInfo[playerid][pTogglePhone]) ? ("Off") : ("On"));
    }
    else if (playertextid == GCASHTD[playerid][6])
    {
        ShowDialogToPlayer(playerid, DIALOG_ATM_TRANSFER_ID);
    }
    else if (playertextid == GCASHTD[playerid][8])
    {
        for (new i = 0; i < 9; i ++)
        {
            PlayerTextDrawHide(playerid, GCASHTD[playerid][i]);
        }
        for (new i = 0; i < 29; i ++)
        {
            PlayerTextDrawShow(playerid, PhoneTD[playerid][i]);
        }
    }
    else if (playertextid == CallingTD[playerid][22])
    {
        for (new i = 0; i < 23; i ++)
        {
            PlayerTextDrawHide(playerid, CallingTD[playerid][i]);
        }
        HangupCall(playerid);
        SendInfoMessage(playerid, "You have ended the call.");
        CancelSelectTextDraw(playerid);
    }
    else if (playertextid == CallingTD[playerid][21])
    {
        for (new i = 0; i < 23; i ++)
        {
            PlayerTextDrawHide(playerid, CallingTD[playerid][i]);
        }
        CancelSelectTextDraw(playerid);
        PlayerInfo[playerid][pCalling] = 2;
        PlayerInfo[PlayerInfo[playerid][pCaller]][pCalling] = 2;

        SendInfoMessage(playerid, "You have answered the call from %s. Use /hangup to hang up.", GetRPName(PlayerInfo[playerid][pCaller]));
        SendInfoMessage(PlayerInfo[playerid][pCaller], "The other line has picked up the call. Use /hangup to hang up.");
        SetPlayerCellphoneAction(playerid, true);
        PlayerPlaySound(playerid, 20601, 0.0, 0.0, 0.0);
    }
    else if (playertextid == CallingTD[playerid][9])
    {
        for (new i = 0; i < 23; i ++)
        {
            PlayerTextDrawHide(playerid, CallingTD[playerid][i]);
        }
        CancelSelectTextDraw(playerid);
    }

    else if(playertextid == WeeklyTaskTD[playerid][8])
    {
        for( new i = 0; i < 37; i ++)
        {
            PlayerTextDrawHide(playerid, WeeklyTaskTD[playerid][i]);
            CancelSelectTextDraw(playerid);
        }
    }
    // Task 1
    else if(playertextid == WeeklyTaskTD[playerid][27])
    {
        if(PlayerInfo[playerid][pClaimed1] == 1)
        {
            return SCM(playerid, COLOR_SYNTAX, "You already claimed this reward.");
        }

        if(PlayerInfo[playerid][pTask1] < 20)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are not yet finish with this task. Please complete it to claim your reward (( playing hours )).");
        }
        PlayerInfo[playerid][pClaimed1] = 1;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET claimed1 = %d WHERE uid = %i", PlayerInfo[playerid][pClaimed1], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        PlayerInfo[playerid][pTiki] += 8;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET tikis = %i WHERE uid = %i", PlayerInfo[playerid][pTiki], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        GivePlayerCash(playerid, 5000);
        SCM(playerid, COLOR_AQUA, "Congratulations! You completed this task and rewarded 8 tiki(s) & 5,000 $.");

    }
    // Task 2
    else if(playertextid == WeeklyTaskTD[playerid][28])
    {
        if(PlayerInfo[playerid][pClaimed2] == 1)
        {
            return SCM(playerid, COLOR_SYNTAX, "You already claimed this reward.");
        }
        if(PlayerInfo[playerid][pTask2] < 10)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are not yet finish with this task. Please complete it to claim your reward (( forklifter )).");
        }

        PlayerInfo[playerid][pClaimed2] = 1;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET claimed2 = %d WHERE uid = %i", PlayerInfo[playerid][pClaimed2], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);


        PlayerInfo[playerid][pTiki] += 3;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET tikis = %i WHERE uid = %i", PlayerInfo[playerid][pTiki], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        GivePlayerCash(playerid, 5000);
        SCM(playerid, COLOR_AQUA, "Congratulations! You completed this task and rewarded 3 tiki(s) & 5,000 $.");
    }
    // Task 3
    else if(playertextid == WeeklyTaskTD[playerid][31])
    {
        if(PlayerInfo[playerid][pClaimed3] == 1)
        {
            return SCM(playerid, COLOR_SYNTAX, "You already claimed this reward.");
        }
        if(PlayerInfo[playerid][pTask3] < 30)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are not yet finish with this task. Please complete it to claim your reward (( lumber )).");
        }
        PlayerInfo[playerid][pClaimed3] = 1;

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET claimed3 = %d WHERE uid = %i", PlayerInfo[playerid][pClaimed3], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);


        PlayerInfo[playerid][pTiki] += 3;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET tikis = %i WHERE uid = %i", PlayerInfo[playerid][pTiki], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        GivePlayerCash(playerid, 5000);
        SCM(playerid, COLOR_AQUA, "Congratulations! You completed this task and rewarded 3 tiki(s) & 5,000 $.");
    }
    // Task 4
    else if(playertextid == WeeklyTaskTD[playerid][30])
    {
        if(PlayerInfo[playerid][pClaimed4] == 1)
        {
            return SCM(playerid, COLOR_SYNTAX, "You already claimed this reward.");
        }
        if(PlayerInfo[playerid][pTask4] < 30)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are not yet finish with this task. Please complete it to claim your reward (( foodpanda )).");
        }

        PlayerInfo[playerid][pClaimed4] = 1;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET claimed4 = %d WHERE uid = %i", PlayerInfo[playerid][pClaimed4], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        PlayerInfo[playerid][pTiki] += 3;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET tikis = %i WHERE uid = %i", PlayerInfo[playerid][pTiki], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        GivePlayerCash(playerid, 5000);
        SCM(playerid, COLOR_AQUA, "Congratulations! You completed this task and rewarded a 3 tiki(s) & 5,000 $.");

    }
    // Task 5
    else if(playertextid == WeeklyTaskTD[playerid][29])
    {
        if(PlayerInfo[playerid][pClaimed5] == 1)
        {
            return SCM(playerid, COLOR_SYNTAX, "You already claimed this reward.");
        }
        if(PlayerInfo[playerid][pTask5] < 2)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are not yet finish with this task. Please complete it to claim your reward (( property )).");
        }
        PlayerInfo[playerid][pClaimed5] = 1;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET claimed5 = %d WHERE uid = %i", PlayerInfo[playerid][pClaimed5], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        PlayerInfo[playerid][pTiki] += 3;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET tikis = %i WHERE uid = %i", PlayerInfo[playerid][pTiki], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        GivePlayerCash(playerid, 5000);
        SCM(playerid, COLOR_AQUA, "Congratulations! You completed this task and rewarded a 3 tiki(s) & 5,000 $.");
    }
    if (PlayerInfo[playerid][pDealershipMenu] != -1)
    {
        if (playertextid == PlayerInfo[playerid][pText][83])
        {
            PlayerInfo[playerid][pDealershipIndex] = GetPreviousDealershipCar(PlayerInfo[playerid][pDealershipMenu], PlayerInfo[playerid][pDealershipIndex]);

            PlayerPlaySound(playerid, 1053, 0.0, 0.0, 0.0);
            UpdateDealershipPreview(playerid);
        }
        else if (playertextid == PlayerInfo[playerid][pText][85])
        {
            PlayerInfo[playerid][pDealershipIndex] = GetNextDealershipCar(PlayerInfo[playerid][pDealershipMenu], PlayerInfo[playerid][pDealershipIndex]);

            PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
            UpdateDealershipPreview(playerid);
        }
        else if (playertextid == PlayerInfo[playerid][pText][84])
        {
            new
                index = PlayerInfo[playerid][pDealershipIndex],
                businessid = GetInsideBusiness(playerid);

            if (!PlayerCanAfford(playerid, DealershipCars[index][dcPrice]))
            {
                return SendErrorMessage(playerid, "You can't afford to buy this vehicle.");
            }
            else if (!IsVehicleSpawnSetup(PlayerInfo[playerid][pDealershipMenu]))
            {
                return SendErrorMessage(playerid, "The vehicle spawn point is not setup.");
            }
            else
            {
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT * FROM `vehicles` WHERE `ownerid` = %d", PlayerInfo[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer, "OnVehicleLookUP", "i", playerid);

                if(vehicleCount[playerid] >= GetPlayerAssetLimit(playerid, LIMIT_VEHICLES))
                {
                    HideDealershipPreview(playerid);
                    return SM(playerid, COLOR_GREY, "You currently own %i/%i vehicles. You can't own anymore unless you upgrade your asset perk.", vehicleCount[playerid], GetPlayerAssetLimit(playerid, LIMIT_VEHICLES));
                }
                else if(GetSpawnedVehicles(playerid) >= MAX_SPAWNED_VEHICLES)
                {
                    HideDealershipPreview(playerid);
                    return SM(playerid, COLOR_GREY, "You can't have more than %i vehicles spawned at a time.", MAX_SPAWNED_VEHICLES);
                }
                else
                {
                    new string[80];                 //format(string, 32, "%c%c%c %i", Random('A', 'Z'), Random('A', 'Z'), Random('A', 'Z'), Random(100, 999));
                    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO vehicles (ownerid, owner, modelid, price, plate, pos_x, pos_y, pos_z, pos_a) VALUES(%i, '%s', %i, %i, '%s', '%f', '%f', '%f', '%f')", PlayerInfo[playerid][pID], GetPlayerNameEx(playerid), DealershipCars[index][dcModel], DealershipCars[index][dcPrice], mysql_escaped(string), BusinessInfo[PlayerInfo[playerid][pDealershipMenu]][cVehicle][0], BusinessInfo[PlayerInfo[playerid][pDealershipMenu]][cVehicle][1], BusinessInfo[PlayerInfo[playerid][pDealershipMenu]][cVehicle][2], BusinessInfo[PlayerInfo[playerid][pDealershipMenu]][cVehicle][3]);
                    mysql_tquery(connectionID, queryBuffer);

                    BusinessInfo[businessid][bCash] += DealershipCars[index][dcPrice];
                    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE businesses SET cash = %i WHERE id = %i", BusinessInfo[businessid][bCash], BusinessInfo[businessid][bID]);
                    mysql_tquery(connectionID, queryBuffer);

                    BusinessInfo[businessid][bProducts]--;

                    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE businesses SET cash = %i, products = %i WHERE id = %i", BusinessInfo[businessid][bCash], BusinessInfo[businessid][bProducts], BusinessInfo[businessid][bID]);
                    mysql_tquery(connectionID, queryBuffer);

                    GivePlayerCash(playerid, -DealershipCars[index][dcPrice]);
                    format(string, sizeof(string), "~r~-$%i", DealershipCars[index][dcPrice]);
                    GameTextForPlayer(playerid, string, 5000, 1);
                    SM(playerid, COLOR_GREEN, "%s purchased for $%i. type /vst to spawn this vehicle.", GetVehicleModelName(DealershipCars[index][dcModel]), DealershipCars[index][dcPrice]);
                    Log_Write("log_property", "%s (uid: %i) purchased a %s for $%i.", GetPlayerNameEx(playerid), PlayerInfo[playerid][pID], GetVehicleModelName(DealershipCars[index][dcModel]), DealershipCars[index][dcPrice]);
                    HideDealershipPreview(playerid);

                }
            }
        }
    }
    return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    for(new i = 0; i < MAX_INVENTORY; i++)
	{
	    if(clickedid == MODELTD[i])
	    {
			if(InventoryData[playerid][i][invExists])
			{
				MenuStore_UnselectRowD(playerid);
				MenuStore_SelectRowD(playerid, i);
				new name[48];
				strunpack(name, InventoryData[playerid][PlayerInfo[playerid][pSelectItem]][invItem]);
			}
	    }
	}
	if(clickedid == INVINFO[2])
	{
		new id = PlayerInfo[playerid][pSelectItem];

		if(id == -1)
		{
		    SendClientMessage(playerid, COLOR_YELLOW, "Select Item");
		}
		else
		{
			new string[64];
			strunpack(string, InventoryData[playerid][id][invItem]);
		
			if(!PlayerHasItem(playerid, string))
			{
				SendClientMessage(playerid, COLOR_YELLOW, "You Not Have This Item");
				Inventory_Show(playerid);
			}
			else
			{
			CallLocalFunction("OnPlayerUseItem", "dds", playerid, InventoryData[playerid][id][invModel], string);
			}
		}
	}
	else if(clickedid == INVINFO[5])
	{
		Inventory_Close(playerid);
	}	
	else if(clickedid == INVINFO[11])
	{
		AddWeapontoInv(playerid, GetWeaponInvName(GetPlayerWeapon(playerid)));
	}		
	else if(clickedid == INVINFO[4])
	{
		new str[1024], id = PlayerInfo[playerid][pSelectItem], count = 0;

		if(id == -1)
		{
			SendClientMessage(playerid, COLOR_YELLOW, "Select Item");
		}
		else
		{
		    new string[64];
			strunpack(string, InventoryData[playerid][id][invItem]);
			if (PlayerInfo[playerid][pGiveAmount] < 1)
				return SendClientMessage(playerid, COLOR_YELLOW, "Set Amount First");

			CallLocalFunction("OnPlayerDropInvItem", "dds[128]d", playerid, InventoryData[playerid][id][invModel], string, PlayerInfo[playerid][pGiveAmount]);
		}
	}
	else if(clickedid == INVINFO[3])
	{
		new str[1024], id = PlayerInfo[playerid][pSelectItem], count = 0;

		if(id == -1)
		{
			SendClientMessage(playerid, COLOR_YELLOW, "Select Item");
		}
		else
		{
			if (PlayerInfo[playerid][pGiveAmount] < 1)
				return SendClientMessage(playerid, COLOR_YELLOW, "Set Amount First");

			foreach(new i : Player) if(IsPlayerConnected(i) && NearPlayer(playerid, i, 5) && i != playerid)
			{
			    format(str, sizeof(str), "%s Pocket - %i", GetRPName(i), i);
			    SetPlayerListitemValue(playerid, count++, i);
			}
			if(!count) SendClientMessage(playerid, COLOR_YELLOW, "No one near you");
			else ShowPlayerDialog(playerid, DIALOG_GIVE, DIALOG_STYLE_LIST, "Inventory", str, "Yes", "No");
		}
	}
	else if(clickedid == INVINFO[1])
	{
		ShowPlayerDialog(playerid, DIALOG_AMOUNT, DIALOG_STYLE_INPUT, "Inventory - Amount", "ENTER THE AMOUNT:", "Yes", "No");
	}
	
    if (PlayerInfo[playerid][pIgnoreTD])
    {
        PlayerInfo[playerid][pIgnoreTD] = 0;
        return 0;
    }
    if (Dialog_Opened(playerid))
        return 0;

    if (clickedid == Text:INVALID_TEXT_DRAW)
    {
        if (PlayerInfo[playerid][pDealershipMenu] != -1)
        {
            HideDealershipPreview(playerid);
        }
    }
    if(clickedid == td_mdc_Exit) {
        mdc_Hide(playerid, true);
    } else if(clickedid == td_mdc_SectionText[0]) {
        Dialog_Show(playerid, SearchCitizem, DIALOG_STYLE_INPUT, "{3D62A8}Search Citizen", "Please enter the citizen's full name below:", "Search", "Cancel");
    }
    else if(clickedid == td_mdc_SectionText[1])
    {
        new str[2000], coordsstring[286];
        format(coordsstring, sizeof(coordsstring), "_____________ Wanted Lists _______________\n");
        strcat(str, coordsstring);
        foreach(new i : Player)
        {
            if(PlayerInfo[i][pWantedLevel] > 0)
            {
                format(coordsstring, sizeof(coordsstring), "(ID: %i) %s - Wanted Level: %i", i, GetRPName(i), PlayerInfo[i][pWantedLevel]);
                strcat(str, coordsstring);
            }
        }
        Dialog_Show(playerid, 0, DIALOG_STYLE_MSGBOX, "Wanted Lists", str, "Close", "");
    }
    else if(clickedid == td_mdc_SectionText[2])
    {
        Dialog_Show(playerid, SearchPhoneNumber, DIALOG_STYLE_INPUT, "{3D62A8}Search Phone Number", "Please enter the phone number below:", "Search", "Cancel");
    } else if(clickedid == td_mdc_SectionText[3]) {
        ShowPlayerDialog(playerid, DIALOG_VEHICLELOOKUP1, DIALOG_STYLE_INPUT, "Vehicle lookup", "Enter the ID of the vehicle to lookup.\n(( You can find out the ID of a vehicle by using /dl. ))", "Submit", "Cancel");
    } else if(clickedid == td_mdc_CriminalRecord || clickedid == td_mdc_CriminalRecordArrow) {
        new name[MAX_PLAYER_NAME];
        GetPVarString(playerid, "mdc_Citizen", name, sizeof(name));
        mdc_ShowCriminalRecord(playerid, name);
    } else if(clickedid == td_mdc_Cases || clickedid == td_mdc_CasesArrow) {
        Dialog_Show(playerid, 0, DIALOG_STYLE_MSGBOX, "{3D62A8}Case Files", "{ffffff}The Los Santos Police Department's Mobile Data Computer is presently under \ndevelopment. We ask for your patience and understanding.\n\nSincerely,\n{a9c4e4}LSPD Tech. Department", "Close", "");
    } else if(clickedid == td_mdc_Properties || clickedid == td_mdc_PropertiesArrow) {
        Dialog_Show(playerid, 0, DIALOG_STYLE_MSGBOX, "{3D62A8}Property Data", "{ffffff}The Los Santos Police Department's Mobile Data Computer is presently under \ndevelopment. We ask for your patience and understanding.\n\nSincerely,\n{a9c4e4}LSPD Tech. Department", "Close", "");
    } else if(clickedid == td_mdc_Vehicles || clickedid == td_mdc_VehiclesArrow) {
        new name[MAX_PLAYER_NAME];
        GetPVarString(playerid, "mdc_Citizen", name, sizeof(name));
        mdc_ShowVehicles(playerid, name);
    } else if(clickedid == td_mdc_cr_ArrowUp) {
        new ScrollTop = GetPVarInt(playerid, "mdc_cr_ScrollTop");
        if(ScrollTop > 0) {
            ScrollTop -= 1;
            SetPVarInt(playerid, "mdc_cr_ScrollTop", ScrollTop);
            for(new i = 0; i < sizeof(td_mdc_cr_Info); i++) {
                PlayerTextDrawHide(playerid, td_mdc_cr_Type[i]);
                PlayerTextDrawHide(playerid, td_mdc_cr_Description[i]);
                PlayerTextDrawHide(playerid, td_mdc_cr_Date[i]);
                if(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_type] == RECORD_CHARGE) {
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Type[i], "Charge");
                    if(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_served] == 0) {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_RED);
                    } else {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_WHITE);
                    }
                } else {
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Type[i], "Ticket");
                    if(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_paid] == 0) {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_RED);
                    } else {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_WHITE);
                    }
                }

                PlayerTextDrawSetString(playerid, td_mdc_cr_Date[i], CriminalRecordData[playerid][i + ScrollTop][mdc_cr_date]);
                if(strlen(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_description]) < 20) {
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Description[i], CriminalRecordData[playerid][i + ScrollTop][mdc_cr_description]);
                } else {
                    new desc[25];
                    strmid(desc, CriminalRecordData[playerid][i + ScrollTop][mdc_cr_description], 0, 20, 200);
                    strins(desc, "...", strlen(desc), sizeof(desc));
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Description[i], desc);
                }

                PlayerTextDrawShow(playerid, td_mdc_cr_Type[i]);
                PlayerTextDrawShow(playerid, td_mdc_cr_Description[i]);
                PlayerTextDrawShow(playerid, td_mdc_cr_Date[i]);
            }
        }
    } else if(clickedid == td_mdc_cr_ArrowDown) {
        new ScrollTop = GetPVarInt(playerid, "mdc_cr_ScrollTop");
        if(Iter_Count(RecordIterator[playerid]) > ScrollTop + 7) {
            ScrollTop += 1;
            SetPVarInt(playerid, "mdc_cr_ScrollTop", ScrollTop);
            for(new i = 0; i < sizeof(td_mdc_cr_Info); i++) {
                PlayerTextDrawHide(playerid, td_mdc_cr_Type[i]);
                PlayerTextDrawHide(playerid, td_mdc_cr_Description[i]);
                PlayerTextDrawHide(playerid, td_mdc_cr_Date[i]);
                if(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_type] == RECORD_CHARGE) {
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Type[i], "Charge");
                    if(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_served] == 0) {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_RED);
                    } else {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_WHITE);
                    }
                } else {
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Type[i], "Ticket");
                    if(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_paid] == 0) {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_RED);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_RED);
                    } else {
                        PlayerTextDrawColor(playerid, td_mdc_cr_Type[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Description[i], COLOR_WHITE);
                        PlayerTextDrawColor(playerid, td_mdc_cr_Date[i], COLOR_WHITE);
                    }
                }

                PlayerTextDrawSetString(playerid, td_mdc_cr_Date[i], CriminalRecordData[playerid][i + ScrollTop][mdc_cr_date]);
                if(strlen(CriminalRecordData[playerid][i + ScrollTop][mdc_cr_description]) < 20) {
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Description[i], CriminalRecordData[playerid][i + ScrollTop][mdc_cr_description]);
                } else {
                    new desc[25];
                    strmid(desc, CriminalRecordData[playerid][i + ScrollTop][mdc_cr_description], 0, 20, 200);
                    strins(desc, "...", strlen(desc), sizeof(desc));
                    PlayerTextDrawSetString(playerid, td_mdc_cr_Description[i], desc);
                }

                PlayerTextDrawShow(playerid, td_mdc_cr_Type[i]);
                PlayerTextDrawShow(playerid, td_mdc_cr_Description[i]);
                PlayerTextDrawShow(playerid, td_mdc_cr_Date[i]);
            }
        }
    } else if(clickedid == td_mdc_cr_Info[0]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop"));
    } else if(clickedid == td_mdc_cr_Info[1]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop") + 1);
    } else if(clickedid == td_mdc_cr_Info[2]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop") + 2);
    } else if(clickedid == td_mdc_cr_Info[3]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop") + 3);
    } else if(clickedid == td_mdc_cr_Info[4]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop") + 4);
    } else if(clickedid == td_mdc_cr_Info[5]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop") + 5);
    } else if(clickedid == td_mdc_cr_Info[6]) {
        mdc_ShowCriminalRecordDetails(playerid, GetPVarInt(playerid, "mdc_cr_ScrollTop") + 6);
    } else if(clickedid == td_mdc_veh_ArrowRight || clickedid == td_mdc_veh_Next) {
        new name[MAX_PLAYER_NAME];
        GetPVarString(playerid, "mdc_Citizen", name, sizeof(name));
        SetPVarInt(playerid, "mdc_VehicleIndex", GetPVarInt(playerid, "mdc_VehicleIndex") + 1);
        mdc_ShowVehicles(playerid, name);
    }
    return 0;
}

stock ShowPlayerFooter(playerid, string[], time = 5000) {
    if (PlayerInfo[playerid][pShowFooter]) {
        PlayerTextDrawHide(playerid, playerfooter[playerid]);
        KillTimer(PlayerInfo[playerid][pFooterTimer]);
    }
    PlayerTextDrawSetString(playerid, playerfooter[playerid], string);
    PlayerTextDrawShow(playerid, playerfooter[playerid]);

    PlayerInfo[playerid][pShowFooter] = true;
    PlayerInfo[playerid][pFooterTimer] = SetTimerEx("HidePlayerFooter", time, false, "d", playerid);
    return 1;
}
forward HidePlayerFooter(playerid);
public HidePlayerFooter(playerid) {

    if (!PlayerInfo[playerid][pShowFooter])
        return 0;

    PlayerInfo[playerid][pShowFooter] = false;
    return PlayerTextDrawHide(playerid, playerfooter[playerid]);
}

