            case JOB_FISHERMAN: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /fish, /myfish, /sellfish.");
            case JOB_ARMSDEALER: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /getmats, /sellgun.");
            case JOB_MINER: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /mine.");
            case JOB_TAXIDRIVER: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /setfare.");
            case JOB_DRUGDEALER: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /getdrug, /planthelp.");
            case JOB_GARBAGEMAN: SendClientMessage(playerid, COLOR_GREY, "[JOB COMMANDS] /garbage");
            case JOB_FARMER: SendClientMessage(playerid, COLOR_GREY, "[JOB COMMANDS] /(un)hooktrailer, /planting, /resetfarm, /farmhelp.");
            case JOB_LUMBERJACK: SCM(playerid, COLOR_GREY, "[JOB COMMANDS] /chop");
            case JOB_FOODPANDA: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /getorder, /putorder, /graborder, /cancelcp.");
            case JOB_HARVESTER: SCM(playerid, COLOR_WHITE, "** Press N to harvest a plant in the field.");
            case JOB_BRINKS: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /loadcar.");
            case JOB_SWEEPER: SendClientMessage(playerid, COLOR_GREY, "* JOB * /startsweeping, /stopsweeping.");
            case JOB_BUTCHER: SCM(playerid, COLOR_WHITE, "** Job: /meat, /cancelcp.");
        }
    }

    return 1;
}

