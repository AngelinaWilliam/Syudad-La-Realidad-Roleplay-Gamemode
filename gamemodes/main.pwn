GivePlayerMaterials(playerid, amount)
{
    if(PlayerInfo[playerid][pLogged])
    {
        PlayerInfo[playerid][pMaterials] = PlayerInfo[playerid][pMaterials] + amount;

        if(!PlayerInfo[playerid][pAdminDuty])
        {
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET materials = materials + %i WHERE uid = %i", amount, PlayerInfo[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
        }
    }
}


