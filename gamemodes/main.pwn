            if(GetPVarInt(playerid, #loot_8)) {
                format(item, 90, "Seed (%d)", PlayerInfo[looting][pSeeds]);
                
                if(!response) {
                    SetPVarInt(looting, "looted", false); 
                    DeletePVar(playerid, "looting");
                    DeletePVar(playerid, #loot_8);
                    ClearAnimations(playerid, 1);
                    return 1;
                }
                if(!strval(inputtext)) return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close");
                for(new i = strlen(inputtext) - 1; i != -1; i --) {
                switch(inputtext[i]) {
                        case '0'..'9': continue;
                        default: return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close");
                    }
                }
                if(strval(inputtext) < 1 || strval(inputtext) > PlayerInfo[looting][pSeeds])
                {
                    SCM(playerid, COLOR_SYNTAX, "Invalid amount entered.");
                    return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Error:Invalid amount entered\nEnter an amount you want to get from this item", "Enter", "Close");
                }
                if(PlayerInfo[looting][pSeeds] + strval(inputtext) > GetPlayerCapacity(CAPACITY_SEEDS))
                {
                    SCM(playerid, COLOR_SYNTAX, "you can't carry that much more seeds.");
                    return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Error:Invalid amount entered\nEnter an amount you want to get from this item", "Enter", "Close");
                }

                ClearAnimations(playerid, 1);
                SetPVarInt(looting, "looted", false);
                DeletePVar(playerid, "looting");
                DeletePVar(playerid, #loot_8);
                
                new looted = strval(inputtext);
                
                PlayerInfo[looting][pSeeds] -= looted;
                PlayerInfo[playerid][pSeeds] += looted;
                
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET seeds = %i WHERE uid = %i", PlayerInfo[looting][pSeeds], PlayerInfo[looting][pID]);
                mysql_tquery(connectionID, queryBuffer);
        
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET seeds = %i WHERE uid = %i", PlayerInfo[playerid][pSeeds], PlayerInfo[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);
                
                SM(playerid, 0xF7A763FF, "You have looted %i seeds from %s.", looted, GetRPName(looting));
                SM(looting, 0xF7A763FF, "Your %i seeds has been looted by %s.", looted, GetRPName(playerid));
                return 1;
            }
            if(!response) {
                PlayerInfo[playerid][pLooting] = INVALID_PLAYER_ID;
                PlayerInfo[looting][pLooted] = INVALID_PLAYER_ID;
                SetPVarInt(looting, "looted", false); 
                DeletePVar(playerid, "looting");
                ClearAnimations(playerid, 1);
                return 1;
            }
            if(PlayerInfo[playerid][pLooting] == INVALID_PLAYER_ID)
            {
                SendClientMessage(playerid, COLOR_SYNTAX, "ERROR: The player you're looting has been disconnected.");
                SetPVarInt(looting, "looted", false); 
                DeletePVar(playerid, "looting");
                ClearAnimations(playerid, 1);
                return 1;
            }
            new ctr[80];
            format(ctr,80,"{999999}(( looting %s ))",GetRPName(looting));
            SetPlayerChatBubble(playerid,ctr,-1,10.0,1600);
            
            switch(listitem)
            {
                case 0: {
                    format(item, 90, "Bandage (%d)", PlayerInfo[looting][pFirstAid]);
                    ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close"), SetPVarInt(playerid, #loot_1, true);
                }
                case 1: {
                    format(item, 90, "Painkillers (%d)", PlayerInfo[looting][pPainkillers]);
                    ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close"), SetPVarInt(playerid, #loot_2, true);
                }
                case 2: {
                    format(item, 90, "Pot (%d)", PlayerInfo[looting][pPot]);
                    ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close"), SetPVarInt(playerid, #loot_3, true);
                }
                case 3: {
                    format(item, 90, "Crack (%d)", PlayerInfo[looting][pCrack]);
                    ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close"), SetPVarInt(playerid, #loot_4, true);
                }
                case 4: {
                    format(item, 90, "Meth (%d)", PlayerInfo[looting][pMeth]);
                    ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close"), SetPVarInt(playerid, #loot_5, true);
                }
