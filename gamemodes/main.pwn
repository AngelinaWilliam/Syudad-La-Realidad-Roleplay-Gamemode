                    ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close"), SetPVarInt(playerid, #loot_8, true);
                }
            }
