forward OnPlayerEquipVest(playerid);
public OnPlayerEquipVest(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        SetScriptArmour(playerid, 100);
        TogglePlayerControllable(playerid, 1);
        GameTextForPlayer(playerid, "~g~equipped", 2000, 1);
    }

    PlayerInfo[playerid][pEquipVest] = false;
    KillTimer(PlayerInfo[playerid][pEquipTimer]);
    PlayerInfo[playerid][pEquipTimer] = -1;
    return 1;
}

CMD:use(playerid, params[])
{
    if(PlayerInfo[playerid][pTazedTime] > 0 || PlayerInfo[playerid][pInjured] > 0 || PlayerInfo[playerid][pHospital] > 0 || PlayerInfo[playerid][pCuffed] > 0 || PlayerInfo[playerid][pTied] > 0 || PlayerInfo[playerid][pJailTime] > 0)
    {
        return SCM(playerid, COLOR_SYNTAX, "You can't use this command at the moment.");
    }
    if(PlayerInfo[playerid][pJoinedEvent] > 0 && !EventInfo[eHeal])
    {
        return SCM(playerid, COLOR_SYNTAX, "The administrator has chosen to disable healing in this event.");
    }
    if(isnull(params))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /use [ Cigar | Medkit | Vest | Voucher ]");
    }
    if(!strcmp(params, "voucher", true))
    {
        ShowDialogToPlayer(playerid, DIALOG_CHOOSEVOUCHER);
    }

    else if(!strcmp(params, "vest", true))
    {
        if (!PlayerHasItem(playerid, "Vest"))
            return SendErrorMessage(playerid, "You don't have a Vest on you.");

        if(PlayerInfo[playerid][pEquipVest] == true)
            return SendClientMessageEx(playerid, COLOR_GREY, "You are already equipping a vest.");

        new string[128];
        Inventory_Remove(playerid, "Vest");

        format(string, sizeof(string), "* %s has takes off their vest, dropping it on the ground.", GetPlayerNameEx(playerid));
        SendProximityMessage(playerid, 20.0, COLOR_ORANGE, string);
        format(string, sizeof(string), "* %s picks up the vest equipping it to themselves.", GetPlayerNameEx(playerid));
        SendProximityMessage(playerid, 20.0, COLOR_ORANGE, string);

        SendClientMessageEx(playerid, COLOR_ORANGE, " Equipping your kevalar vest, This will take 20 seconds. Keep cover! ");

        PlayerInfo[playerid][pEquipVest] = true;
        PlayerInfo[playerid][pEquipTimer] = SetTimerEx("OnPlayerEquipVest", 20000, 0, "d", playerid);

        GameTextForPlayer(playerid, "~g~Wearing Vest ~n~ ~r~20 seconds", 20000, 1);
        TogglePlayerControllable(playerid, 0);
    }
    else if(!strcmp(params, "medkit", true))
    {
        if (!PlayerHasItem(playerid, "Medkit"))
            return SendErrorMessage(playerid, "You don't have a medkit kit on you.");
        if(PlayerInfo[playerid][pEquipVest] == true)
        {
            return SCM(playerid, COLOR_LIGHTRED, "You're currentlry applying medkit.");
        }
        ApplyAnimationEx(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);

        Inventory_Remove(playerid, "Medkit");
        GameTextForPlayer(playerid, "~g~Applying Medkit...", 15000, 3);
        TogglePlayerControllable(playerid, 0);
        SetTimerEx("UseMedkit", 15000, false, "i", playerid);
        SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s begins bandaging their self", GetRPName(playerid));
    }
    else if(!strcmp(params, "cigar", true))
    {
        if (!PlayerHasItem(playerid, "Cigar"))
            return SendErrorMessage(playerid, "You don't have a Cigar on you.");

        Inventory_Remove(playerid, "Cigar");

        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_SMOKE_CIGGY);
        SendProximityMessage(playerid, 20.0, COLOR_GREY, "**{C2A2DA} %s lights up a cigar and starts to smoke it.", GetRPName(playerid));
    }
    return 1;
}

//Taljzed kyutie
// item are based on gm system only
CMD:lootplayer(playerid, params[])
{
	if(GetPVarInt(playerid, "looted") && GetPlayerState(playerid) != PLAYER_STATE_ONFOOT || GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_CUFFED || PlayerInfo[playerid][pInjured] > 0 || PlayerInfo[playerid][pHospital] > 0 || PlayerInfo[playerid][pTied] > 0 || PlayerInfo[playerid][pMiningTime] > 0 || PlayerInfo[playerid][pTazedTime] > 0 || PlayerInfo[playerid][pCuffed] > 0)
	{
		return SCM(playerid, COLOR_SYNTAX, "You can't do this at the moment");
	}
	new Float:pHp; GetPlayerHealth(playerid, pHp);
	if(sscanf(params, "d", params[0])) return SCM(playerid, COLOR_SYNTAX, "Usage: /lootplayer [playerid]");
	if(pHp <= 20.0) return SCM(playerid, COLOR_SYNTAX, "Your health is too low to do this");
	if(!IsPlayerInRangeOfPlayer(playerid, params[0], 3.0)) return SCM(playerid, COLOR_SYNTAX, "That player is out of range.");
	if(PlayerInfo[params[0]][pAdminDuty]) return 1;
	if(!PlayerInfo[params[0]][pInjured]) return SCM(playerid, COLOR_SYNTAX, "The player can not be looted");
	if(GetPVarInt(params[0], "looted")) return SCM(playerid, COLOR_SYNTAX, "The player is currently looting by somebody else");
	
	new p_items[90], player_items[900];
	format(p_items, 90, "%s's Items", GetRPName(params[0]));
	format(player_items, 900, "Bandage\t(%d)\n\
	Painkillers\t(%d)\nPot\t(%d)\nCrack\t(%d)\nMeth\t(%d)\nMaterials\t(%d)\n\
	Ephedrine\t(%d)\nSeeds\t(%d)", PlayerInfo[params[0]][pFirstAid], PlayerInfo[params[0]][pPainkillers],
	PlayerInfo[params[0]][pPot], PlayerInfo[params[0]][pCrack], PlayerInfo[params[0]][pMeth],
	PlayerInfo[params[0]][pMaterials], PlayerInfo[params[0]][pEphedrine],  PlayerInfo[params[0]][pSeeds]);
	SetPVarInt(params[0], "looted", true);
	SetPVarInt(playerid, "looting", params[0]);
	
	PlayerInfo[playerid][pLooting] = params[0];
	PlayerInfo[params[0]][pLooted] = playerid;

	ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.1, 1, 0, 0, 0, 0, 1);
	return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_LIST, p_items, player_items, "Get", "Close");
}

