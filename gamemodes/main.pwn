        case JOB_PIZZAMAN: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /getpizza, /cancelcp.");
        case JOB_COURIER: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /loadtruck, /deliver, /cancelcp.");
        case JOB_FISHERMAN: SCM(playerid, COLOR_WHITE, "[JOB COMMANDS] /fish, /myfish, /sellfish.");
