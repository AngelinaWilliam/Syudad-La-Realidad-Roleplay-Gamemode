Store:StreetFood(playerid, response, itemid, modelid, price, amount, itemname[])
{
    if(!response) return 1;
    if(PlayerInfo[playerid][pCash] < price)
    return SCMf(playerid, COLOR_ERROR, "[ERROR]{ffffff} You need %s to purchase the selected item(s).", FormatNumber(price));

    switch(itemid)
    {
        case 1:
        {
            if (PlayerInfo[playerid][pVendorTime] > 0)
                return SCM(playerid, COLOR_GREY, "Please wait before purchasing from a vendor again.");

            if (PlayerInfo[playerid][pHunger] >= 90)
                return SM(playerid, COLOR_GREY, "You aren't hungry!");

            PlayerInfo[playerid][pVendorTime] = 3;

            ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);

            PlayerInfo[playerid][pHunger] += 10;
            PlayerInfo[playerid][pHungerTimer] = 0;

            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET hunger = %i, hungertimer = %i WHERE uid = %i", PlayerInfo[playerid][pHunger], PlayerInfo[playerid][pHungerTimer], PlayerInfo[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);

            SendNearbyMessage(playerid, 30.0, COLOR_PURPLE, "* %s has purchased from the vendor.", GetPlayerNameEx(playerid));

            ShowPlayerFooter(playerid, "You have purchased ~p~food~w~");
        }
        case 2:
        {
            if (PlayerInfo[playerid][pVendorTime] > 0)
                return SCM(playerid, COLOR_GREY, "Please wait before purchasing from a vendor again.");

