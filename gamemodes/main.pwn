        SetPlayerFacingAngle(playerid, -91.2600);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetCameraBehindPlayer(playerid);
    }
    if(pickupid == cityhallint)
    {
        SetFreezePos(playerid, 1481.1770, -1768.6028, 18.5896);

        SetPlayerFacingAngle(playerid, 0.0000);
        SetPlayerInterior(playerid, 0);
        SetPlayerVirtualWorld(playerid, 0);
        SetCameraBehindPlayer(playerid);
    }
    if(pickupid == casinoext)
    {
        SetFreezePos(playerid, 2017.4554, 1017.9619, 997.5040);

        SetPlayerFacingAngle(playerid, 89.2800);
        SetPlayerInterior(playerid, 10);
        SetPlayerVirtualWorld(playerid, 0);
        SetCameraBehindPlayer(playerid);
    }
    if(pickupid == casinoint)
    {
        SetFreezePos(playerid, 1022.3374, -1123.3419, 24.5796);

