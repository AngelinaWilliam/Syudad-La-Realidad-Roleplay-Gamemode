CMD:full(playerid, params[])
{
    static
        userid;

    if (PlayerInfo[playerid][pAdmin] < 2)
        return SendErrorMessage(playerid, "You don't have permission to use this command.");

    if (sscanf(params, "u", userid))
        return SendSyntaxMessage(playerid, "/full [playerid/name]");

    if (userid == INVALID_PLAYER_ID)
        return SendErrorMessage(playerid, "You have specified an invalid player.");


    PlayerInfo[userid][pHunger] = 100;
    PlayerInfo[userid][pHungerTimer] = 0;


    PlayerInfo[userid][pThirst] = 100;
    PlayerInfo[userid][pThirstTimer] = 0;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET hunger = %i, hungertimer = %i, thirst = %i, thirsttimer = %i WHERE uid = %i", PlayerInfo[playerid][pHunger], PlayerInfo[playerid][pHungerTimer], PlayerInfo[playerid][pThirst], PlayerInfo[playerid][pThirstTimer], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);
    SCMf(playerid, COLOR_LIGHTRED, "You have refilled %s's hunger and thirst.", GetRPName(userid));
    SCMf(userid, COLOR_LIGHTRED, "Your hunger and thirst was refilled by %s.", GetRPName(playerid));
    return 1;
}
