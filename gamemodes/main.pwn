    new
        modelid4 = GetVehicleModel(vehicleid);

    if(400 <= modelid4 <= 611)
    {
        return vehicleEngines[modelid4 - 400];
    }
    new value = CoreVehicleData[modelid4-400][vdata_fueltype];
    if(value == FUEL_NONE) return false;
    return 0;
