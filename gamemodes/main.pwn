DisplayStats(playerid, targetid = INVALID_PLAYER_ID)
{
    if(targetid == INVALID_PLAYER_ID) targetid = playerid;

    new name[24];
    GetPlayerName(targetid, name, sizeof(name));

    new string[3000];
    new gender[16], faction[48], facrank[32], gang[32], gangrank[32], job[32], secondjob[32], jailtype[32];

    // Gender
    switch(PlayerInfo[targetid][pGender])
    {
        case 1: gender = "Male";
        case 2: gender = "Female";
        case 3: gender = "Shemale";
        default: gender = "N/A";
    }

    // Faction
    if(PlayerInfo[targetid][pFaction] >= 0) {
        format(faction, sizeof(faction), "%s", FactionInfo[PlayerInfo[targetid][pFaction]][fName]);
        format(facrank, sizeof(facrank), "%s (%i)",
            FactionRanks[PlayerInfo[targetid][pFaction]][PlayerInfo[targetid][pFactionRank]],
            PlayerInfo[targetid][pFactionRank]);
    } else {
        faction = "None";
        facrank = "N/A (0)";
    }

    // Gang
    if(PlayerInfo[targetid][pGang] >= 0) {
        format(gang, sizeof(gang), "%s", GangInfo[PlayerInfo[targetid][pGang]][gName]);
        format(gangrank, sizeof(gangrank), "%s (%i)",
            GangRanks[PlayerInfo[targetid][pGang]][PlayerInfo[targetid][pGangRank]],
            PlayerInfo[targetid][pGangRank]);
    } else {
        gang = "None";
        gangrank = "N/A (0)";
    }

    // Jobs
    if(PlayerInfo[targetid][pJob] != JOB_NONE)
        format(job, sizeof(job), "%s (%i)", GetJobName(PlayerInfo[targetid][pJob]), GetJobLevel(targetid, PlayerInfo[targetid][pJob]));
    else job = "None";

    if(PlayerInfo[targetid][pSecondJob] != JOB_NONE)
        format(secondjob, sizeof(secondjob), "%s (%i)", GetJobName(PlayerInfo[targetid][pSecondJob]), GetJobLevel(targetid, PlayerInfo[targetid][pSecondJob]));
    else secondjob = "None";

    // Jail Type
    switch(PlayerInfo[targetid][pJailType])
    {
        case 0: jailtype = "None";
        case 1: jailtype = "OOC Jail";
        case 2: jailtype = "OOC Prison";
        case 3: jailtype = "IC Prison";
        default: jailtype = "N/A";
    }

    // ------------------------
    // Assemble dialog string
    // ------------------------
    format(string, sizeof(string),
    "{0000FF}Name:{FFFFFF} %s\n\
    {0000FF}Gender:{FFFFFF} %s\n\
    {0000FF}Level:{FFFFFF} %d | Hours: %d\n\
    {0000FF}Faction:{FFFFFF} %s | Rank: %s\n\
    {FF0000}Gang:{FFFFFF} %s | Rank: %s\n\
    {00AA00}Job:{FFFFFF} %s\n\
    {00AA00}Second Job:{FFFFFF} %s\n\
    {FFD200}Cash:{FFFFFF} $%s | Bank: $%s\n\
    {FF0000}Crimes:{FFFFFF} %d | Arrested: %d\n\
    {FF9900}Wanted Level:{FFFFFF} %d\n\
    {FF6600}Jail Type:{FFFFFF} %s | Jail Time: %d sec\n\
    {00AAAA}Paintball Kills:{FFFFFF} %d | Deaths: %d\n",
        name,
        gender,
        PlayerInfo[targetid][pLevel], PlayerInfo[targetid][pHours],
        faction, facrank,
        gang, gangrank,
        job, secondjob,
        FormatNumber(PlayerInfo[targetid][pCash]), FormatNumber(PlayerInfo[targetid][pBank]),
        PlayerInfo[targetid][pCrimes], PlayerInfo[targetid][pArrested],
        PlayerInfo[targetid][pWantedLevel],
        jailtype, PlayerInfo[targetid][pJailTime],
        PlayerInfo[targetid][pPaintballKills], PlayerInfo[targetid][pPaintballDeaths]
    );

    ShowPlayerDialog(playerid, DIALOG_STATS, DIALOG_STYLE_MSGBOX, "{FF00FF}Player Information:{FFFFFF}", string, "Close", "");
    return 1;
}
DisplayInventory(playerid, targetid = INVALID_PLAYER_ID)
