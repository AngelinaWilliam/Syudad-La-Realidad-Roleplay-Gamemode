CMD:givevoucherall(playerid, params[])
{
    new option[10], param[32];
    if(PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_LIGHTRED, "You're not authorized to use this command");
    }
    if(sscanf(params, "s[24]S()[32]", option, param))
    {
        return SCM(playerid, COLOR_LIGHTBLUE, "[USAGE]{ffffff} Silver, Diamond, Platinum");
    }
    if(!strcmp(option, "silver", true))
    {
        foreach(new i : Player)
        {
            if(PlayerInfo[i][pLogged])
            {
                PlayerInfo[i][pSilverVoucher] ++;
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET silvervoucher = %i WHERE uid = %i", PlayerInfo[i][pSilverVoucher], PlayerInfo[i][pID]);
                mysql_tquery(connectionID, queryBuffer);
            }
        }

        SMA(COLOR_YELLOW, "[Give-Away] %s has gave %i silver voucher for everyone", GetRPName(playerid));
        SMA(COLOR_YELLOW, "[Hint] /use voucher to use");
    }
    else if(!strcmp(option, "diamond", true))
    {
        foreach(new i : Player)
        {
            if(PlayerInfo[i][pLogged])
            {
                PlayerInfo[i][pDiamondVoucher] ++;
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET diamondvoucher = %i WHERE uid = %i", PlayerInfo[i][pDiamondVoucher], PlayerInfo[i][pID]);
                mysql_tquery(connectionID, queryBuffer);
            }
        }

        SMA(COLOR_YELLOW, "[Give-Away] %s has gave %i diamond voucher for everyone", GetRPName(playerid));
        SMA(COLOR_YELLOW, "[Hint] /use voucher to use");
    }
    else if(!strcmp(option, "platinum", true))
    {
        foreach(new i : Player)
        {
            if(PlayerInfo[i][pLogged])
            {
                PlayerInfo[i][pPlatinumVoucher] ++;
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET platinumvoucher = %i WHERE uid = %i", PlayerInfo[i][pPlatinumVoucher], PlayerInfo[i][pID]);
                mysql_tquery(connectionID, queryBuffer);
            }
        }

        SMA(COLOR_YELLOW, "[Give-Away] %s has gave %i platinum voucher for everyone", GetRPName(playerid));
        SMA(COLOR_YELLOW, "[Hint] /use voucher to use");
    }
    return 1;
}

CMD:givevoucher(playerid, params[])
{
    new option[10], param[32], amount, targetid;
    if(PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_LIGHTRED, "You're not authorized to use this command");
    }
    if(sscanf(params, "is[24]S()[32]", targetid, option, param))
    {
        return SCM(playerid, COLOR_LIGHTBLUE, "[USAGE]{ffffff} [playerid] [Option: Silver, Diamond, Platinum]");
    }
    if(!strcmp(option, "silver", true))
    {
        if(sscanf(param, "ii", targetid, amount))
        {
            SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /givevoucher [silver] [targetid] [amount]");
            return 1;
        }

        PlayerInfo[targetid][pSilverVoucher] = amount;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET silvervoucher = %i WHERE uid = %i", PlayerInfo[targetid][pSilverVoucher], PlayerInfo[targetid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        SAM(COLOR_LIGHTRED, "[Voucher] %s has given %s %i silver voucher(s)", GetRPName(playerid), GetRPName(targetid), amount);
        SCMf(playerid, COLOR_YELLOW, "[Voucher] %s has gave you %d silver voucher(s)", GetRPName(playerid));
    }
    else if(!strcmp(option, "diamond", true))
    {
        if(sscanf(param, "ii", targetid, amount))
        {
            SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /givevoucher [diamond] [targetid] [amount]");
            return 1;
        }

        PlayerInfo[targetid][pDiamondVoucher] = amount;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET diamondvoucher = %i WHERE uid = %i", PlayerInfo[targetid][pDiamondVoucher], PlayerInfo[targetid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        SAM(COLOR_LIGHTRED, "[Voucher] %s has given %s %i diamond voucher(s)", GetRPName(playerid), GetRPName(targetid), amount);
        SCMf(playerid, COLOR_YELLOW, "[Voucher] %s has gave you %d diamond voucher(s)", GetRPName(playerid));
    }
    else if(!strcmp(option, "platinum", true))
    {
        if(sscanf(param, "ii", targetid, amount))
        {
            SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /givevoucher [platinum] [targetid] [amount]");
            return 1;
        }

        PlayerInfo[targetid][pPlatinumVoucher] = amount;
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET platinumvoucher = %i WHERE uid = %i", PlayerInfo[targetid][pPlatinumVoucher], PlayerInfo[targetid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        SAM(COLOR_LIGHTRED, "[Voucher] %s has given %s %i platinum voucher(s)", GetRPName(playerid), GetRPName(targetid), amount);
        SCMf(playerid, COLOR_YELLOW, "[Voucher] %s has gave you %d platinum voucher(s)", GetRPName(playerid));
    }
    return 1;
}

/*
CMD:exchangetiki(playerid, params[])
{
    ShowDialogToPlayer(playerid, DIALOG_TIKISTORE);
    return 1;
}
*/
GivePlayerTiki(playerid, amount)
{
    if(PlayerInfo[playerid][pLogged])
    {
        PlayerInfo[playerid][pTiki] = PlayerInfo[playerid][pTiki] + amount;

        if(!PlayerInfo[playerid][pAdminDuty])
        {
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET tikis = tikis + %i WHERE uid = %i", amount, PlayerInfo[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
        }
    }
}

CMD:givetiki(playerid, params[])
{
    new targetid, amount;

    if(PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(!PlayerInfo[playerid][pAdminDuty] && PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_ERROR, "[ERROR]{ffffff} This command requires you to be on admin duty. /aduty to go on duty.");
    }
    if(sscanf(params, "ui", targetid, amount))
    {
        return SCM(playerid, COLOR_LIGHTBLUE, "[USAGE]{ffffff} /givetiki [playerid] [amount]");
    }
    if(!IsPlayerConnected(targetid))
    {
        return SCM(playerid, COLOR_ERROR, "[ERROR]{ffffff} The player specified is disconnected.");
    }
    if(!PlayerInfo[targetid][pLogged])
    {
        return SCM(playerid, COLOR_ERROR, "[ERROR]{ffffff} That player hasn't logged in yet.");
    }
    GivePlayerTiki(targetid, amount);
    SAM(COLOR_WHITE, "AdmCmd: %s has given %i tiki(s) to %s.", GetRPName(playerid), amount, GetRPName(targetid));
    return 1;
}

CMD:givetikiall(playerid, params[])
{
    new amount;

    if(PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "i", amount))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /givetikill [amount]");
    }
    if(amount < 1 || amount > 5)
    {
        return SCM(playerid, COLOR_SYNTAX, "The amount specified must range between 1 and 5.");
    }

    foreach(new i : Player)
    {
        if(PlayerInfo[i][pLogged])
        {
            GivePlayerTiki(i, amount);
        }
    }

    SMA(COLOR_WHITE, "AdmCmd: %s has given %i "TEAL"tiki"WHITE" to every player online.", GetRPName(playerid), amount);
    SMA(COLOR_WHITE, "[!] Tiki?! head to tiki shop to exchange it for unique in-game stuffs.");
    return 1;
}

CMD:placefirework(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] < 1)
    {
        return SCM(playerid, COLOR_LIGHTRED, "You're not authorized to use this command!");
    }
    if(RocketExplosions[playerid] != -1)
    {
        SendClientMessageEx(playerid, COLOR_WHITE, "You are already using another firework!");
        return 1;
    }
    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0)
    {
        SendClientMessageEx(playerid, COLOR_WHITE, "You can't launch fireworks indoors!");
        return 1;
    }

    SCMf(playerid, COLOR_GREEN, "* %s has placed a firework which will go off in 30 seconds!", GetPlayerNameEx(playerid));

    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    ApplyAnimation(playerid,"BOMBER","BOM_Plant_Crouch_In", 4.0, 0, 0, 0, 0, 0, 1);
    x += (2 * floatsin(-a, degrees));
    y += (2 * floatcos(-a, degrees));
    Rocket[playerid] = CreateDynamicObject(3786, x, y, z, 0, 90, 0);
    RocketLight[playerid] = CreateDynamicObject(354, x, y, z + 1, 0, 0, 0);
    RocketSmoke[playerid] = CreateDynamicObject(18716, x, y, z - 4, 0, 0, 0);
    SetPVarFloat(playerid,"fxpos",x);
    SetPVarFloat(playerid,"fypos",y);
    SetPVarFloat(playerid,"fzpos",z);
    RocketExplosions[playerid] = 0;
    SetTimerEx("Firework", 25000, 0, "ii", playerid, TYPE_COUNTDOWN);

    return 1;
}


CMD:allhunt(playerid, params[])
{
    new targetid;
    if(PlayerInfo[playerid][pAdmin] < 6)
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
    }
    if(sscanf(params, "u", targetid))
    {
        return SCM(playerid, COLOR_GREY, "USAGE:"WHITE" /allhunt [targetid]");
    }
    if(targetid == INVALID_PLAYER_ID)
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" Invalid player specified.");
    }
    if(PlayerInfo[targetid][pAdminDuty])
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" You can't use this command on an on-duty administrator.");
    }
    if(PlayerInfo[targetid][pHunted] == 1)
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" That player is currently being hunted.");
    }

    SavePlayerVariables(targetid);

    PlayerInfo[targetid][pHunted] = 1;
    SetPlayerColor(playerid, COLOR_HUNT);
    GameTextForPlayer(targetid, "~r~You are being hunted", 4000, 3);
    SMA(COLOR_HUNT, "[Hunt System] "WHITE"The hunt is on! Find and kill the hunted %s (pink blip on map) and earn yourself a prize.", GetRPName(targetid));
    SMA(SERVER_COLOR, "AdmCmd: %s has made %s hunted.", GetRPName(playerid), GetRPName(targetid));
    return 1;
}

