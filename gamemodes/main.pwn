    {
        format(string, sizeof(string), "Phone: %s.\n", (PlayerInfo[playerid][pPhone]) ? ("Yes") : ("No"));
        strcat(str, string);
    }

    if(count < 1) {
        strcat(str, "You have no items in your inventory.");
    }
    ShowPlayerDialog(targetid, 0, DIALOG_STYLE_MSGBOX, "Inventory", str, "Close", "");
}



ShowDialogToPlayer(playerid, dialogid)
{
    new string[2048];
    //new vehiclestring[4096];
    switch(dialogid)
    {
        case ACCOUNT_CREATION:
        {
            new genderstring[12];
            switch(PlayerInfo[playerid][pGender])
            {
                case 1: genderstring = "Male";
                case 2: genderstring = "Female";
                default: genderstring = "Unspecified";
            }
            format(string, sizeof(string), "Name\t%s\n\
                Gender\t%s\n\
                Age\t%d\n\
                Accent\t%s\n\
                Skin\t%d\n\
                Complete",
                GetPlayerNameEx(playerid),
                genderstring,
                PlayerInfo[playerid][pAge],
                PlayerInfo[playerid][pAccent],
                PlayerInfo[playerid][pSkin]);
            ShowPlayerDialog(playerid, ACCOUNT_CREATION, DIALOG_STYLE_TABLIST, "Account Registration", string, "Select", "");


        }


        case DIALOG_REGISTER:
        {
            format(string, sizeof(string), ""WHITE"Welcome to "SERVER_NAME"!\nYou can {AA3333}register "WHITE"an account by entering your desired password.\n\n"SVRCLR"Username: "WHITE"%s\n"SVRCLR"Password:", GetPlayerNameEx(playerid));
            ShowPlayerDialog(playerid,DIALOG_REGISTER,DIALOG_STYLE_PASSWORD,""SVRCLR"Registration",string,"Register","Exit");
        }
        case DIALOG_LOGIN:
        {
            format(string, sizeof(string), ""WHITE"Welcome back to "SERVER_NAME"!\nThis account is already registered, please login below.\n\nNEVER SHARE YOUR PASSWORD!\n\n"SVRCLR"Username: "WHITE"%s\n"SVRCLR"Password:", GetPlayerNameEx(playerid));
            ShowPlayerDialog(playerid,DIALOG_LOGIN,DIALOG_STYLE_PASSWORD,""SVRCLR"Logging-in",string,"Login","Exit");
        }
        case DIALOG_GENDER:
        {
            ShowPlayerDialog(playerid, DIALOG_GENDER, DIALOG_STYLE_LIST, ""SVRCLR"Gender", "Male\nFemale", "Select", "");
        }
        case DIALOG_AGE:
        {
            ShowPlayerDialog(playerid, DIALOG_AGE, DIALOG_STYLE_INPUT, ""SVRCLR"Age", ""WHITE"What age would you like your character to be (Between 13-99 yeas old):", "Submit", "Back");
        }
        case DIALOG_REFERRAL:
        {
