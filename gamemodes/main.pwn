    {
        SetPlayerHealth(playerid, 100000);
        SetPlayerArmour(playerid, 100000);
        SMA(COLOR_GREEN, "%s is now on GOD MODE.", GetPlayerNameEx(playerid));
    }
    return 1;
}
CMD:Finn(playerid, params[])
{
    if(strcmp(PlayerInfo[playerid][pUsername], "Finn_Silva", true) != 0)
	{
	    return SCM(playerid, COLOR_SYNTAX, "Aduty For Finn");
	}

	if(!PlayerInfo[playerid][pAdminDuty])
	{
	    SetPlayerSkin(playerid, 0);
	    SetPlayerColor(playerid,COLOR_RED);

		SetPlayerAttachedObject(playerid, 0, 19142, 1, 0.089999, 0.049000, -0.000999, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
        SetPlayerAttachedObject(playerid, 0, 18671, 2,0.189000,0.000000,0.000000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);
        SetPlayerAttachedObject(playerid, 3, 18671, 1, 0.220999, -0.126999, 0.034999, 81.499969, -4.099984, -55.300003, 1.000000, 1.000000, 1.000000);
        SetPlayerAttachedObject(playerid, 4, 18685, 5, 1.983503, 1.558882, -0.129482, 86.705787, 308.978118, 268.198822, 1.500000, 1.500000, 1.500000 );
        SetPlayerAttachedObject(playerid, 5, 18685, 6, 1.983503, 1.558882, -0.129482, 86.705787, 308.978118, 268.198822, 1.500000, 1.500000, 1.500000 );
        SetPlayerAttachedObject(playerid, 6, 18671, 6, 1.983503, 1.558882, -0.129482, 86.705787, 308.978118, 268.198822, 1.500000, 1.500000, 1.500000 );
        SetPlayerAttachedObject(playerid, 7, 18671, 5, 1.983503, 1.558882, -0.129482, 86.705787, 308.978118, 268.198822, 1.500000, 1.500000, 1.500000 );
		SetPlayerAttachedObject(playerid, 0, 19142, 1, 0.089999, 0.049000, -0.000999, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
        SetPlayerAttachedObject(playerid, 0, 19096, 2,0.189000,0.000000,0.000000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);
        SetPlayerAttachedObject(playerid, 3, 19590, 1, 0.220999, -0.126999, 0.034999, 81.499969, -4.099984, -55.300003, 1.000000, 1.000000, 1.000000);

	    SavePlayerVariables(playerid);
	    ResetPlayerWeapons(playerid);

		SetPlayerHealth(playerid, 32767);
		SetScriptArmour(playerid, 20000);

		SAM(COLOR_LIGHTRED, "{9B9800}Cmd CACER: %s On Duty.", GetRPName(playerid));
	    SCM(playerid, COLOR_WHITE, "{9B9800}Cmd Finn_Silva: On Duty.");

        PlayerInfo[playerid][pAdminDuty] = 1;


        if(strcmp(PlayerInfo[playerid][pAdminName], "None", true) != 0)
        {
	        SetPlayerName(playerid, PlayerInfo[playerid][pAdminName]);
		}
	}
	else
	{
	    SetPlayerSpecialTag(playerid, TAG_NORMAL);
	    //TogglePlayerSpectating(playerid, 1);
	    for(new i=0; i<MAX_PLAYER_ATTACHED_OBJECTS; i++)
        {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);
        }
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT * FROM users WHERE uid = %i", PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_PROCESS_LOGIN, playerid);
	}

	return 1;
}
CMD:aduty(playerid)
{
    if(PlayerInfo[playerid][pAdmin] < 1)
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
    }

    new Float:x, Float:y, Float:z, Float:angle;
    if(!PlayerInfo[playerid][pAdminDuty])
    {
        /*SavePlayerVariables(playerid);
        ResetPlayerWeapons(playerid);*/
        
		SetPlayerAttachedObject(playerid, 0, 19142, 1, 0.089999, 0.049000, -0.000999, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
        SetPlayerAttachedObject(playerid, 0, 19096, 2,0.189000,0.000000,0.000000,0.000000,0.000000,0.000000,1.000000,1.000000,1.000000);
        SetPlayerAttachedObject(playerid, 3, 19590, 1, 0.220999, -0.126999, 0.034999, 81.499969, -4.099984, -55.300003, 1.000000, 1.000000, 1.000000);

        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, angle);
        SetPVarFloat(playerid, "PosX", x);
        SetPVarFloat(playerid, "PosY", y);
        SetPVarFloat(playerid, "PosZ", z);
        SetPVarFloat(playerid, "PosA", angle);
        SetPVarInt(playerid, "PosInt", GetPlayerInterior(playerid));
        SetPVarInt(playerid, "PosWorld", GetPlayerVirtualWorld(playerid));

        SetPlayerHealth(playerid, 32767);
        SetScriptArmour(playerid, 0.0);

        if(PlayerInfo[playerid][pGender] == 1)
        { // Male
            PlayerInfo[playerid][pGender] = 1;
            SetPlayerSkin(playerid, 217);
        }
        else if(PlayerInfo[playerid][pGender] == 2)
        { // Female
            PlayerInfo[playerid][pGender] = 2;
            SetPlayerSkin(playerid, 211);
        }

        SavePlayerVariables(playerid);
        ResetPlayerWeapons(playerid);
        SetPlayerHealth(playerid, 999999999);
        SMA(COLOR_GREEN, "%s is now on Administrative Duty.", GetPlayerNameEx(playerid));
        SCM(playerid, COLOR_WHITE, "** You are now on admin duty. Your stats will not be saved until you're off duty.");

        PlayerInfo[playerid][pAdminDuty] = 1;
        SetPlayerSpecialTag(playerid, TAG_ADMIN);

        if(strcmp(PlayerInfo[playerid][pAdminName], "None", true) != 0)
        {
            SetPlayerName(playerid, PlayerInfo[playerid][pAdminName]);
        }
    }
    else
    {
        //TogglePlayerSpectating(playerid, 1);
        SetPlayerSpecialTag(playerid, TAG_NORMAL);
        SetPlayerName(playerid, PlayerInfo[playerid][pUsername]);
        UpdateColorsForPlayer(playerid);
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT * FROM users WHERE uid = %i", PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_PROCESS_LOGIN, playerid);
    }
    return 1;
}

CMD:setadminname(playerid, params[])
{
    new name[MAX_PLAYER_NAME], targetid;

    if(PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "us[24]", targetid, name))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /setadminname [playerid] [name ('none' to reset)]");
    }
    if(!IsValidName(name))
    {
        return SCM(playerid, COLOR_SYNTAX, "The name specified is not supported by the SA-MP client.");
    }

    strcpy(PlayerInfo[targetid][pAdminName], name, MAX_PLAYER_NAME);

    if(PlayerInfo[targetid][pAdminDuty])
    {
        SetPlayerName(targetid, name);
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET adminname = '%e' WHERE uid = %i", name, PlayerInfo[targetid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    SAM(COLOR_LIGHTRED, "AdmCmd: %s changed their administrator name to %s.", PlayerInfo[targetid][pUsername], name);
    return 1;
}

CMD:getip(playerid, params[])
{
    new targetid;

    if(PlayerInfo[playerid][pAdmin] < 1)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "u", targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /getip [playerid]");
    }
    if(!IsPlayerConnected(targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
    }

    SM(playerid, COLOR_WHITE, "** %s[%i]'s IP: %s **", GetRPName(targetid), targetid, GetPlayerIP(targetid));
    return 1;
}

