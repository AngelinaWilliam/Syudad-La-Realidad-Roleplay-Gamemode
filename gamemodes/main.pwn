                        ShowPlayerDialog(playerid, DIALOG_TYPE_VENTS, DIALOG_STYLE_LIST, "Vents", "Oval\nSquare\n \nBack", "Apply", "Close");
						}
        	    	}
        	    	else
						{
						SendClientMessage(playerid,COLOR_YELLOW,"You cannot install this component on your car.");
						ShowPlayerDialog(playerid, DIALOG_TYPE_LIGHTS, DIALOG_STYLE_LIST, "Lights", "Round\nSquare\n \nBack", "Apply", "Close");
						}
        	    }
				case 2:
        	    {
                ShowPlayerDialog(playerid, DIALOG_TYPE_LIGHTS, DIALOG_STYLE_LIST, "Lights", "Round\nSquare\n \nBack", "Apply", "Close");
        	    }
        	    case 3: // BACK
        	    {
                ShowPlayerDialog(playerid, DIALOG_TYPE_MAIN, DIALOG_STYLE_LIST, "Car Tuning Menu", "Hoods\nVents\nLights\nExhausts\nFront Bumpers\nRear Bumpers\nRoofs\nSpoilers\nSide Skirts\nBullbars\nWheels\nCar Stereo\nHydraulics\nNitrous Oxide", "Enter", "Close");
        	    }
			}
		}
	}
    
    if(dialogid == DIALOG_RENTAL)
    {
        if(response)
        {
            for(new idx = 0; idx < sizeof(rentcar); idx++)
            {
                if(GetPlayerVehicleID(playerid) == rentcar[idx])
                {
                    PlayerInfo[playerid][pHireCar] = rentcar[idx];

                    GivePlayerCash(playerid, -5000);
                    AddToTaxVault(5000);

                    SendClientMessageEx(playerid, COLOR_REALRED, "[WARNING] Do not leave this vehicle unattended for 5 minutes as it may get despawned.");
                    return SendClientMessageEx(playerid, COLOR_LIGHTRED, "[RENTVEHICLE] You have rented this vehicle.");
                }
            }
            RestrictedVehicle(playerid);
            SendClientMessageEx(playerid, COLOR_GREY, "This is not a rental vehicle.");
        }
        else
        {
            RestrictedVehicle(playerid);
            SendClientMessageEx(playerid, COLOR_GREY, "You have decided not to rent a vehicle.");
        }
    }


    if(dialogid == DIALOG_CGAMESSETUPPOKER)
    {
        if(response) {
            new tableid = GetPVarInt(playerid, "tmpEditPokerTableID")-1;

            if(PokerTable[tableid][pkrPlaced] == 0) {
                switch(listitem)
                {
                    case 0: // Place Poker Table
                    {
                        new szString[128];
                        format(szString, sizeof(szString), "Press '{3399FF}~k~~PED_SPRINT~{FFFFFF}' to place poker table.");
                        SendClientMessage(playerid, COLOR_WHITE, szString);

                        SetPVarInt(playerid, "tmpPlacePokerTable", 1);
                    }
                }
            } else {
                switch(listitem)
                {
                    case 0: // Edit Poker Table
                    {
                        SetPVarFloat(playerid, "tmpPkrX", PokerTable[tableid][pkrX]);
                        SetPVarFloat(playerid, "tmpPkrY", PokerTable[tableid][pkrY]);
                        SetPVarFloat(playerid, "tmpPkrZ", PokerTable[tableid][pkrZ]);
                        SetPVarFloat(playerid, "tmpPkrRX", PokerTable[tableid][pkrRX]);
                        SetPVarFloat(playerid, "tmpPkrRY", PokerTable[tableid][pkrRY]);
                        SetPVarFloat(playerid, "tmpPkrRZ", PokerTable[tableid][pkrRZ]);

                        EditObject(playerid, PokerTable[tableid][pkrObjectID]);

                        new szString[128];
                        format(szString, sizeof(szString), "You have selected Poker Table %d, You may now customize it's position/rotation.", tableid);
                        SendClientMessage(playerid, COLOR_WHITE, szString);
                    }
                    case 1: // Destroy Poker Table
                    {
                        DestroyPokerTable(tableid);

                        new szString[64];
                        format(szString, sizeof(szString), "You have deleted Poker Table %d.", tableid);
                        SendClientMessage(playerid, COLOR_WHITE, szString);

                        ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSELECTPOKER);
                    }
                }
            }
        } else {
            ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSELECTPOKER);
        }
    }
    if(dialogid == DIALOG_CGAMESCREDITS)
    {
        ShowCasinoGamesMenu(playerid, DIALOG_CGAMESADMINMENU);
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME)
    {
        if(response) {
            switch(listitem)
            {
                case 0: // Buy-In Max
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME2);
                }
                case 1: // Buy-In Min
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME3);
                }
                case 2: // Blind
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME4);
                }
                case 3: // Limit
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME5);
                }
                case 4: // Password
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME6);
                }
                case 5: // Round Delay
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME7);
                }
                case 6: // Start Game
                {
                    ShowCasinoGamesMenu(playerid, DIALOG_CGAMESBUYINPOKER);
                }
            }
        } else {
            LeavePokerTable(playerid);
        }
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME2)
    {
        if(response) {
            if(strval(inputtext) < 1 || strval(inputtext) > 50000000) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME2);
            }

            if(strval(inputtext) <= PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBuyInMin]) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME2);
            }

            PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBuyInMax] = strval(inputtext);
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        } else {
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        }
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME3)
    {
        if(response) {
            if(strval(inputtext) < 1 || strval(inputtext) > 50000000) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME3);
            }

            if(strval(inputtext) >= PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBuyInMax]) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME3);
            }

            PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBuyInMin] = strval(inputtext);
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        } else {
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        }
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME4)
    {
        if(response) {
            if(strval(inputtext) < 1 || strval(inputtext) > 50000000) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME4);
            }

            PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBlind] = strval(inputtext);
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        } else {
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        }
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME5)
    {
        if(response) {
            if(strval(inputtext) < 2 || strval(inputtext) > 6) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME5);
            }

            PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrLimit] = strval(inputtext);
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        } else {
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        }
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME6)
    {
        if(response) {
            new tableid = GetPVarInt(playerid, "pkrTableID")-1;
            strmid(PokerTable[tableid][pkrPass], inputtext, 0, strlen(inputtext), 32);
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        } else {
            ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        }
    }
    if(dialogid == DIALOG_CGAMESSETUPPGAME7)
    {
        if(response) {
            if(strval(inputtext) < 15 || strval(inputtext) > 120) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME7);
            }

            PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrSetDelay] = strval(inputtext);
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        } else {
            return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESSETUPPGAME);
        }
    }
    if(dialogid == DIALOG_CGAMESBUYINPOKER)
    {
        if(response) {
            if(strval(inputtext) < PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBuyInMin] || strval(inputtext) > PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrBuyInMax] || strval(inputtext) > GetPlayerCash(playerid)) {
                return ShowCasinoGamesMenu(playerid, DIALOG_CGAMESBUYINPOKER);
            }

            PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrActivePlayers]++;
            SetPVarInt(playerid, "pkrChips", GetPVarInt(playerid, "pkrChips")+strval(inputtext));
            GivePlayerCash(playerid, -strval(inputtext));

            new string[255];
            format(string, sizeof(string), "%s (IP:%s) has bought in with the amount of $%s (%d)", GetPlayerNameEx(playerid), GetPlayerIpEx(playerid), number_format(GetPVarInt(playerid, "pkrChips")), GetPVarInt(playerid, "pkrTableID")-1);
            Log_Write2("logs/poker.log", string);

            if(PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrActive] == 3 && PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrRound] == 0 && PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrDelay] >= 6) {
                SetPVarInt(playerid, "pkrStatus", 1);
            }
            else if(PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrActive] < 3) {
                SetPVarInt(playerid, "pkrStatus", 1);
            }

            if(PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrActive] == 1 && GetPVarInt(playerid, "pkrRoomLeader")) {
                PokerTable[GetPVarInt(playerid, "pkrTableID")-1][pkrActive] = 2;
                SelectTextDraw(playerid, COLOR_YELLOW);
            }
        } else {
            return LeavePokerTable(playerid);
        }
    }
    if(dialogid == DIALOG_CGAMESCALLPOKER)
    {
        if(response) {
            new tableid = GetPVarInt(playerid, "pkrTableID")-1;

            new actualBet = PokerTable[tableid][pkrActiveBet]-GetPVarInt(playerid, "pkrCurrentBet");

            if(actualBet > GetPVarInt(playerid, "pkrChips")) {
                PokerTable[tableid][pkrPot] += GetPVarInt(playerid, "pkrChips");
                SetPVarInt(playerid, "pkrChips", 0);
                SetPVarInt(playerid, "pkrCurrentBet", PokerTable[tableid][pkrActiveBet]);
            } else {
                PokerTable[tableid][pkrPot] += actualBet;
                SetPVarInt(playerid, "pkrChips", GetPVarInt(playerid, "pkrChips")-actualBet);
                SetPVarInt(playerid, "pkrCurrentBet", PokerTable[tableid][pkrActiveBet]);
            }

            SetPVarString(playerid, "pkrStatusString", "Call");
            PokerRotateActivePlayer(tableid);

            ApplyAnimation(playerid, "CASINO", "cards_raise", 4.1, 0, 1, 1, 1, 1, 1);
        }

        DeletePVar(playerid, "pkrActionChoice");
    }
    if(dialogid == DIALOG_CGAMESRAISEPOKER)
    {
        if(response) {
            new tableid = GetPVarInt(playerid, "pkrTableID")-1;

            new actualRaise = strval(inputtext)-GetPVarInt(playerid, "pkrCurrentBet");

            if(strval(inputtext) >= PokerTable[tableid][pkrActiveBet]+PokerTable[tableid][pkrBlind]/2 && strval(inputtext) <= GetPVarInt(playerid, "pkrCurrentBet")+GetPVarInt(playerid, "pkrChips")) {
                PokerTable[tableid][pkrPot] += actualRaise;
                PokerTable[tableid][pkrActiveBet] = strval(inputtext);
                SetPVarInt(playerid, "pkrChips", GetPVarInt(playerid, "pkrChips")-actualRaise);
                SetPVarInt(playerid, "pkrCurrentBet", PokerTable[tableid][pkrActiveBet]);

                SetPVarString(playerid, "pkrStatusString", "Raise");

                PokerTable[tableid][pkrRotations] = 0;
                PokerRotateActivePlayer(tableid);

                ApplyAnimation(playerid, "CASINO", "cards_raise", 4.1, 0, 1, 1, 1, 1, 1);
            } else {
                ShowCasinoGamesMenu(playerid, DIALOG_CGAMESRAISEPOKER);
            }
        }

        DeletePVar(playerid, "pkrActionChoice");
    }
    if(dialogid == DIALOG_EDITMAINBACKPACK)
    {
        new bpstring[350], titlestring[64], string[500];
        if(response) {
            new index = GetPVarInt(playerid, "BackpackID");
            switch(listitem) {
                case 0: { // Backpack Owner
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                    format(bpstring, sizeof(bpstring), "\
                        {FFFFFF}Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                         To set the Ownership of this Backpack Enter a Player ID. \n\n\
                         {00FF00}Owner:{FFFFFF} %s",
                         GetBackpackOwner(index)
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_OWNER);

                }
                case 1: { // Backpack Size
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Size", index);
                    ShowPlayerDialog(playerid, DIALOG_CHANGESIZE, DIALOG_STYLE_LIST, titlestring, "{00FF00}Small Backpack\n{FF0000}Medium Backpack\n{0000FF}Large Backpack", "Change", "Back");
                }
                case 2: { // Cash
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Cash", index);
                    format(bpstring, sizeof(bpstring),"\
                        {FFFFFF}Input a Digit below to set the Cash of %s\n\
                        {00FF00}Status:{FFFFFF} $%s / $%s Cash",
                        GetBackpackSize(index),
                        number_format(BackpackInfo[index][sCash]),
                        number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_CASH);
                }
                case 3: { // Weed
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Weed", index);
                    format(bpstring, sizeof(bpstring),"\
                        {FFFFFF}Input a Digit below to set the Weed of %s\n\
                        {00FF00}Status:{FFFFFF} %sg / %sg Weed",
                        GetBackpackSize(index),
                        number_format(BackpackInfo[index][sPot]),
                        number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_POT))
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_POT);
                }
                case 4: { // Cracks
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Cocaine", index);
                    format(bpstring, sizeof(bpstring), "\
                        {FFFFFF}Input a Digit below to set the Cracks of %s\n\
                        {00FF00}Status:{FFFFFF} %sg / %sg Cracks",
                        GetBackpackSize(index),
                        number_format(BackpackInfo[index][sCrack]),
                        number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CRACK))
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_CRACK);

                }
                case 5: { // Mats
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Mats", index);
                    format(bpstring, sizeof(bpstring), "\
                        {FFFFFF}Input a Digit below to set the Mats of %s\n\
                        {00FF00}Status:{FFFFFF} %s / %s Mats",
                        GetBackpackSize(index),
                        number_format(BackpackInfo[index][sMats]),
                        number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_MATS))
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_MATS);
                }
                case 6: { // Gun 1 - Small to Large Backpack
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Gun1", index);
                    format(bpstring, sizeof(bpstring),"\
                        {FFFFFF}Input a Weapon ID below to set the Weapon of %s\n\
                        {00FFFF}Status:{FFFFFF} %s",
                        GetBackpackSize(index),
                        GetWeaponNameEx(BackpackInfo[index][sGun][0])
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_GUN1);
                }
                case 7: { // Gun 2 - Small to Large Backpack
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Gun2", index);
                    format(bpstring, sizeof(bpstring),"\
                        {FFFFFF}Input a Weapon ID below to set the Weapon of %s\n\
                        {00FFFF}Status:{FFFFFF} %s",
                        GetBackpackSize(index),
                        GetWeaponNameEx(BackpackInfo[index][sGun][1])
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_GUN2);
                }
                case 8: { // (Gun 3 Small to Large)
                    format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Gun3", index);
                    format(bpstring, sizeof(bpstring),"\
                        {FFFFFF}Input a Weapon ID below to set the Weapon of %s\n\
                        {00FFFF}Status:{FFFFFF} %s",
                        GetBackpackSize(index),
                        GetWeaponNameEx(BackpackInfo[index][sGun][2])
                    );
                    ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                    SetPVarInt(playerid, "Edit_Type", TYPE_GUN3);
                }
                case 9: { // (Gun 4 Large Backpack) (Edit Position or DeleteBackpack SMall Backpack)
                    if(BackpackInfo[index][sBackpackSize] == 1) {
                        if(BackpackInfo[index][sBackpackOwner] == -1 && !BackpackInfo[index][sAttached]) {
                            // Edit Position for Small Backpack
                            if(IsValidDynamicObject(BackpackInfo[index][sObj])) DestroyDynamicObject(BackpackInfo[index][sObj]);
                            GetPlayerPos(playerid, BackpackInfo[index][sPos][0],BackpackInfo[index][sPos][1], BackpackInfo[index][sPos][2]);
                            BackpackInfo[index][sPos][2] = (BackpackInfo[index][sPos][2] - 1.0);
                            BackpackInfo[index][sVirtualWorld] = GetPlayerVirtualWorld(playerid);
                            BackpackInfo[index][sInteriorWorld] = GetPlayerInterior(playerid);
                            switch(BackpackInfo[index][sBackpackSize]) {
                                case 1: BackpackInfo[index][sObj] = CreateDynamicObject(3026, BackpackInfo[index][sPos][0], BackpackInfo[index][sPos][1], BackpackInfo[index][sPos][2], -90, 0, 90, BackpackInfo[index][sVirtualWorld], BackpackInfo[index][sInteriorWorld], -1, 200.0), SetDynamicObjectMaterial(BackpackInfo[index][sObj],0, -1, "none", "none", 0xFF00FF00);
                                case 2: BackpackInfo[index][sObj] = CreateDynamicObject(3026, BackpackInfo[index][sPos][0], BackpackInfo[index][sPos][1], BackpackInfo[index][sPos][2], -90, 0, 90, BackpackInfo[index][sVirtualWorld], BackpackInfo[index][sInteriorWorld], -1, 200.0), SetDynamicObjectMaterial(BackpackInfo[index][sObj],0, -1, "none", "none", 0xFFFF0000);
                                case 3: BackpackInfo[index][sObj] = CreateDynamicObject(3026, BackpackInfo[index][sPos][0], BackpackInfo[index][sPos][1], BackpackInfo[index][sPos][2], -90, 0, 90, BackpackInfo[index][sVirtualWorld], BackpackInfo[index][sInteriorWorld], -1, 200.0), SetDynamicObjectMaterial(BackpackInfo[index][sObj],0, -1, "none", "none", 0xFF0000FF);
                            }
                            format(string, sizeof(string), "AdmCmd: %s has edit the position of [ID: %d] %s", GetPlayerNameEx(playerid),index, GetBackpackSize(index, 0));
                            ABroadCast(COLOR_LIGHTRED, string, 2);
                            //Log("logs/admin.log", string);
                            SaveBackpack(index);
                        }
                        else {
                            // Delete Backpack
                            new ponline = 0;
                            if(BackpackInfo[index][sBackpackOwner] != -1)
                            {
                                foreach(new i: Player)
                                {
                                    if(GetPlayerSQLId(i) == BackpackInfo[index][sBackpackOwner])
                                    {
                                        format(string, sizeof(string), "* Admin %s has deleted your %s", GetPlayerNameEx(playerid), GetPlayerStorageType(i));
                                        SendClientMessageEx(i, COLOR_AQUA, string);
                                        if(IsPlayerAttachedObjectSlotUsed(i, 9)) RemovePlayerAttachedObject(i, 9);
                                        format(string, sizeof(string), "AdmnCmd: %s has Deleted %s's %s [ID: %d]", GetPlayerNameEx(playerid), GetPlayerNameEx(i), GetPlayerStorageType(i), index);
                                        ABroadCast(COLOR_LIGHTRED, string , 2);
                                        backpackid[i] = MAX_BACKPACKS+1;
                                        //Log("logs/admin.log", string);
                                        ponline = 1;

                                    }
                                }
                            }
                            if(!ponline)
                            {
                                if(BackpackInfo[index][sBackpackOwner] != -1 && BackpackInfo[index][sAttached])
                                    format(string, sizeof(string), "AdmnCmd: %s has Deleted %s's [ID: %d] %s", GetPlayerNameEx(playerid), BackpackInfo[index][sBackpackOwnerName] ,index, GetBackpackSize(index, 0));
                                else format(string, sizeof(string), "AdmnCmd: %s has Deleted [ID: %d] %s", GetPlayerNameEx(playerid), index, GetBackpackSize(index, 0));
                                ABroadCast(COLOR_LIGHTRED, string , 2);
                                //Log("logs/admin.log", string);
                            }
                            BackpackInfo[index][sBackpackCreated] = 0;
                            BackpackInfo[index][sBackpackOwner] = -1;
                            BackpackInfo[index][sBackpackSize] = 0;
                            format(BackpackInfo[index][sBackpackOwnerName], MAX_PLAYER_NAME, "Nobody");
                            BackpackInfo[index][sAttached] = 0;
                            if(IsValidDynamicObject(BackpackInfo[index][sObj])) DestroyDynamicObject(BackpackInfo[index][sObj]);
                            BackpackInfo[index][sPos][0] = 0.0;
                            BackpackInfo[index][sPos][1] = 0.0;
                            BackpackInfo[index][sPos][2] = 0.0;
                            BackpackInfo[index][sVirtualWorld] = -1;
                            BackpackInfo[index][sInteriorWorld] = -1;
                            BackpackInfo[index][sCash] = 0;
                            BackpackInfo[index][sPot] = 0;
                            BackpackInfo[index][sCrack] = 0;
                            BackpackInfo[index][sMats] = 0;
                            for(new weaponid; weaponid<MAX_STOREGUN; weaponid++) {
                                BackpackInfo[index][sGun][weaponid] = 0;
                                BackpackInfo[index][sAmmo][weaponid] = 0;
                            }
                            SaveBackpack(index);
                        }
                    }
                    else if(BackpackInfo[index][sBackpackSize] >= 2) {
                        format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Gun4", index);
                        format(bpstring, sizeof(bpstring),"\
                            {FFFFFF}Input a Weapon ID below to set the Weapon of %s\n\
                            {00FFFF}Status:{FFFFFF} %s",
                            GetBackpackSize(index),
