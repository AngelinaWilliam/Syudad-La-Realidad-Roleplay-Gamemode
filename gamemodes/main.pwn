CMD:globalvoice(playerid, params[])
{
    new value;
    if(PlayerInfo[playerid][pAdmin] < 7)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "i", value) || !(0 <= value <= 1))
    {
        SCM(playerid, COLOR_SYNTAX, "Usage: /globalvoice [status (0/1)]");
        return 1;
    }
    if(value)
    {
        SvAddKey(playerid, 0x4A);
        SAM(COLOR_ORANGE, "Global Voice:"WHITE" Administrator %s has connected to global voice", GetRPName(playerid));
    }
    else
    {
        SvRemoveKey(playerid, 0x4A);
        SAM(COLOR_ORANGE, "Global Voice:"WHITE" Administrator %s has disconnected to global voice", GetRPName(playerid));
    }

    return 1;
}


