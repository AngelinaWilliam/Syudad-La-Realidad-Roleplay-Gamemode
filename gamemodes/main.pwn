            new bpstring[230], titlestring[64], count = 0;
            switch(GetPVarInt(playerid, "Edit_Type"))
            {
                case TYPE_OWNER: // Editing Backpack Owner
                {
                    if(strcmp(inputtext, "remove", true) == 0)
                    {
                        count = 1;
                        if(BackpackInfo[index][sBackpackOwner] == -1) {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring), "\
                                {FF0000}ERROR: The Backpack is already vacant!{FFFFFF}\n\n\
                                Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                To set the Ownership of this Backpack Enter a Player ID. \n\n\
                                {00FF00}Owner:{FFFFFF} %s",
                                GetBackpackOwner(index)
                            );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        new userid = -1;
                        foreach(new i: Player) {
                            if(backpackid[i] == MAX_BACKPACKS+1) continue;
                            if(BackpackInfo[index][sBackpackOwner] == GetPlayerSQLId(i)) {
                                userid = i;
                                break;
                            }
                        }
                        if(!IsPlayerConnected(userid)) {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring), "\
                                 {FF0000}ERROR: The Owner of this backpack isn't connected!{FFFFFF}\n\n\
                                 Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                 To set the Ownership of this Backpack Enter a Player ID.\n\n\
                                 {00FF00}Owner:{FFFFFF} %s",
                                 GetBackpackOwner(index)
                             );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        if(PlayerInfo[userid][pAdminDuty]) {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring),"\
                                {FF0000}ERROR: Admin %s must be on Off Duty State!!{FFFFFF}\n\n\
                                Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                To set the Ownership of this Backpack Enter a Player ID. \n\n\
                                {00FF00}Owner:{FFFFFF} %s",
                                GetPlayerNameEx(userid),
                                GetBackpackOwner(index)
                            );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        format(string,sizeof(string), "* Admin %s has removed your %s", GetPlayerNameEx(playerid), GetPlayerStorageType(userid));
                        SendClientMessageEx(userid, COLOR_AQUA, string);
                        BackpackInfo[index][sBackpackOwner] = -1;
                        format(BackpackInfo[index][sBackpackOwnerName], MAX_PLAYER_NAME, "Nobody");
                        BackpackInfo[index][sAttached] = 0;
                        BackpackInfo[index][sBackpackCreated] = 0;
                        RemovePlayerAttachedObject(userid, 9);
                        format(bpstring, sizeof(bpstring), "AdmcCmd: %s has remove %s's %s [ID: %d]", GetPlayerNameEx(playerid), GetPlayerNameEx(userid), GetPlayerStorageType(userid), index);
                        backpackid[userid] = MAX_BACKPACKS+1;
                        SaveBackpack(index);
                        ABroadCast(COLOR_LIGHTRED,bpstring, 2);
                        //Log("logs/admin.log", bpstring);
                        DeletePVar(playerid, "Edit_Type");
                        return 1;
                    }
                    else if(IsNumeric(inputtext))
                    {
                        new giveplayerid = strval(inputtext);
                        count = 1;
                        if(BackpackInfo[index][sBackpackOwner] != -1 && BackpackInfo[index][sAttached])
                        {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring)," \
                                {FF0000}ERROR: Remove the Backpack Owner first! to be able to set a new Backpack Owner{FFFFFF}\n\n\
                                {FFFFFF}Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                To set the Ownership of this Backpack Enter a Player ID. \n\n\
                                {00FF00}Owner:{FFFFFF} %s",
                                GetBackpackOwner(index)
                            );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        if(!IsPlayerConnected(giveplayerid)) {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring), "\
                                {FF0000}ERROR: Invalid Player ID!{FFFFFF}\n\n\
                                Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                To set the Ownership of this Backpack Enter a Player ID.\n\n\
                                {00FF00}Owner:{FFFFFF} %s",
                                GetBackpackOwner(index)
                            );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        if(PlayerInfo[giveplayerid][pAdminDuty])
                        {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring), "\
                                {FF0000}ERROR: Admin %s must be on Off Duty State!{FFFFFF}\n\n\
                                Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                To set the Ownership of this Backpack Enter a Player ID.\n\n\
                                {00FF00}Owner:{FFFFFF} %s",
                                GetPlayerNameEx(giveplayerid),
                                GetBackpackOwner(index)
                            );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        if(IsBackpackEquipped(giveplayerid))
                        {
                            format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                            format(bpstring, sizeof(bpstring),"\
                                 {FF0000}ERROR: %s has already a Backpack Equipped!{FFFFFF}\n\n\
                                 Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                                 To set the Ownership of this Backpack Enter a Player ID.\n\n\
                                 {00FF00}Owner:{FFFFFF} %s",
                                 GetPlayerNameEx(giveplayerid),
                                 GetBackpackOwner(index)
                            );
                            ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                            return 1;
                        }
                        new oldowner[90];
                        format(oldowner, sizeof(oldowner), "%s", GetBackpackOwner(index));
                        if(BackpackInfo[index][sPos][0] != 0.0) {
                            DestroyDynamicObject(BackpackInfo[index][sObj]);
                            BackpackInfo[index][sPos][0] = 0.0;
                            BackpackInfo[index][sPos][1] = 0.0;
                            BackpackInfo[index][sPos][2] = 0.0;
                            BackpackInfo[index][sVirtualWorld] = -1;
                            BackpackInfo[index][sInteriorWorld] = -1;
                        }
                        BackpackInfo[index][sBackpackOwner] = GetPlayerSQLId(giveplayerid);
                        format(BackpackInfo[index][sBackpackOwnerName], MAX_PLAYER_NAME, GetPlayerNameExt(giveplayerid));
                        BackpackInfo[index][sAttached] = 1;
                        backpackid[giveplayerid] = index;
                        SavePlayerVariables(giveplayerid);
                        LoadPlayerBackpack(giveplayerid);
                        new bpsize[24];
                        switch(BackpackInfo[index][sBackpackSize]){
                            case 1: format(bpsize,sizeof(bpsize), "Small Backpack");
                            case 2: format(bpsize,sizeof(bpsize), "Medium Backpack");
                            case 3: format(bpsize,sizeof(bpsize), "Large Backpack");
                        }
                        format(bpstring, sizeof(bpstring), "AdmcCmd: %s has changed %s [ID: %d] Owner from %s to %s,", GetPlayerNameEx(playerid), bpsize, index, oldowner, GetBackpackOwner(index));
                        ABroadCast(COLOR_LIGHTRED,bpstring, 2);
                        //Log("logs/admin.log", bpstring);
                        format(bpstring,sizeof(bpstring), "* Admin %s has given you a %s", GetPlayerNameEx(playerid), GetPlayerStorageType(giveplayerid));
                        SendClientMessageEx(giveplayerid, COLOR_AQUA, bpstring);
                        DeletePVar(playerid, "Edit_Type");
                        ShowEditBackpackDialog(playerid, index);
                        return 1;
                    }
                    if(count == 0) {
                        format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Owner", index);
                        format(bpstring, sizeof(bpstring), "\
                             {FFFFFF}Type '{FF0000}Remove{FFFFFF}' below if you wish to remove the Backpack Owner.\n\
                             To set the Ownership of this Backpack Enter a Player ID.\n\n\
                             {00FF00}Owner:{FFFFFF} %s", GetBackpackOwner(index)
                        );
                        ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Enter", "Back");
                        return 1;
                    }
                }
                case TYPE_CASH: // Editing Backpack Cash
                {
                    if(!IsNumeric(inputtext))
                    {
                        format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Cash", index);
                        format(bpstring, sizeof(bpstring)," \
                            {FF0000}ERROR: That's not a number!{FFFFFF}\n\n\
                            {FFFFFF}Input a Digit below to set the Cash of %s \n\
                            {00FF00}Status:{FFFFFF} $%s / $%s Cash",
                            GetBackpackSize(index),
                            number_format(BackpackInfo[index][sCash]),
                            number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                        );
                        ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                        return 1;
                    }
                    new cash = strval(inputtext);
                    if(cash > BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                    {
                        format(titlestring, sizeof(titlestring), "{FFFFFF}Backpack ID %d | Editing the Backpack Cash", index);
                        format(bpstring, sizeof(bpstring)," \
                            {FF0000}ERROR: $%s / $%s Backpack is on Maximum Limit!{FFFFFF}\n\n\
                            {FFFFFF}Input a Digit below to set the Cash of %s \n\
                            {00FF00}Status:{FFFFFF} $%s / $%s Cash",
                            number_format(cash),
                            number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH)),
                            GetBackpackSize(index),
                            number_format(BackpackInfo[index][sCash]),
                            number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                        );
                        ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                        return 1;
                    }
                    new userid = -1;
                    if(BackpackInfo[index][sBackpackOwner] != -1 && BackpackInfo[index][sAttached]) {
                        foreach(new i: Player) {
                            if(backpackid[i] == MAX_BACKPACKS+1) continue;
                            if(BackpackInfo[index][sBackpackOwner] == GetPlayerSQLId(i)) {
                                userid = i;
                                break;
                            }
                        }
                    }
                    if(userid != -1) {
                        format(string, sizeof(string), "* Admin %s has edit your Cash in your $%s from %s to $%s Cash", GetPlayerNameEx(playerid), GetPlayerStorageType(userid), number_format(BackpackInfo[index][sCash]), number_format(cash));
                        SendClientMessageEx(userid, COLOR_AQUA, string);
                    }
                    format(bpstring, sizeof(bpstring), "AdmcCmd: %s has edit the Cash from $%s to $%s of Owner: %s [ID: %d] %s", GetPlayerNameEx(playerid), number_format(BackpackInfo[index][sCash]), number_format(cash), BackpackInfo[index][sBackpackOwner],index  ,GetBackpackSize(index));
                    ABroadCast(COLOR_LIGHTRED,bpstring, 2);
                    //Log("logs/admin.log", bpstring);
                    BackpackInfo[index][sCash] = cash;
                    SaveBackpack(index);
                    DeletePVar(playerid, "Edit_Type");
                    return ShowEditBackpackDialog(playerid, index);
                }
                case TYPE_POT: // Editing Backpack Weed
