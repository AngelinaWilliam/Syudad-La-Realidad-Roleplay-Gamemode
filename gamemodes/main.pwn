forward OnPlayerDropInvItem(playerid, itemid, name[], value);
public OnPlayerDropInvItem(playerid, itemid, name[], value)
{
    new string[64];
    new str[64];

	if(Inventory_Count(playerid, name) < PlayerInfo[playerid][pGiveAmount])
		return SendClientMessage(playerid, COLOR_SYNTAX, "Error: You don't have anything serious that you want to drop.");
	
	format(str, sizeof(str), "Droped_%dx", PlayerInfo[playerid][pGiveAmount]);
	showitembox(playerid, name, str, itemid, 2);
	
	Inventory_Remove(playerid, name, value);
    Inventory_Update(playerid);
    MakeDropItem(playerid, itemid, name, value);  
	return Inventory_Close(playerid);
}

forward OnPlayerGiveInvItem(playerid, userid, itemid, name[], value);
public OnPlayerGiveInvItem(playerid, userid, itemid, name[], value)
{
    new string[64];
    new str[64];

	if(Inventory_Count(playerid, name) < PlayerInfo[playerid][pGiveAmount])
		return SendClientMessage(playerid, COLOR_SYNTAX, "Error: You don't have anything serious that you want to give him/her.");

    format(str, sizeof(str), "Removed_%dx", PlayerInfo[playerid][pGiveAmount]);
	showitembox(playerid, name, str, itemid, 2);

	format(str, sizeof(str), "Received_%dx", PlayerInfo[playerid][pGiveAmount]);
	showitembox(userid, name, str, itemid, 2);

	Inventory_Add(userid, name, itemid, value);	
    Inventory_Remove(playerid, name, value);
    Inventory_Update(playerid);
    Inventory_Update(userid);
	return Inventory_Close(playerid);
}

GetNearbyDrops(playerid)
{
	for(new i = 0; i < MAX_DYNAMICDROPS; i ++)
	{
	    if(DROPInfo[i][aExists] && IsPlayerInRangeOfPoint(playerid, 3.0, DROPInfo[i][aPosX], DROPInfo[i][aPosY], DROPInfo[i][aPosZ]))
	    {
	        return i;
	    }
	}
	return -1;
}

forward OnPlayerDropDynamicItem(playerid, atm, Float:x, Float:y, Float:z, itemid, itemn[], amount);
public OnPlayerDropDynamicItem(playerid, atm, Float:x, Float:y, Float:z, itemid, itemn[], amount)
{
    DROPInfo[atm][aID] = cache_insert_id(connectionID);
	DROPInfo[atm][aExists] = true;
    DROPInfo[atm][aPosX] = x;
    DROPInfo[atm][aPosY] = y;
    DROPInfo[atm][aPosZ] = z;
    DROPInfo[atm][aItem] = itemid;
    strcpy(DROPInfo[atm][aItemname], itemn, 32);
    DROPInfo[atm][aitemamount] = amount;

	ReloadDDP(atm);
}
ReloadDDP(atmid)
{
	if(DROPInfo[atmid][aExists])
	{
	    DestroyDynamic3DTextLabel(DROPInfo[atmid][aText]);
	    DestroyDynamicObject(DROPInfo[atmid][aObject]);
		
		DROPInfo[atmid][aText] = CreateDynamic3DTextLabel(""GREEN"Press [Y] to see droped Item.", COLOR_TEAL, DROPInfo[atmid][aPosX]-0.105347, DROPInfo[atmid][aPosY], DROPInfo[atmid][aPosZ]-0.904331, 20.0);
		DROPInfo[atmid][aObject] = CreateDynamicObject(11745, DROPInfo[atmid][aPosX]-0.105347, DROPInfo[atmid][aPosY], DROPInfo[atmid][aPosZ]-0.904331, 0.000000, 0.000000, 0.000000, -1, -1, -1, 300.00, 300.00); 		                                               
	}
}
MakeDropItem(playerid, item, name[], amount)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = 0; i < MAX_DYNAMICDROPS; i ++)
	{
		if(!DROPInfo[i][aExists])
		{
		    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO dropitems VALUES(null, '%f', '%f', '%f', %i, '%s', %i)", x, y, z, item, name, amount);
		    mysql_tquery(connectionID, queryBuffer, "OnPlayerDropDynamicItem", "iifffisi", playerid, i, x, y, z, item, name, amount);
		    return 1;
		}
	}
	return 1;
}

LoadDropItem(playerid)
{
    new count = 0;
    for(new i = 0; i < 28; i++)
	{
        PlayerTextDrawHide(playerid, D_DROPTD[playerid][i]);
	}
	CancelSelectTextDraw(playerid);
	for(new i = 0; i < MAX_DYNAMICDROPS; i ++)
	{
	    if(DROPInfo[i][aExists] && IsPlayerInRangeOfPoint(playerid, 3.0, DROPInfo[i][aPosX], DROPInfo[i][aPosY], DROPInfo[i][aPosZ]))
	    {
	        count++;
	        new string[128];
	        format(string, sizeof(string), "dropitemvalue%i", count);
	        DeletePVar(playerid, string);
	        SetPVarInt(playerid, string, i);   
            ShowDropTD(playerid, count);         
	    }
	}
}

