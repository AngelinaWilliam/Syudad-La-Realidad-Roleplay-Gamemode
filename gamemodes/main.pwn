CMD:pasaload(playerid, params[])
{
    new targetid, amount;
    if(!PlayerInfo[playerid][pPhone])
    {
        return SCM(playerid, COLOR_SYNTAX, "You don't have a cellphone and therefore can't use this command.");
    }

    if(sscanf(params, "ui", targetid, amount))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /pay [playerid] [amount]");
    }
    if(amount < 1 || amount > PlayerInfo[playerid][pPhoneLoad])
    {
        return SCM(playerid, COLOR_WHITE, "Insufficient amount.");
    }

    PlayerInfo[playerid][pPhoneLoad] -= amount;
    PlayerInfo[targetid][pPhoneLoad] += amount;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET phoneload = %i WHERE uid = %i", PlayerInfo[playerid][pPhoneLoad], PlayerInfo[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET phoneload = %i WHERE uid = %i", PlayerInfo[targetid][pPhoneLoad], PlayerInfo[targetid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    SM(playerid, COLOR_AQUA, "You sent %i regular load to %s..", amount, GetRPName(targetid));
    SM(targetid, COLOR_AQUA, "You have received %i regular load from %s.", amount, GetRPName(playerid));

    SendProximityMessage(playerid, 20.0, COLOR_WHITE, "**{C2A2DA} %s gives coins to %s.", GetRPName(playerid), GetRPName(targetid));
    return 1;
}
CMD:buyload(playerid, params[])
{
    new amount, price, cost = 5;

    new businessid = GetInsideBusiness(playerid);
    if(businessid == -1)
    {
        return SendClientMessageEx(playerid, COLOR_GREY, "You must be in a store to purchase a phone credit.");
    }
    if(BusinessInfo[businessid][bType] != BUSINESS_STORE)
    {
        return SendClientMessageEx(playerid, COLOR_GREY, "You must be in a store to purchase a load.");
    }
    if(sscanf(params, "i", amount))
    {
        SendClientMessage(playerid, COLOR_SYNTAX, "{FF6347}Usage:{ffffff} /buyload [amount]");
        SendClientMessageEx(playerid, COLOR_SYNTAX, "You are paying $%i per load at your current skill level.", cost);
        return 1;
    }
    if(!(1 <= amount <= 50))
    {
        return SendClientMessage(playerid, COLOR_GREY, "The amount must range between 1 and 50.");
    }
    if(PlayerInfo[playerid][pPhoneLoad] + amount > 50)
    {
        return SendClientMessage(playerid, COLOR_GREY, "You can't have more than 50 load.");
    }

    price = amount * cost;

    if(PlayerInfo[playerid][pCash] < price)
    {
        SendClientMessageEx(playerid, COLOR_GREY, "You can't afford to purchase %i load for $%i.", amount, price);
    }
    else
    {
        PlayerInfo[playerid][pPhoneLoad] += amount;

        GivePlayerCash(playerid, -price);
        SendClientMessageEx(playerid, COLOR_AQUA, "* You have purchased %i load for $%i.", amount, price);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE `users` SET phoneload = %i WHERE uid = %i", PlayerInfo[playerid][pPhoneLoad], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
    }

    return 1;
}

CMD:checkload(playerid, params[])
{
    if(!PlayerInfo[playerid][pPhone])
    {
        return SCM(playerid, COLOR_SYNTAX, "You don't have a cellphone and therefore can't use this command.");
    }
    new str[2000], coordsstring[286];
    format(coordsstring, sizeof(coordsstring), ""YELLOW"Your balance is"WHITE": %i Regular Load\n", PlayerInfo[playerid][pPhoneLoad]);
    strcat(str, coordsstring);
    format(coordsstring, sizeof(coordsstring), ""TWEET"Your load will deduct when you text, call and tweet someone");
    strcat(str, coordsstring);
    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "Load Balance:", str, "Close", "");
    return 1;
}
