                        SendClientMessageEx(userid, COLOR_AQUA, string);
                    }
                    format(bpstring, sizeof(bpstring), "AdmcCmd: %s has edit the Weed from %sg to %sg of Owner: %s [ID: %d] %s", GetPlayerNameEx(playerid), number_format(BackpackInfo[index][sPot]), number_format(pots) ,BackpackInfo[index][sBackpackOwner],index, GetBackpackSize(index));
                    ABroadCast(COLOR_LIGHTRED,bpstring, 2);
                    //Log("logs/admin.log", bpstring);
                    BackpackInfo[index][sPot] = pots;
                    SaveBackpack(index);
                    DeletePVar(playerid, "Edit_Type");
                    return ShowEditBackpackDialog(playerid, index);
                }
                case TYPE_CRACK: // Editing Backpack Cocaine
