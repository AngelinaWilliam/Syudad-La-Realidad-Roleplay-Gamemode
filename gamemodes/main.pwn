    }

    PlayerTextDrawSetString(playerid, ModernPlayerText[playerid], string);
    PlayerTextDrawShow(playerid, ModernPlayerText[playerid]);

    PlayerInfo[playerid][pDyuze] = true;
    PlayerInfo[playerid][pDyuzeTimer] = SetTimerEx("HidetheDyuze", time, false, "d", playerid);
}

