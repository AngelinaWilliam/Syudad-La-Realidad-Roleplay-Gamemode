                format(bpstring, sizeof(bpstring), "AdmcCmd: %s has set %s [ID: %d] to %s", GetPlayerNameEx(playerid), bpsize1, index, bpsize);
                SaveBackpack(index);
                ABroadCast(COLOR_LIGHTRED,bpstring, 2);
