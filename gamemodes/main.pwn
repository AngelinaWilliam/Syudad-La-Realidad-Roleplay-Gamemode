forward CrankEngine(vehicleid, playerid);
public CrankEngine(vehicleid, playerid)
{
    new string[256];
    SendClientMessage(playerid, COLOR_RED, "> Wrong fuel type in vehicle!");
    format(string, sizeof(string),"* A loud crank is heard when %s turns on the %s's engine *", GetRPName(playerid), GetVehicleName(vehicleid));
    ProxDetector(20.0,playerid,string, COLOR_EMOTE, COLOR_EMOTE, COLOR_EMOTE, COLOR_EMOTE, COLOR_EMOTE);

    format(string, sizeof(string),"* A loud bang is heard as the %s comes to a dead stop. *",GetVehicleName(vehicleid));
    ProxDetector(20.0,playerid,string, COLOR_EMOTE, COLOR_EMOTE, COLOR_EMOTE, COLOR_EMOTE, COLOR_EMOTE);
    SendClientMessage(playerid, COLOR_RED, "This vehicle is broken and needs to be repaired.");


    SetVehicleHealth(vehicleid, 300.0);
    PlayerInfo[playerid][pEngine] = 0;
    vehicleFuel[vehicleid] = 0;
    SetVehicleParams(vehicleid, VEHICLE_ENGINE, 0);
    GameTextForPlayer(playerid, "~r~Engine totalled", 3000, 3);
    return 1;
}
forward SetVehicleEngine(vehicleid, playerid);
public SetVehicleEngine(vehicleid, playerid)
{
    if(PlayerInfo[playerid][pLogged])
    {
        PlayerInfo[playerid][pEngine] = 0;
        SetVehicleParams(vehicleid, VEHICLE_ENGINE, true);
        SendProximityMessage(playerid, 20.0, SERVER_COLOR, "**{C2A2DA} %s turns on the engine of the %s.", GetRPName(playerid), GetVehicleName(vehicleid));
        Dyuze(playerid, "You have ~g~started~w~ the engine!");
    }
    return 1;
}

forward SetVehicleEngineHotwire(vehicleid, playerid);
public SetVehicleEngineHotwire(vehicleid, playerid)
{
    if(PlayerInfo[playerid][pLogged])
    {
        Inventory_Remove(playerid, "Toolkit");
        PlayerInfo[playerid][pEngine] = 0;
        SetVehicleParams(vehicleid, VEHICLE_ENGINE, true);
        SendProximityMessage(playerid, 20.0, SERVER_COLOR, "**{C2A2DA} %s has successfully hotwired the %s.", GetRPName(playerid), GetVehicleName(vehicleid));
    }
    return 1;
}

IsPlayerOnline(const name[], &id = INVALID_PLAYER_ID)
{
    foreach(new i : Player)
    {
        if(!strcmp(GetPlayerNameEx(i), name) && PlayerInfo[i][pLogged])
        {
            id = i;
            return 1;
        }
    }

    id = INVALID_PLAYER_ID;
    return 0;
}
