public OnPlayerDisconnect(playerid, reason)
{
    if (lstream[playerid]) {
        SvDeleteStream(lstream[playerid]);
        lstream[playerid] = SV_NULL;
    }
    if(PlayerInfo[playerid][pCalling] > 0)
    {
        HangupCall(playerid);
    }
    if (PlayerInfo[playerid][pShowFooter])
    {
        KillTimer(PlayerInfo[playerid][pFooterTimer]);
    }
    if(PlayerInfo[playerid][pAdmin] > 0)
    {
        if(Iter_Contains(Admins, playerid)) Iter_Remove(Admins, playerid);
    }
    if(GetPVarType(playerid, "pkrTableID")) {
        LeavePokerTable(playerid);
    }

    if(GetPVarType(playerid, "pTable")) {
        DestroyPokerTable(GetPVarInt(playerid, "pTable"));
    }
    //KillTimer(CARrainbow[playerid]);
    //activerainbow[playerid] = 0;
    //K[playerid] = 0;
    PlayerInfo[playerid][pTable] = 0;
    PlayerInfo[playerid][pIgnoreTD] = 0;
    FurnitureEditor[playerid] = -1;
    TerminateInfo(playerid, reason);
    ClearInventory(playerid);
    ResetPlayerVariables(playerid);
    SavePlayerWeapons(playerid);

    if(PlayerInfo[playerid][pAdmin])
    {
        SAM(COLOR_RED, "[Admin Offline]"WHITE" %s %s has left the server (playing on %s).", GetAdminRank(playerid), GetRPName(playerid), IsPlayerAndroid(playerid) ? ("Mobile") : ("Desktop/Laptop"));
    }

    return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
    if(PlayerInfo[playerid][pKicked]) return 0;

    if(!PlayerInfo[playerid][pLogged])
    {
        TogglePlayerSpectating(playerid, 1);
        SetPlayerColor(playerid, 0xFFFFFF00);
        // Due to a SA-MP bug, you can't apply camera coordinates directly after enabling spectator mode (to hide HUD).
        // In this case we'll use a timer to defer this action.
        PlayAudioStreamForPlayer(playerid, "http://j.top4top.io/m_341347nh80.mp3");
        SetTimerEx("ShowMainMenuCamera", 400, false, "i", playerid);
    }

    return 1;
}
stock GetPlayerFps(playerid)
{
    SetPVarInt(playerid, "DrunkL", GetPlayerDrunkLevel(playerid));
    if(GetPVarInt(playerid, "DrunkL") < 100) SetPlayerDrunkLevel(playerid, 2000);
    else
    {
        if(GetPVarInt(playerid, "LDrunkL") != GetPVarInt(playerid, "DrunkL"))
        {
            SetPVarInt(playerid, "FPS", (GetPVarInt(playerid, "LDrunkL") - GetPVarInt(playerid, "DrunkL")));
            SetPVarInt(playerid, "LDrunkL", GetPVarInt(playerid, "DrunkL"));
            if((GetPVarInt(playerid, "FPS") > 0) && (GetPVarInt(playerid, "FPS") < 256)) return GetPVarInt(playerid, "FPS") - 1;
        }
    }
    return 0;
}
public OnPlayerSpawn(playerid)
{
    if(PlayerInfo[playerid][pKicked]) return 0;

    if(PlayerInfo[playerid][pSetup])
    {
        if(PlayerInfo[playerid][pTutorial])
        {
            KillTimer(PlayerInfo[playerid][pTutorialTimer]);
            PlayerInfo[playerid][pTutorial] = 0;
        }


        InterpolateCameraPos(playerid, 1314.181030, -1916.689697, 218.157684, 1479.942749, -1804.981689, 161.074020, 5500, CAMERA_MOVE);
        InterpolateCameraLookAt(playerid, 1317.859252, -1914.111328, 215.961776, 1480.490600, -1800.099243, 160.145843, 5500, CAMERA_MOVE);
        SetPlayerPos(playerid, 1481.419189, -1790.421020, 156.753326);
        SetPlayerFacingAngle(playerid, 184.29);
        TogglePlayerControllable(playerid, false);
        new randomhp = 5 + random(20);
        SetPlayerVirtualWorld(playerid, randomhp);
        SetPlayerInterior(playerid, 0);
        ShowDialogToPlayer(playerid, ACCOUNT_CREATION);
    }
    
	if(PlayerInfo[playerid][pGTAV] == 0)
	{
		TogglePlayerControllable(playerid, 0);
		SetTimerEx("GrandTheftAutoV", 2000, false, "iifffffff", playerid, 1, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ], PlayerInfo[playerid][pPosA], PlayerInfo[playerid][pCameraX], PlayerInfo[playerid][pCameraY], PlayerInfo[playerid][pCameraZ]);
	}
	// OVR HUD
    TextDrawShowForPlayer(playerid, OVRHUD[0]);
    TextDrawShowForPlayer(playerid, OVRHUD[1]);
    PlayerTextDrawShow(playerid, ONLIINE[playerid]);
    
	TextDrawShowForPlayer(playerid, COPYRIGHTTD[0]);
	TextDrawShowForPlayer(playerid, COPYRIGHTTD[1]);
	TextDrawShowForPlayer(playerid, COPYRIGHTTD[2]);
	TextDrawShowForPlayer(playerid, COPYRIGHTTD[3]);
	TextDrawShowForPlayer(playerid, COPYRIGHTTD[4]);

	PlayerTextDrawShow(playerid, COPYRIGHTTDd[playerid][0]);
	PlayerTextDrawShow(playerid, COPYRIGHTTDd[playerid][1]);
	PlayerTextDrawShow(playerid, COPYRIGHTTDd[playerid][2]);
	
    if(PlayerInfo[playerid][pHunted])
    {
        ResetPlayer(playerid);
        SetPlayerToSpawn(playerid);
    }
    else if(PlayerInfo[playerid][pJailTime] > 0)
    {
        SetPlayerInJail(playerid);
        if(PlayerInfo[playerid][pJailType] == 2)
        {
            SM(playerid, COLOR_LIGHTRED, "** You were placed in admin prison by %s, reason: %s", PlayerInfo[playerid][pPrisonedBy], PlayerInfo[playerid][pPrisonReason]);
        }
        else
        {
            PlayerTextDrawShow(playerid, customHUD[playerid]);
            SCM(playerid, COLOR_LIGHTRED, "** You haven't completed your jail sentence yet.");
        }
    }
    else if(PlayerInfo[playerid][pPaintball] > 0)
    {
        SetPlayerInPaintball(playerid, PlayerInfo[playerid][pPaintball]);
    }
    else
    {
        PlayerInfo[playerid][pJoinedEvent] = 0;

        if(PlayerInfo[playerid][pInjured])
        {
            ApplyAnimation(playerid, "SWEET", "Sweet_injuredloop", 4.1, 0, 0, 0, 1, 0, 1);

            SetPlayerHealth(playerid, 100.0);
            SetPlayerArmour(playerid, 0.0);
            //ApplyAnimation(playerid, "SWEET", "Sweet_injuredloop", 4.1, 0, 0, 0, 1, 0, 1);
            //ApplyAnimation(playerid, "CRACK", "null", 4.0, 0, 0, 0, 1, 0, 1);
            //ApplyAnimationEx(playerid, "SWEET", "Sweet_injuredloop", 4.1, 1, 0, 0, 0, 0);
            //ApplyAnimation(playerid, "PED", "KO_skid_front", 4.0, 0, 0, 0, 1, 0, 1);

	        new string[128];
			format(string, sizeof(string), "(( Has been Injured ))\n {F7A763}Type '/lootplayer' to loot their items ");
			UpdateDynamic3DTextLabelText(InjuredLabel[playerid], COLOR_DOCTOR, string);

            GameTextForPlayer(playerid, "~r~You're injured!~n~~w~/call 911 or ~r~/accept death", 3000, 3);
            SendClientMessage(playerid, COLOR_LIGHTRED, "You have been Brutally Wounded, Now if a medic or somebody doesn't help yoou you will die.");
            TogglePlayerControllable(playerid, 0);
            SetTimerEx("UnfreezePlayerEx", 5000, false, "i", playerid);

            Maskara[playerid] = 0;
            PlayerInfo[playerid][pDeathCooldown] = 300;
        }
        if(IsSabongActive() && IsPlayerFighter(playerid))
        {
            new meronPlayer = cockFight[Fighter1ID], walaPlayer = cockFight[Fighter2ID];
            if(IsPlayerConnected(meronPlayer))
            {
                SetPlayerWeapons(meronPlayer);
                SetPlayerSkin(meronPlayer, PlayerInfo[meronPlayer][pSkin]);
                SetPlayerPos(meronPlayer, cockFight[FighterPos1X], cockFight[FighterPos1Y], cockFight[FighterPos1Z]);
                SetPlayerColor(meronPlayer, 0xFFFFFF00);
                PlayerInfo[meronPlayer][pNoDamage] = 0;
                RemovePlayerAttachedObject(meronPlayer, 9);
            }
            if(IsPlayerConnected(walaPlayer))
            {
                SetPlayerSkin(walaPlayer, PlayerInfo[walaPlayer][pSkin]);
                SetPlayerPos(walaPlayer, cockFight[FighterPos2X], cockFight[FighterPos2Y], cockFight[FighterPos2Z]);
                SetPlayerColor(walaPlayer, 0xFFFFFF00);
                SetPlayerWeapons(walaPlayer);
                PlayerInfo[walaPlayer][pNoDamage] = 0;
                RemovePlayerAttachedObject(walaPlayer, 9);
            }
            foreach(new i : Player)
            {
                if(betInfo[i][WalaBetAmount] > 0 || betInfo[i][MeronBetAmount] > 0)
                {
                    GivePlayerCash(i, betInfo[i][WalaBetAmount]);
                    GivePlayerCash(i, betInfo[i][MeronBetAmount]);
                    SM(i, COLOR_GRAD1, "Your $%s bet has been refunded because the match is cancelled.", number_format(betInfo[i][WalaBetAmount] + betInfo[i][MeronBetAmount]));

                    betInfo[i][WalaBetAmount] = 0;
                    betInfo[i][MeronBetAmount] = 0;
                }
            }
            ResetCockFightVars();
        }


        else if(PlayerInfo[playerid][pHospital])
        {
            if(PlayerInfo[playerid][pInsurance] == 0)
                SetPlayerInHospital(playerid);
            else
                SetPlayerInHospital(playerid, .type = PlayerInfo[playerid][pInsurance]);

            //ResetPlayerWeaponsEx(playerid);
        }
        else
        {
            SetPlayerHealth(playerid, PlayerInfo[playerid][pHealth]);
            SetScriptArmour(playerid, PlayerInfo[playerid][pArmor]);
        }

        if(!PlayerInfo[playerid][pHospital])
        {
            if(PlayerInfo[playerid][pDueling] != INVALID_PLAYER_ID)
            {
                PlayerInfo[PlayerInfo[playerid][pDueling]][pDueling] = INVALID_PLAYER_ID;
                PlayerInfo[playerid][pDueling] = INVALID_PLAYER_ID;
            }
            if(PlayerInfo[playerid][pBoxing] != INVALID_PLAYER_ID)
            {
                PlayerInfo[PlayerInfo[playerid][pBoxing]][pBoxing] = INVALID_PLAYER_ID;
                PlayerInfo[playerid][pBoxing] = INVALID_PLAYER_ID;
            }
            SetPlayerPos(playerid, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ]);
            SetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosA]);
            SetPlayerInterior(playerid, PlayerInfo[playerid][pInterior]);
            SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][pWorld]);
            SetPlayerWeapons(playerid);
        }
    }

    SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
    SetPlayerFightingStyle(playerid, PlayerInfo[playerid][pFightStyle]);
    SetPlayerSkillLevel(playerid, WEAPONSKILL_MICRO_UZI, 998);
    SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL, 998);
    SetPlayerSkillLevel(playerid, WEAPONSKILL_SAWNOFF_SHOTGUN, 998);
    SetPlayerClothing(playerid);
    /*#if defined christmas
    #else
        PlayerTextDrawShow(playerid, EventTextdraw[playerid]);
    #endif*/

    for(new l =0; l < 5; l++) TextDrawShowForPlayer(playerid, new_logo[l]);
    for (new i = 0; i < 6; i ++)
    {
        PlayerTextDrawShow(playerid, HungerTD[playerid][i]);
    }
    LoadPlayerBackpack(playerid);
    return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
    if(gettime() - PlayerInfo[playerid][pLastDeath] < 2)
    {
        return 1;
    }
    if (CarRadars[playerid] == 1)
    {
        CarRadars[playerid] = 0;
        for (new i = 0; i < 6; i ++)
        {
            PlayerTextDrawHide(playerid, VehicleRadar[playerid][i]);
        }
        DeletePVar(playerid, "_lastTicketWarning");
    }
    #if defined HALLOWEEN
        #if defined PUMPKIN_DROPS
        if(IsPlayerConnected(killerid))
        {
            new Float: x, Float: y, Float: z;
            GetPlayerPos(playerid, x, y, z);
            Halloween_CreatePumpkin(x, y, z, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
        }
        #endif
    #endif

    if(cockFight[IsMatchStarted] && killerid != INVALID_PLAYER_ID)
    {
        new meronPlayer = cockFight[Fighter1ID], walaPlayer = cockFight[Fighter2ID];
        if(meronPlayer == playerid && walaPlayer == killerid) //Win: Wala | Lose: Meron
        {
            foreach(new i : Player)
            {
                if(betInfo[i][WalaBetAmount] > 0)
                {
                    new logstring[256];
                    new payout = GetWalaPayout(i);
                    new deduction = cockFight[WinDeduction] <= 0.0 ? 0 : floatround((float(payout) - float(betInfo[i][WalaBetAmount])) * cockFight[WinDeduction]);
                    new winamount = payout - deduction;

                    format(logstring, sizeof(logstring), "You won ~g~$%s!", number_format(winamount));
                    GameTextForPlayer(i, logstring, 5000, 3);
                    if(deduction > 0.0) SM(i, COLOR_GRAD1, "$%s taxed from your earnings.", number_format(deduction));
                    SM(i, COLOR_YELLOW, "Congratulations! Blue fighter wins and you recieved $%s from your $%s bet!", number_format(winamount), number_format(betInfo[i][WalaBetAmount]));
                    GivePlayerCash(i, winamount);
                    ChargeFromTotalBets(winamount);
                }
                if(betInfo[i][MeronBetAmount] > 0)
                {
                    SM(i, COLOR_GRAD1, "Too bad, your bet on Red fighter lost.");
                }
                if(IsPlayerInRangeOfPoint(i, 50.0, cockFight[BetPosX], cockFight[BetPosY], cockFight[BetPosZ]))
                {
                    HideFightTD(i);
                    ShowFightTD(i, 2);
                }
                betInfo[i][MeronBetAmount] = 0;
                betInfo[i][WalaBetAmount] = 0;
            }

            SendClientMessageToAll(COLOR_LIGHTBLUE, "* Blue fighter wins the match! The match will automatically end within 10 seconds.");
            cockFight[IsMatchStarted] = false;
            UpdateAllFightTD(false);

            SetTimerEx("EndMatch", 8000, false, "");
            SetTimerEx("DelayedRevive", 2000, false, "d", meronPlayer);

            return 1;
        }
        else if(meronPlayer == killerid && walaPlayer == playerid) //Win: Meron | Lose: Wala
        {
            foreach(new i : Player)
            {
                if(betInfo[i][MeronBetAmount] > 0)
                {
                    new logstring[256];
                    new payout = GetMeronPayout(i);
                    new deduction = cockFight[WinDeduction] <= 0.0 ? 0 : floatround((float(payout) - float(betInfo[i][MeronBetAmount])) * cockFight[WinDeduction]);
                    new winamount = payout - deduction;

                    format(logstring, sizeof(logstring), "~w~You won ~g~$%s!", number_format(winamount));
                    GameTextForPlayer(i, logstring, 5000, 3);

                    if(deduction > 0.0) SM(i, COLOR_GRAD1, "$%s has been taxed from your earnings.", number_format(deduction));
                    SM(i, COLOR_YELLOW, "Congratulations! Red team wins and you recieved $%s from your bet!", number_format(winamount));
                    GivePlayerCash(i, winamount);
                    ChargeFromTotalBets(payout);
                }
                if(betInfo[i][WalaBetAmount] > 0)
                {
                    SM(i, COLOR_GRAD1, "Too bad, your bet on Blue fighter has lost.");
                }
                if(IsPlayerInRangeOfPoint(i, 50.0, cockFight[BetPosX], cockFight[BetPosY], cockFight[BetPosZ]))
                {
                    HideFightTD(i);
                    ShowFightTD(i, 1);
                }
                betInfo[i][MeronBetAmount] = 0;
                betInfo[i][WalaBetAmount] = 0;
            }

            SendClientMessageToAll(COLOR_LIGHTBLUE, "* Red fighter wins the match! The match will automatically end within 10 seconds.");
            cockFight[IsMatchStarted] = false;
            UpdateAllFightTD(false);

            SetTimerEx("EndMatch", 8000, false, "");
            SetTimerEx("DelayedRevive", 2000, false, "d", walaPlayer);

            return 1;
        }
        else if(IsPlayerFighter(playerid))
        {
            if(IsPlayerConnected(meronPlayer))
            {
                SetPlayerWeapons(meronPlayer);
                SetPlayerSkin(meronPlayer, PlayerInfo[meronPlayer][pSkin]);
                SetPlayerPos(meronPlayer, cockFight[FighterPos1X], cockFight[FighterPos1Y], cockFight[FighterPos1Z]);
                SetPlayerColor(meronPlayer, 0xFFFFFF00);
                PlayerInfo[meronPlayer][pNoDamage] = 0;
                RemovePlayerAttachedObject(meronPlayer, 9);
            }
            if(IsPlayerConnected(walaPlayer))
            {
                SetPlayerSkin(walaPlayer, PlayerInfo[walaPlayer][pSkin]);
                SetPlayerPos(walaPlayer, cockFight[FighterPos2X], cockFight[FighterPos2Y], cockFight[FighterPos2Z]);
                SetPlayerColor(walaPlayer, 0xFFFFFF00);
                SetPlayerWeapons(walaPlayer);
                PlayerInfo[walaPlayer][pNoDamage] = 0;
                RemovePlayerAttachedObject(walaPlayer, 9);
            }
            foreach(new i : Player)
            {
                if(betInfo[i][WalaBetAmount] > 0 || betInfo[i][MeronBetAmount] > 0)
                {
                    GivePlayerCash(i, betInfo[i][WalaBetAmount]);
                    GivePlayerCash(i, betInfo[i][MeronBetAmount]);
                    SM(i, COLOR_GRAD1, "Your $%s bet has been refunded because the match is cancelled.", number_format(betInfo[i][WalaBetAmount] + betInfo[i][MeronBetAmount]));

                    betInfo[i][WalaBetAmount] = 0;
                    betInfo[i][MeronBetAmount] = 0;
                }
            }
            ResetCockFightVars();
        }

    }
    if(PlayerInfo[playerid][pLogged])
    {
        if(PlayerInfo[playerid][pJoinedEvent])
        {
            foreach(new i : Player)
            {
                if(PlayerInfo[i][pJoinedEvent])
                {
                    if(killerid == INVALID_PLAYER_ID)
                        SM(i, COLOR_LIGHTORANGE, "(( %s died. ))", GetRPName(playerid));
                    else
                        SM(i, COLOR_LIGHTORANGE, "(( %s was killed by %s. ))", GetRPName(playerid), GetRPName(killerid));
                }
            }
        }
        else if(PlayerInfo[playerid][pPaintball] > 0)
        {
            foreach(new i : Player)
            {
                if(PlayerInfo[playerid][pPaintball] == PlayerInfo[i][pPaintball])
                {
                    if(killerid == INVALID_PLAYER_ID)
                    {
                        SendClientMessageEx(i, COLOR_TWEET, "(( %s died. ))", GetRPName(playerid));
                        PlayerInfo[playerid][pPaintballDeaths]++;
                    }
                    else {

                        SendClientMessageEx(i, COLOR_TWEET, "(( %s was killed by %s. ))", GetRPName(playerid), GetRPName(killerid));
                        PlayerInfo[playerid][pPaintballDeaths]++;
                        PlayerInfo[killerid][pPaintballKills]++;
                    }
                }
            }
        }
        else if(PlayerInfo[playerid][pDueling] != INVALID_PLAYER_ID)
        {
            SM(playerid, COLOR_LIGHTORANGE, "(( You lost your duel against %s! ))", GetRPName(PlayerInfo[playerid][pDueling]));

            if(killerid != INVALID_PLAYER_ID)
            {
                SM(killerid, COLOR_LIGHTORANGE, "(( You won the duel against %s! ))", GetRPName(playerid));
                SAM(COLOR_LIGHTRED, "AdmCmd: %s has won their duel against %s.", GetRPName(killerid), GetRPName(playerid));
                SetPlayerToSpawn(killerid);
            }
        }
        else if(PlayerInfo[playerid][pHunted] == 1)
        {
            new msg[256];
            if(killerid == INVALID_PLAYER_ID)
            {
                SMA(COLOR_HUNT, "[Hunt System] %s has died from terible accident.", GetRPName(playerid));
                SetPlayerColor(playerid, COLOR_WHITE);
            }
            else
            {
                SMA(COLOR_HUNT, "[Hunt System] %s has killed %s.", GetRPName(killerid), GetRPName(playerid));
                SMA(COLOR_YELLOW, msg);
                SetScriptArmour(killerid, 100.0);
                switch(random(5))
                {
                    case 0:
                    {
                        SMA(COLOR_HUNT, "[Hunt System] "WHITE"%s has received $5,000 for killing the hunted and free armor.", GetRPName(killerid));
                        GivePlayerCash(killerid, 5);
                        SetPlayerColor(playerid, COLOR_WHITE);
                    }
                    case 1:
                    {
                        SMA(COLOR_HUNT, "[Hunt System] "WHITE"%s has received 15,000 materials for killing the hunted and free armor.", GetRPName(killerid));

                        PlayerInfo[killerid][pMaterials] += 15000;
                    }
                    case 2:
                    {
                        GivePlayerWeaponEx(killerid, 30, 500);
                        GivePlayerWeaponEx(killerid, 24, 50);
                        GivePlayerWeaponEx(killerid, 29, 350);
                        GivePlayerWeaponEx(killerid, 27, 350);
                        SetPlayerColor(playerid, COLOR_WHITE);
                        SMA(COLOR_HUNT, "[Hunt System] "WHITE"%s has received full weapon set for killing the hunted and free armor.", GetRPName(killerid));
                    }
                    case 3:
                    {
                        SMA(COLOR_HUNT, "[Hunt System] "WHITE"%s has received 10 grams of Crack, pot & meth for killing the hunted and free armor.", GetRPName(killerid));
                        PlayerInfo[killerid][pCrack] += 10;
                        PlayerInfo[killerid][pMeth] += 10;
                        PlayerInfo[killerid][pPot] += 10;
                        SetPlayerColor(playerid, COLOR_WHITE);
                    }
                    case 4:
                    {
                        SMA(COLOR_HUNT, "[Hunt System] "WHITE"%s has dildo for killing the hunted and free armor.", GetRPName(killerid));
                        GivePlayerWeaponEx(killerid, 10, 1);
                        SetPlayerColor(playerid, COLOR_WHITE);
                    }
                }
            }
            //PlayerInfo[playerid][pHunted] = 0; NO NEED BRUH, its OnPlayerSpawn
        }
        else if(PlayerInfo[playerid][pBoxing] != INVALID_PLAYER_ID)
        {
            new entranceid = GetInsideBusiness(playerid);

            SendClientMessageEx(playerid, COLOR_TWEET, "(( You lost your belt against %s! ))", GetRPName(PlayerInfo[playerid][pBoxing]));

            if(killerid != INVALID_PLAYER_ID)
            {
                SendClientMessageEx(killerid, COLOR_TWEET, "(( You won the belt against %s! ))", GetRPName(playerid));

                if(entranceid >= 0 && BusinessInfo[entranceid][bType] == BUSINESS_GYM)
                {
                    foreach(new i : Player)
                    {
                        if(GetInsideBusiness(i) == entranceid)
                        {
                            SendClientMessageEx(i, COLOR_YELLOW, "Duel Arena: %s has won their belt against %s.", GetRPName(killerid), GetRPName(playerid));
                        }
                    }
                }
                else
                {
                    SendAdminMessage(COLOR_LIGHTRED, "AdmCmd: %s has won their belt against %s.", GetPlayerNameEx(killerid), GetPlayerNameEx(playerid));
                }

                SetPlayerWeapons(killerid);
                SetPlayerToSpawn(killerid);
            }
        }
        else
        {
            if(killerid != INVALID_PLAYER_ID)
            {
                HandleContract(playerid, killerid);
            }

            if(!PlayerInfo[playerid][pAdminDuty] && PlayerInfo[playerid][pJailType] == 0)
            {
                if(PlayerInfo[playerid][pInjured] == 0)
                {
                    ResetPlayer(playerid);
                    PlayerInfo[playerid][pInjured] = 1;
                    foreach(new i : Player)
                    {
                        if(GetFactionType(i) == FACTION_MEDIC)
                        {
                            SM(i, COLOR_DISPATCH, "Beacon %s (%i) is in need of immediate medical assistance.", GetRPName(playerid), playerid);
                        }
                    }
                }
                else
                {
                    GameTextForPlayer(playerid, "~b~Brutally Wounded", 2000, 3);

                    PlayerInfo[playerid][pInjured] = 0;
                    PlayerInfo[playerid][pHospital] = 1;

                    //if the players looting has died
                    foreach(new looter: Player) {
                        new ploot = PlayerInfo[looter][pLooting];
                        if(ploot == playerid)
                        {
                            SendClientMessage(looter, COLOR_GREY, "The player you're looting has died. Looting forced cancle.");
                            PlayerInfo[looter][pLooting] = INVALID_PLAYER_ID;
                            ClearAnimations(looter, 1);
                            DeletePVar(looter, "looting");
                            if(GetPVarInt(looter, #loot_1)) DeletePVar(looter, #loot_1);
                            if(GetPVarInt(looter, #loot_2)) DeletePVar(looter, #loot_2);
                            if(GetPVarInt(looter, #loot_3)) DeletePVar(looter, #loot_3);
                            if(GetPVarInt(looter, #loot_4)) DeletePVar(looter, #loot_4);
                            if(GetPVarInt(looter, #loot_5)) DeletePVar(looter, #loot_5);
                            if(GetPVarInt(looter, #loot_6)) DeletePVar(looter, #loot_6);
                            if(GetPVarInt(looter, #loot_7)) DeletePVar(looter, #loot_7);
                            if(GetPVarInt(looter, #loot_8)) DeletePVar(looter, #loot_8);
                        }
                        if(PlayerInfo[playerid][pLooted] == ploot)
                        {
                            SCM(playerid, COLOR_SYNTAX, "You have died. Looting has been canceled.");
                            PlayerInfo[playerid][pLooted] = INVALID_PLAYER_ID;
                            SetPVarInt(playerid, "looted", false);
                        }
                    }

                    if(PlayerInfo[playerid][pAcceptedEMS] != INVALID_PLAYER_ID)
                    {
                        SM(PlayerInfo[playerid][pAcceptedEMS], COLOR_YELLOW, "Your patient %s has bled out.", GetRPName(playerid));
                        PlayerInfo[playerid][pAcceptedEMS] = INVALID_PLAYER_ID;
                    }
                }
            }
            else
            {
                PlayerInfo[playerid][pHealth] = 32767.0;
            }

            if(killerid != INVALID_PLAYER_ID)
            {
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO kills VALUES(null, %i, %i, '%s', '%s', '%s', NOW())", PlayerInfo[killerid][pID], PlayerInfo[playerid][pID], GetPlayerNameEx(killerid), GetPlayerNameEx(playerid), GetDeathReason(reason));
                mysql_tquery(connectionID, queryBuffer);
            }

            GetPlayerPos(playerid, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ]);
            GetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosA]);

            PlayerInfo[playerid][pInterior] = GetPlayerInterior(playerid);
            PlayerInfo[playerid][pWorld] = GetPlayerVirtualWorld(playerid);
        }
    }
    if(IsInBus[playerid] == 1)
    {
        IsInBus[playerid] = 0;
        KillTimer(Timer1[playerid]);
        KillTimer(Timer2[playerid]);
    }
    if(IsInShml[playerid] == 1)
    {
        IsInShml[playerid] = 0;
    }
    if(Intropic[playerid] == 1)
    {
        Intropic[playerid] = 0;
    }
    if(InEnforcer[playerid] == 1)
    {
        InEnforcer[playerid] = 0;
    }
    if(InJourney[playerid] == 1)
    {
        InJourney[playerid] = 0;
    }
    if(InRaindance[playerid] == 1)
    {
        InRaindance[playerid] = 0;
    }
    if(PlayerInfo[playerid][pCallLine] != INVALID_PLAYER_ID)
    {
        HangupCall(PlayerInfo[playerid][pCallLine]);
    }
    if (killerid != INVALID_PLAYER_ID && !PlayerInfo[playerid][pPaintball])
    {
        if (1 <= reason <= 46)
            Log_Write2("logs/kill_log.txt", "[%s] %s has killed %s (%s).", ReturnDate(), GetRPName(killerid), GetRPName(playerid), GetWeaponNameEx(reason));

        else
            Log_Write2("logs/kill_log.txt", "[%s] %s has killed %s (reason %d).", ReturnDate(), GetRPName(killerid), GetRPName(playerid), reason);

        if (reason == 50 && killerid != INVALID_PLAYER_ID)
            SAM(COLOR_LIGHTRED, "[ADMIN]: %s has killed %s by heli-blading.", GetRPName(killerid), GetRPName(playerid));

        if (reason == 29 && killerid != INVALID_PLAYER_ID && GetPlayerState(killerid) == PLAYER_STATE_DRIVER)
            SAM(COLOR_LIGHTRED, "[ADMIN]: %s has killed %s by driver shooting.", GetRPName(killerid), GetRPName(playerid));

        if (killerid != INVALID_PLAYER_ID)
            SAM(COLOR_LIGHTRED, "[ADMIN]: %s has killed %s, using "YELLOW"%s", GetRPName(killerid), GetRPName(playerid), GetWeaponNameEx(reason));

    }
    if(reason == 50 && killerid != INVALID_PLAYER_ID)
    {
        SAM(COLOR_YELLOW, "AdmWarning: %s[%i] was helibladed by %s[%i].", GetRPName(playerid), playerid, GetRPName(killerid), killerid);
    }
    PlayerInfo[playerid][pLastDeath] = gettime();
    foreach(new i : Player)
    {
        if(PlayerInfo[i][pAdmin] && !PlayerInfo[playerid][pPaintball])
        {
            SendDeathMessageToPlayer(i, killerid, playerid, reason);
        }
    }
    if(killerid != INVALID_PLAYER_ID)
    {
        gTotalKills++;
    }

    gTotalDeaths++;
    SaveServerInfo();
    return 1;
}

/*forward Schimbare_Culori(playerid);
public Schimbare_Culori(playerid) {
    K[playerid]++;

    if(K[playerid] >= 0 && K[playerid] < 7)
    { // K apartine [0, 7)
        ChangeVehicleColor(masinaRainbow[playerid], Culori[K[playerid]][playerid], Culori[K[playerid]][playerid]);
        SetVehicleNeon(masinaRainbow[playerid], Culori2[K[playerid]][playerid]);
    }
    else
