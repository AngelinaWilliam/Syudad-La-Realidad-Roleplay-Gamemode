                                SendClientMessage(playerid, COLOR_GREY, "** FACTION ** /gov /settax /factionpay /tazer /cuff /uncuff /detain /taxdeposit /taxwithdraw /fpark");
                                SendClientMessage(playerid, COLOR_GREY, "** FACTION ** /backup");
