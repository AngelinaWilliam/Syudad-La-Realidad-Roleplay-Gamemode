                new str[64];

                for (new j = 0; j < 25; j ++)
                {
                    if(BusinessInfo[i][bPrices] == 35000)
                    {
                        SetDefaultBusinessPrice(i);
                    }
                    else
                    {
                        format(str, 32, "prices%d", j);
                        BusinessInfo[i][bPrices][j] = cache_get_field_content_int(i, str);
                    }
                }

                ReloadBusiness(i);
            }

            printf("[Script] %i businesses loaded.", rows);
        }
