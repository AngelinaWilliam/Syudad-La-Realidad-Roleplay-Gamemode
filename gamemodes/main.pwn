        case DIALOG_LOOTING:
        {
            new item[90];
            new looting = GetPVarInt(playerid, "looting");
            if(GetPVarInt(playerid, #loot_1)) {
                format(item, 90, "Bandage (%d)", PlayerInfo[looting][pFirstAid]);
                
                if(!response) {
                    SetPVarInt(looting, "looted", false); 
                    DeletePVar(playerid, "looting");
                    DeletePVar(playerid, #loot_1);
                    ClearAnimations(playerid, 1);
                    return 1;
                }
                if(!strval(inputtext)) return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close");
                for(new i = strlen(inputtext) - 1; i != -1; i --) {
                switch(inputtext[i]) {
                        case '0'..'9': continue;
                        default: return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Enter an amount you want to get from this item\nNOTE: Please enter value that's not greater than the item's amount", "Enter", "Close");
                    }
                }
                if(strval(inputtext) < 1 || strval(inputtext) > PlayerInfo[looting][pFirstAid])
                {
                    SCM(playerid, COLOR_SYNTAX, "Invalid amount entered.");
                    return ShowPlayerDialog(playerid, DIALOG_LOOTING, DIALOG_STYLE_INPUT, item, "Error:Invalid amount entered\nEnter an amount you want to get from this item", "Enter", "Close");
                }
                if(PlayerInfo[looting][pFirstAid] + strval(inputtext) > GetPlayerCapacity(CAPACITY_PAINKILLERS))
