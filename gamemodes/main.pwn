    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "u", targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /prisoninfo [playerid]");
