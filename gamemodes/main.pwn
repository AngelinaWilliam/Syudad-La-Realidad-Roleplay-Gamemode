                                }
                                //SetScriptArmour(playerid, 0.0);
                                ShowActionBubble(playerid, "* %s clocks out and puts their equipment back in the locker.", GetRPName(playerid));
                            }
                        }
                        if(listitem == 1) // Equipment
                        {
                            if(FactionInfo[PlayerInfo[playerid][pFaction]][fType] == FACTION_MECHANIC)
                            {
                                ShowPlayerDialog(playerid, DIALOG_FACTIONEQUIPMENT, DIALOG_STYLE_LIST, "Equipment", "Firstaid Kite\nKevlar Vest\nSpraycan\nFuelCan", "Select", "Cancel");
                            }
                        }
                        else if(listitem == 2) // Uniforms
                        {
                            if(!GetFactionSkinCount(PlayerInfo[playerid][pFaction]))
                            {
                                return SCM(playerid, COLOR_RED, "[ERROR]{ffffff} There are no uniforms setup for your faction.");
