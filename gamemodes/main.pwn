StreamerSettings() 
{
	for(new o; o < CountDynamicObjects(); o++)
	{
		if(IsValidDynamicObject(o))
		{
			Streamer_SetFloatData(STREAMER_TYPE_OBJECT, o, E_STREAMER_DRAW_DISTANCE, 350.0);
