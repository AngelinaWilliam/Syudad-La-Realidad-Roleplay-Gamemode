                        ShowDialogToPlayer(playerid, DIALOG_GANGSTASHMATS);
                    }
                    case 3:
                    {
                        PlayerInfo[playerid][pSelected] = ITEM_CASH;
                        ShowDialogToPlayer(playerid, DIALOG_GANGSTASHCASH);
                    }
                    case 4:
