        case DIALOG_CHOOSEVOUCHER:
        {
            if(response)
            {
                switch(listitem)
                {
                    case 0:
                    {
                        if(PlayerInfo[playerid][pSilverVoucher] <= 0)
                        {
                            return SCM(playerid, COLOR_GREY, "Error:"WHITE" You have no silver donator voucher left.");
                        }
                        if(!PlayerInfo[playerid][pDonator])
                        {
                            PlayerInfo[playerid][pDonator] = 1;
                            PlayerInfo[playerid][pVIPTime] = gettime() + 3 * 86400;
                            SMA(COLOR_ORANGE, "%s has use their silver donator voucher", GetRPName(playerid));
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET vippackage = 1, viptime = %i WHERE uid = %i", PlayerInfo[playerid][pVIPTime], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                            PlayerInfo[playerid][pSilverVoucher] --;
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET silvervoucher = %i WHERE uid = %i", PlayerInfo[playerid][pSilverVoucher], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                        }
                        else
                        {
                            new amount = 3 * 86400;
                            PlayerInfo[playerid][pVIPTime] = PlayerInfo[playerid][pVIPTime] + amount;

                            SMA(COLOR_ORANGE, "%s has use their silver donator voucher", GetRPName(playerid));
                            SCM(playerid, COLOR_RED, "Your donator expiration has been extended.");
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET viptime = viptime + %i WHERE uid = %i", amount, PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);


                            PlayerInfo[playerid][pSilverVoucher] --;
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET silvervoucher = %i WHERE uid = %i", PlayerInfo[playerid][pSilverVoucher], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);


                        }
                    }
                    case 1:
                    {
                        if(PlayerInfo[playerid][pDiamondVoucher] <= 0)
                        {
                            return SCM(playerid, COLOR_GREY, "Error:"WHITE" You have no diamond donator voucher left.");
                        }
                        if(!PlayerInfo[playerid][pDonator])
                        {
                            PlayerInfo[playerid][pDonator] = 2;
                            PlayerInfo[playerid][pVIPTime] = gettime() + 3 * 86400;
                            SMA(COLOR_ORANGE, "%s has use their diamond donator voucher", GetRPName(playerid));
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET vippackage = 2, viptime = %i WHERE uid = %i", PlayerInfo[playerid][pVIPTime], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                            PlayerInfo[playerid][pDiamondVoucher] --;
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET diamondvoucher = %i WHERE uid = %i", PlayerInfo[playerid][pDiamondVoucher], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);
                        }
                        else
                        {
                            SMA(COLOR_ORANGE, "%s has use their diamond donator voucher", GetRPName(playerid));
                            SCM(playerid, COLOR_RED, "Your donator expiration has been extended.");

                            new amount = 3 * 86400;
                            PlayerInfo[playerid][pVIPTime] = PlayerInfo[playerid][pVIPTime] + amount;

                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET viptime = viptime + %i WHERE uid = %i", amount, PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);


                            PlayerInfo[playerid][pDiamondVoucher] --;
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET diamondvoucher = %i WHERE uid = %i", PlayerInfo[playerid][pDiamondVoucher], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);
                        }
                    }
                    case 2:
                    {
                        if(PlayerInfo[playerid][pPlatinumVoucher] <= 0)
                        {
                            return SCM(playerid, COLOR_GREY, "Error:"WHITE" You have no platinum donator voucher left.");
                        }
                        if(!PlayerInfo[playerid][pDonator])
                        {
                            PlayerInfo[playerid][pDonator] = 3;
                            PlayerInfo[playerid][pVIPTime] = gettime() + 3 * 86400;
                            SMA(COLOR_ORANGE, "%s has use their platinum donator voucher", GetRPName(playerid));
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET vippackage = 3, viptime = %i WHERE uid = %i", PlayerInfo[playerid][pVIPTime], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                            PlayerInfo[playerid][pPlatinumVoucher] --;
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET platinumvoucher = %i WHERE uid = %i", PlayerInfo[playerid][pPlatinumVoucher], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);
                        }
                        else
                        {
                            PlayerInfo[playerid][pDonator] = 3;
                            PlayerInfo[playerid][pVIPCooldown] = 0;
                            SMA(COLOR_ORANGE, "%s has use their platinum donator voucher", GetRPName(playerid));
                            SCM(playerid, COLOR_RED, "Your donator expiration has been extended.");

                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET vippackage = %i, vipcooldown = 0 WHERE uid = %i", PlayerInfo[playerid][pDonator], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                            new amount = 3 * 86400;
                            PlayerInfo[playerid][pVIPTime] = PlayerInfo[playerid][pVIPTime] + amount;

                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET viptime = viptime + %i WHERE uid = %i", amount, PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);


                            PlayerInfo[playerid][pPlatinumVoucher] --;
                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET platinumvoucher = %i WHERE uid = %i", PlayerInfo[playerid][pPlatinumVoucher], PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                        }
                    }
                }
            }
        }
