CMD:checkplatform(playerid, params[])
{
    new string[129], giveplayerid;

    if(sscanf(params, "d", giveplayerid))
        return SendClientMessageEx(playerid, COLOR_WHITE, "USAGE: /checkplatform [playerid]");

    if(!IsPlayerConnected(giveplayerid))
        return SendClientMessageEx(playerid, COLOR_WHITE, "Invalid player specified.");

    format(string, sizeof(string), "%s is using %s to play "SERVER_NAME".", GetRPName(giveplayerid), IsPlayerAndroid(giveplayerid) ? ("Mobile") : ("Desktop/Laptop"));
    SendClientMessageEx(playerid, COLOR_WHITE, string);
    return 1;
}

CMD:kickgroup(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] >= 7)
    {
        if(isnull(params))
        {
            SendClientMessageEx(playerid, COLOR_WHITE, "USAGE: /kickgroup [option]");
            SendClientMessageEx(playerid, COLOR_GREY, "Available option: mobile, pc");
            return 1;
        }

        new string[(1024 * 2)];
        string[0] = EOS;
        if(!strcmp(params, "mobile", true))
        {
            format(string, sizeof(string), "AdmCmd: %s has kicked all mobile users from the server.", GetRPName(playerid));
            SMA(COLOR_LIGHTRED, string);
            print(string);

            foreach(new i : Player)
            {
                if(i != playerid && IsPlayerAndroid(i))
                {
                    SendClientMessageEx(i, COLOR_WHITE, "You have been kicked because you are playing in mobile.");
                    KickPlayer(i);
                }
            }
        }
        else if(!strcmp(params, "pc", true))
        {
            format(string, sizeof(string), "AdmCmd: %s has kicked all PC users from the server.", GetRPName(playerid));
            SMA(COLOR_LIGHTRED, string);
            print(string);

            foreach(new i : Player)
            {
                if(i != playerid && (!IsPlayerAndroid(i)))
                {
                    SendClientMessageEx(i, COLOR_WHITE, "You have been kicked because you are playing in PC.");
                    KickPlayer(i);
                }
            }
        }
    }
    return 1;
}

CMD:listgroups(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] >= 1)
    {
        if(isnull(params))
        {
            SendClientMessageEx(playerid, COLOR_WHITE, "USAGE: /listgroups [option]");
            SendClientMessageEx(playerid, COLOR_GREY, "Available option: mobile, pc");
            return 1;
        }

        new string[(1024 * 2)], count;
        string[0] = EOS;
        if(!strcmp(params, "mobile", true))
        {
            foreach(new i : Player)
            {
                if(IsPlayerAndroid(i))
                {
                    format(string, sizeof(string), "%s[ID: %d] %s\n", string, i, GetRPName(i));
                    count ++;
                }
            }

            if(!string[0]) format(string, sizeof(string), "No mobile users online.");
            ShowPlayerDialog(playerid, 0, DIALOG_STYLE_LIST, "Mobile Users | Group", string, "Close", "");

            format(string, sizeof(string), "There are %d mobile users online.", count);
            SendClientMessageEx(playerid, COLOR_WHITE, string);
        }
        else if(!strcmp(params, "pc", true))
        {
            foreach(new i : Player)
            {
                if(!IsPlayerAndroid(i))
                {
                    format(string, sizeof(string), "%s[ID: %d] %s\n", string, i, GetRPName(i));
                    count ++;
                }
            }

            if(!string[0]) format(string, sizeof(string), "No PC users online.");
            ShowPlayerDialog(playerid, 0, DIALOG_STYLE_LIST, "PC Users | Group", string, "Close", "");

            format(string, sizeof(string), "There are %d PC users online.", count);
            SendClientMessageEx(playerid, COLOR_WHITE, string);
        }
    }
    return 1;
}



CMD:getmats(playerid, params[])
{
    new choice;

    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 2096.0740, -1885.7511, 12.8862))
        return Error(playerid, "You are not near the /getmats locations!");

    if(sscanf(params, "d", choice))
        return SendClientMessageEx(playerid, COLOR_WHITE, "USAGE: /getmats [amount]"),
        SendClientMessageEx(playerid, COLOR_GREY, "1 piece of material costs $3. (100 pieces mats costs $300)");

    if(choice < 1 || choice > 100000)
        return SendClientMessageEx(playerid, COLOR_GREY, "You can only get 1 up to 100,000 materials.");

    new string[128], cost = (choice * 3);

    if(GetPlayerCash(playerid) >= cost)
    {

        if(illegalsys[MatsAmmount] < choice)
            return SendClientMessageEx(playerid, COLOR_GREY, "There are not enough materials in the storage, they need deliveries!");

        PlayerInfo[playerid][pMaterials] += choice;
        illegalsys[MatsAmmount] -= choice;
        SaveIllegalSystem();
        GivePlayerCash(playerid, -cost);

        format(string, sizeof(string), "* You have bought %s for $%s.", number_format(choice), number_format(cost));
        SendClientMessageEx(playerid, COLOR_LIGHTBLUE, string);
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET materials = %i WHERE uid = %d", PlayerInfo[playerid][pMaterials], PlayerInfo[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
    }
    else
    {
        format(string, sizeof(string), "You need $%s to buy %s pieces of materials.", number_format(cost), number_format(choice));
        SendClientMessageEx(playerid, COLOR_GREY, string);

    }
    return 1;
}

CMD:refillmats(playerid, params[])
{
    if(PlayerInfo[playerid][pAdmin] >= 5)
    {
        new amount, string[128];
        if(sscanf(params, "i", amount))
        {
            SendClientMessageEx(playerid, COLOR_GRAD2, "USAGE: /refillmats [Amount]");
        }
        else
        {
            illegalsys[MatsAmmount] += amount;
            SaveIllegalSystem();

            format(string,sizeof(string),"You have successfully added %d materials to the material storage.", amount);
            SendClientMessageEx(playerid,COLOR_YELLOW,string);

            format(string, sizeof( string ), "{AA3333}AdmWarning{FFFF00}: %s has just added %d materials to the material storage.", GetPlayerNameEx(playerid), amount);
            SAM(COLOR_YELLOW, string, 2);
        }
    }
    return 1;
}


LoadIllegalSystem() {

    new
        arrCoords[4][64],
        strFromFile2[256],
        File: file = fopen("mats_system.ini", io_read);

    if (file)
    {
        fread(file, strFromFile2);
        splits(strFromFile2, arrCoords, ',');
        illegalsys[MatsAmmount] = strval(arrCoords[0]);
        fclose(file);
    }
    return 1;
}

SaveIllegalSystem() {

    new
        coordsstring[256],
        File: file2 = fopen("mats_system.ini", io_write);

    format(coordsstring, sizeof(coordsstring), "%d", illegalsys[MatsAmmount]);
    fwrite(file2, coordsstring);
    fclose(file2);
    return 1;
}

forward splits(const strsrc[], strdest[][], delimiter);
public splits(const strsrc[], strdest[][], delimiter)
{
    new i, li;
    new aNum;
    new len;
    while(i <= strlen(strsrc)){
        if(strsrc[i]==delimiter || i==strlen(strsrc)){
            len = strmid(strdest[aNum], strsrc, li, i, 128);
            strdest[aNum][len] = 0;
            li = i+1;
            aNum++;
        }
        i++;
    }
    return 1;
}

Label2(playerid, string[], time = 4500)
{
    if(PlayerInfo[playerid][pLabel2])
    {
        PlayerTextDrawHide(playerid, LabelTxt2[playerid]);
        KillTimer(PlayerInfo[playerid][pLabel2Timer]);
    }
    PlayerTextDrawSetString(playerid, LabelTxt2[playerid], string);
    PlayerTextDrawShow(playerid, LabelTxt2[playerid]);

    PlayerInfo[playerid][pLabel2] = true;
    PlayerInfo[playerid][pLabel2Timer] = SetTimerEx("HideLabel2", time, false, "i", playerid);
    return 1;
}
forward HideLabel2(playerid);
public HideLabel2(playerid)
{
    PlayerInfo[playerid][pLabel2] = false;
    PlayerTextDrawHide(playerid, LabelTxt2[playerid]);
    return 1;
}

ElligableToFish(playerid)
{
	new elligable = 1;

	switch(GetJobLevel(playerid, JOB_FISHERMAN))
	{
		case 1:
		{
			if(PlayerInfo[playerid][pFishWeight] >= 50) elligable = 0;
		}
		case 2:
		{
			if(PlayerInfo[playerid][pFishWeight] >= 100) elligable = 0;
		}
		case 3:
		{
			if(PlayerInfo[playerid][pFishWeight] >= 150) elligable = 0;
		}
		case 4:
		{
			if(PlayerInfo[playerid][pFishWeight] >= 200) elligable = 0;
		}
		case 5:
		{
			if(PlayerInfo[playerid][pFishWeight] >= 250) elligable = 0;
		}
	}
	return elligable;
}


