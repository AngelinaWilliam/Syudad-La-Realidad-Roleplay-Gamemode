        SetPlayerHealth(playerid, 100.0);
        SetPlayerArmour(playerid, 100.0);

        PlayerInfo[playerid][pBrokenLeg] = 0;

        GiveWeapon(playerid, 24, true);
        GiveWeapon(playerid, 27, true);
        GiveWeapon(playerid, 29, true);
        GiveWeapon(playerid, 31, true);
        GiveWeapon(playerid, 34, true);

        PlayerInfo[playerid][pPaintball] = 1;
    }
    else if(type == 6)
    {
        new rand = random(sizeof(paintBallArena));
        SetPlayerPos(playerid, paintBallArena[rand][0], paintBallArena[rand][1], paintBallArena[rand][2]);
        SetPlayerInterior(playerid, 10);
        SetPlayerVirtualWorld(playerid, 1001);
        SetCameraBehindPlayer(playerid);
        SetPlayerHealth(playerid, 100.0);
        SetPlayerArmour(playerid, 100.0);

