                GangInfo[cache_get_field_content_int(i, "id")][gSkins][cache_get_field_content_int(i, "slot")] = cache_get_field_content_int(i, "skinid");
            }
        }

        case THREAD_LOAD_ACTORS:
        {
            for(new i = 0; i < rows && i < MAX_DYNAMIC_ACTORS; i ++)
