    if(dialogid == DIALOG_BACKPACKMENU)
    {
        new string[500];
        if(response)
        {
            if(!IsBackpackEquipped(playerid)) return SendClientMessageEx(playerid, COLOR_GREY, "You don't have any Backpack Equipped");
            SetPVarInt(playerid, "Listitem_Backpack", listitem);
            ShowBackpackActionChoice(playerid);
        }
        else
        {
            DeletePVar(playerid, "Listitem_Backpack");
            if(!IsPlayerInAnyVehicle(playerid))
            {
                new id = GetPlayerBackpackID(playerid);
                if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);
                switch(BackpackInfo[id][sBackpackSize]) {
                    case 1: SetPlayerAttachedObject(playerid, 9, 3026, 1, -0.152, -0.069, 0, 0, 0, 0, 1, 1);
                    case 2: SetPlayerAttachedObject(playerid, 9, 3026, 1, -0.152, -0.069, 0, 0, 0, 0, 1, 1);
                    case 3: SetPlayerAttachedObject(playerid, 9, 3026, 1, -0.254999, -0.109, -0.022999, 10.6, -1.20002, 3.4, 1.265, 1.242, 1.062);
                }
                ApplyAnimation(playerid,"BOMBER","BOM_Plant_Crouch_Out",4.1,0,0,0,0,1,1);
                format(string, sizeof(string), "Lifts their %s from the ground and equips it back.", GetPlayerStorageType(playerid));
                callcmd::me(playerid, string);
            }
            else {
                format(string, sizeof(string), "Equips their %s from their Lap.", GetPlayerStorageType(playerid));
                callcmd::me(playerid, string);
            }
        }
    }
    if(dialogid == DIALOG_PUTAKEITEMS)
    {
        if(response)
        {
            new bpstring[300], titlestring[64], index = GetPlayerBackpackID(playerid), rpstring[128];
            if(!GetPVarType(playerid, "Type_Action")) return SendClientMessageEx(playerid, COLOR_GREY, "An Error Occur during the Action Taking/Putting Items");
            if(isnull(inputtext)) return ShowPlayerBackpack(playerid), DeletePVar(playerid, "Listitem_Backpack"), DeletePVar(playerid, "Type_Action");
            switch(GetPVarInt(playerid, "Type_Action"))
            {
                case 1: // Put Items
                {
                    switch(GetPVarInt(playerid, "Listitem_Backpack"))
                    {
                        case 0: // Cash
                        {
                            if(!IsNumeric(inputtext))
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Putting a Cash in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: That's not a number!{FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Cash that you will put in your %s \n\
                                    {00FF00}Current Backpack Cash:{FFFFFF} $%s / $%s",
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sCash]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Put", "Back");
                                return 1;
                            }
                            new cash = strval(inputtext);
                            if(cash < 1)
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Putting a Cash in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: Must not be 0 or a Negative value!{FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Cash that you will put in your %s \n\
                                    {00FF00}Current Backpack Cash:{FFFFFF} $%s / $%s",
                                    number_format(cash),
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sCash]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Put", "Back");
                                return 1;
                            }
                            if(GetPlayerCash(playerid) < cash)
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Putting a Cash in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: You don't have enough $%s Cash to put{FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Cash that you will put in your %s \n\
                                    {00FF00}Current Backpack Cash:{FFFFFF} $%s / $%s",
                                    number_format(cash),
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sCash]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CASH))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Put", "Back");
                                return 1;
                            }
                            if((BackpackInfo[index][sCash]+cash) > BackpackLimit(BackpackInfo[index][sBackpackSize] , LIMIT_CASH))
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Putting a Cash in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: $%s cannot be put,Cash in your Backpack is on Maximum Limit ($%s/$%s){FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Cash that you will put in your %s \n\
                                    {00FF00}Current Backpack Cash:{FFFFFF} $%s / $%s",
                                    number_format(cash),
                                    number_format(BackpackInfo[index][sCash]),
