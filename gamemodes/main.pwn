						ShowPlayerDialog(playerid, DIALOG_CLOTHINGEDIT, DIALOG_STYLE_LIST, "Edition menu", "Change Bone\nEdit Offset {FDE364}(Desktop Platform)\n{FFFFFF}Edit Offset {FDE364}(Mobile Platform)", "Select", "Cancel");
