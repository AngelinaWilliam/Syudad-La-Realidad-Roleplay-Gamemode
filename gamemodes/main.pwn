{
    ShowDialogToPlayer(playerid, DIALOG_STATS);
    return 1;
}   //DisplayStats(playerid);
 

CMD:toggc(playerid) return callcmd::tog(playerid, "global");
CMD:inv(playerid, params[]) return callcmd::inventory(playerid, params);
