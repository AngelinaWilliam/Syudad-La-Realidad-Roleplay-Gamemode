                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: %sg Cracks cannot be take,Your Pocket is full of Cocaine!(%sg/%sg){FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Cocaine that you will take from your %s \n\
                                    {00FF00}Current Backpack Cocaine:{FFFFFF} %sg / %sg",
                                    number_format(amount),
                                    number_format(PlayerInfo[playerid][pCrack]),
                                    number_format(onhandlimit[LIMIT_CRACK]),
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sCrack]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_CRACK))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Take", "Back");
                                return 1;
                            }
                            format(rpstring, sizeof(rpstring), "Take's out some cracks from his %s", GetPlayerStorageType(playerid));
                            callcmd::me(playerid, rpstring);
                            PlayerInfo[playerid][pCrack] += amount;
                            BackpackInfo[index][sCrack] -= amount;

                            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET crack = %i WHERE uid = %i", amount, PlayerInfo[playerid][pID]);
                            mysql_tquery(connectionID, queryBuffer);

                            SavePlayerVariables(playerid);
                            return ShowPlayerBackpack(playerid), DeletePVar(playerid, "Listitem_Backpack"), DeletePVar(playerid, "Type_Action");
                        }
                        case 3: // Mats
                        {
                            if(!IsNumeric(inputtext))
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Taking a Mats in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: That's not a number!{FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Mats that you will take from your %s \n\
                                    {00FF00}Current Backpack Mats:{FFFFFF} %s / %s",
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sMats]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_MATS))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Take", "Back");
                                return 1;
                            }
                            new amount = strval(inputtext);
                            if(amount < 1)
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Taking a Mats in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: Must not be 0 or a Negative value!{FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Mats that you will take from your %s \n\
                                    {00FF00}Current Backpack Mats:{FFFFFF} %s / %s",
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sMats]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_MATS))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Take", "Back");
                                return 1;

                            }
                            if(BackpackInfo[index][sMats] < amount)
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Taking a Mats in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: You don't have enough %sg Weed in your Backpack!{FFFFFF}\n\n\
                                    {FFFFFF}Input the amount of Mats that you will take from your %s \n\
                                    {00FF00}Current Backpack Mats:{FFFFFF} %s / %s",
                                    number_format(amount),
                                    GetBackpackSize(index),
                                    number_format(BackpackInfo[index][sMats]),
                                    number_format(BackpackLimit(BackpackInfo[index][sBackpackSize], LIMIT_MATS))
                                );
                                ShowPlayerDialog(playerid, DIALOG_PUTAKEITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Take", "Back");
                                return 1;
                            }
                            if((PlayerInfo[playerid][pMaterials]+amount) > onhandlimit[LIMIT_MATS])
                            {
                                format(titlestring, sizeof(titlestring), "{FFFFFF}Taking a Mats in your %s", GetBackpackSize(index));
                                format(bpstring, sizeof(bpstring)," \
                                    {FF0000}ERROR: %s Mats cannot be take,Your Pocket is full of Cocaine!(%s/%s){FFFFFF}\n\n\
