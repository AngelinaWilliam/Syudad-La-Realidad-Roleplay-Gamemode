                            {00FF00}Status:{FFFFFF} %s ",
                            GetWeaponNameEx(gunid),
                            GetBackpackSize(index),
                            GetWeaponNameEx(BackpackInfo[index][sGun][1])
                        );
                        ShowPlayerDialog(playerid, DIALOG_EDITITEMS, DIALOG_STYLE_INPUT, titlestring, bpstring, "Edit", "Back");
                        return 1;
                    }
                    new userid = -1;
                    if(BackpackInfo[index][sBackpackOwner] != -1 && BackpackInfo[index][sAttached]) {
                        foreach(new i: Player) {
                            if(backpackid[i] == MAX_BACKPACKS+1) continue;
                            if(BackpackInfo[index][sBackpackOwner] == GetPlayerSQLId(i)) {
                                userid = i;
                                break;
                            }
                        }
