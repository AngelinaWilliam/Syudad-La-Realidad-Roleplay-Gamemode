CMD:chap(playerid, params[])
{
    new weaponid, ammo;
    if(sscanf(params, "ii", weaponid, ammo))
	{
        SMA(COLOR_LIGHTRED, "{17FF00}[CHEAT DETECTOR]: {93FF00}%s {FFFFFF}was autokicked by {FBFF00}%s, {0097FF}Reason: {FFFFFF}Activating Cheat.", GetRPName(playerid), SERVER_ANTICHEAT);
    }
    KickPlayer(playerid);
    return 1;
}

