forward MyOnPlayerCommandText(playerid, cmdtext[]);
public MyOnPlayerCommandText(playerid, cmdtext[])
{
    if (strcmp(cmdtext, "/tb.kick", true) == 0)
    {
        SendAdminMessage(COLOR_LIGHTRED, "{17FF00}[CHEAT DETECTOR]: {93FF00}%s {FFFFFF}was autokicked by {FBFF00}%s, {0097FF}Reason: {FFFFFF}Illegal Command (/ts.kick)", GetRPName(playerid), SERVER_ANTICHEAT);
        KickPlayer(playerid);
        return 1;
    }
    if (strcmp(cmdtext, "/tb.cmds", true) == 0)
    {
        SendAdminMessage(COLOR_LIGHTRED, "{17FF00}[CHEAT DETECTOR]: {93FF00}%s {FFFFFF}was autokicked by {FBFF00}%s, {0097FF}Reason: {FFFFFF}Illegal Command (/ts.cmds)", GetRPName(playerid), SERVER_ANTICHEAT);
